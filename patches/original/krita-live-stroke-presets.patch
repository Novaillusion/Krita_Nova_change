+ */
+
+#ifndef KIS_PRESET_STROKE_RENDERER_H
+#define KIS_PRESET_STROKE_RENDERER_H
+
+#include <QObject>
+#include <QImage>
+#include <QSize>
+#include <QHash>
+#include <QQueue>
+#include <QTimer>
+#include <QSet>
+#include <KoColor.h>
+
+#include <kritaui_export.h>
+#include <kis_types.h>
+#include <brushengine/kis_paintop_preset.h>
+
+class KoCanvasResourceProvider;
+
+/**
+ * Renders a wide sample stroke for brush presets, one at a time, and caches the result.
+ *
+ * Strokes are regenerated whenever
+ *  - invalidate(id) is called (the preset's settings changed or it was saved),
+ *  - invalidateAll() is called (theme changed), or
+ *  - image() is asked for a different size than before (preview size changed).
+ *
+ * image() never blocks: it returns the cached image or a null image, and
+ * queues a render. sigPreviewReady(id) is emitted when a render completes.
+ */
+class KRITAUI_EXPORT KisPresetStrokeRenderer : public QObject
+{
+    Q_OBJECT
+public:
+    explicit KisPresetStrokeRenderer(QObject *parent = nullptr);
+    ~KisPresetStrokeRenderer() override;
+
+    void setResourceManager(KoCanvasResourceProvider *resourceManager);
+
+    /// Cached stroke for the preset, or a null image if not ready (or unsupported engine).
+    QImage image(KisPaintOpPresetSP preset, const QSize &size);
+
+    /**
+     * The brush tip of the preset (the "brush_definition" stored in its settings), drawn in the
+     * theme's text color on a transparent 128x128 square. Null if the preset has no brush tip.
+     * Cached; cleared together with the stroke by invalidate()/invalidateAll().
+     */
+    QImage tipImage(KisPaintOpPresetSP preset);
+
+    void invalidate(int resourceId);
+    void invalidateAll();
+
+Q_SIGNALS:
+    void sigPreviewReady(int resourceId);
+
+private Q_SLOTS:
+    void renderNext();
+    void slotRenderFinished();
+
+private:
+    struct Job {
+        int id {-1};
+        KisPaintOpPresetSP preset;
+    };
+
+    void startRender(const Job &job);
+    void paintBackground(const QString &engineId);
+
+    KoCanvasResourceProvider *m_resourceManager {nullptr};
+
+    QHash<int, QImage> m_tipCache;   // null image = no brush tip
+    QHash<int, QImage> m_cache;      // a null image means "engine has no live preview"
+    QQueue<Job> m_queue;
+    QSet<int> m_queued;
+
+    QSize m_size;                    // size the cache is valid for
+    int m_generation {0};            // bumped on every invalidation so stale results are dropped
+
+    bool m_inProgress {false};
+    Job m_currentJob;
+    int m_currentGeneration {0};
+
+    KisImageSP m_image;
+    KisPaintLayerSP m_layer;
+    const KoColorSpace *m_colorSpace {nullptr};
+    KoColor m_paintColor;
+
+    QTimer m_kickTimer;              // debounces resizes
+};
+
+#endif
