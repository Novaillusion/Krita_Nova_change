+// Named differently from NotificationStroke in kis_preset_live_preview_view.cpp
+// to avoid a clash between two class definitions with the same name.
+class PresetStrokeRenderNotification : public QObject, public KisSimpleStrokeStrategy
+{
+    Q_OBJECT
+public:
+    PresetStrokeRenderNotification()
+        : KisSimpleStrokeStrategy(QLatin1String("PresetStrokeRenderNotification"))
+    {
+        setClearsRedoOnStart(false);
+        enableJob(JOB_INIT, true, KisStrokeJobData::BARRIER);
+    }
+    void initStrokeCallback() override { Q_EMIT timeout(); }
+Q_SIGNALS:
+    void timeout();
+};
+
+bool engineHasNoPreview(const QString &id)
+{
+    return id == "roundmarker" || id == "experimentbrush" || id == "duplicate";
+}
+
+} // namespace
