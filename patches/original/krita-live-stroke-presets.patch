+KisPresetStrokeRenderer::KisPresetStrokeRenderer(QObject *parent)
+    : QObject(parent)
+{
+    m_colorSpace = KoColorSpaceRegistry::instance()->rgb8();
+    m_kickTimer.setSingleShot(true);
+    m_kickTimer.setInterval(150);
+    connect(&m_kickTimer, &QTimer::timeout, this, &KisPresetStrokeRenderer::renderNext);
+}
+
+KisPresetStrokeRenderer::~KisPresetStrokeRenderer()
+{
+}
+
+void KisPresetStrokeRenderer::setResourceManager(KoCanvasResourceProvider *resourceManager)
+{
+    m_resourceManager = resourceManager;
+}
+
+QImage KisPresetStrokeRenderer::image(KisPaintOpPresetSP preset, const QSize &requestedSize)
+{
+    if (!preset || !m_resourceManager || requestedSize.isEmpty()) return QImage();
+
+    // Quantize the width so dragging the docker edge doesn't invalidate on every pixel.
+    const QSize size(qMax(32, (requestedSize.width() / 32) * 32), requestedSize.height());
+
+    // Preview size changed: throw everything away and start over.
+    if (size != m_size) {
+        m_size = size;
+        invalidateAll();
+    }
+
+    const int id = preset->resourceId();
+    const auto it = m_cache.constFind(id);
+    if (it != m_cache.constEnd()) {
+        return *it;
+    }
+
+    if (!m_queued.contains(id) && !(m_inProgress && m_currentJob.id == id)) {
+        m_queue.enqueue({id, preset});
+        m_queued.insert(id);
+        if (!m_kickTimer.isActive()) m_kickTimer.start();
+    }
+    return QImage();
+}
+
+void KisPresetStrokeRenderer::invalidate(int resourceId)
+{
+    m_cache.remove(resourceId);
+    m_tipCache.remove(resourceId);
+    if (m_inProgress && m_currentJob.id == resourceId) {
+        m_generation++; // result of the render in flight is stale
+    }
+}
+
+void KisPresetStrokeRenderer::invalidateAll()
+{
+    m_cache.clear();
+    m_tipCache.clear();
+    m_queue.clear();
+    m_queued.clear();
+    m_generation++;
+    if (!m_inProgress) {
+        // the image is recreated at the new size by startRender()
+        m_image.clear();
+        m_layer.clear();
+    }
+}
+
+QImage KisPresetStrokeRenderer::tipImage(KisPaintOpPresetSP preset)
+{
+    if (!preset) return QImage();
+
+    const int id = preset->resourceId();
+    const auto it = m_tipCache.constFind(id);
+    if (it != m_tipCache.constEnd()) return *it;
+
+    QImage result;
+
+    // Presets store their brush tip as XML in the "brush_definition" property.
+    // Engines without that property (e.g. MyPaint) simply have no tip here.
+    const QString definition = preset->settings()->getString("brush_definition");
+    if (!definition.isEmpty()) {
+        QDomDocument doc;
+        doc.setContent(definition);
+        const QDomElement element = doc.firstChildElement("Brush");
+        KisBrushSP brush;
+        if (!element.isNull()) {
+            brush = KisBrush::fromXML(element, KisGlobalResourcesInterface::instance());
+        }
+
+        QImage tip = brush ? brush->brushTipImage() : QImage();
+        if (!tip.isNull()) {
+            const int S = 128;
+            tip = tip.scaled(S, S, Qt::KeepAspectRatio, Qt::SmoothTransformation)
+                      .convertToFormat(QImage::Format_ARGB32);
+
+            // Tips come either as an alpha mask or as dark-on-light gray / color. Turn both into
+            // an alpha mask so the tip can be drawn in the theme's text color.
+            int minA = 255, maxA = 0;
+            for (int y = 0; y < tip.height(); y++) {
+                const QRgb *line = reinterpret_cast<const QRgb *>(tip.constScanLine(y));
+                for (int x = 0; x < tip.width(); x++) {
+                    minA = qMin(minA, qAlpha(line[x]));
+                    maxA = qMax(maxA, qAlpha(line[x]));
+                }
+            }
+            const bool useAlpha = (maxA - minA) > 8;
+
+            QImage mask(tip.size(), QImage::Format_Alpha8);
+            for (int y = 0; y < tip.height(); y++) {
+                const QRgb *src = reinterpret_cast<const QRgb *>(tip.constScanLine(y));
+                uchar *dst = mask.scanLine(y);
+                for (int x = 0; x < tip.width(); x++) {
+                    dst[x] = useAlpha ? qAlpha(src[x])
+                                      : (255 - qGray(src[x])) * qAlpha(src[x]) / 255;
+                }
+            }
+
+            const QColor ink = QGuiApplication::palette().color(QPalette::Text);
+            result = QImage(S, S, QImage::Format_ARGB32_Premultiplied);
+            result.fill(Qt::transparent);
+            QPainter p(&result);
+            QImage colored(tip.size(), QImage::Format_ARGB32_Premultiplied);
+            colored.fill(ink);
+            colored.setAlphaChannel(mask);
+            p.drawImage((S - colored.width()) / 2, (S - colored.height()) / 2, colored);
+        }
+    }
+
+    m_tipCache.insert(id, result);
+    return result;
+}
+
+void KisPresetStrokeRenderer::renderNext()
+{
+    if (m_inProgress || m_queue.isEmpty()) return;
+
+    const Job job = m_queue.dequeue();
+    m_queued.remove(job.id);
+
+    if (!job.preset || engineHasNoPreview(job.preset->paintOp().id())) {
+        m_cache.insert(job.id, QImage());
+        Q_EMIT sigPreviewReady(job.id);
+        QMetaObject::invokeMethod(this, "renderNext", Qt::QueuedConnection);
+        return;
+    }
+
+    startRender(job);
+}
+
+void KisPresetStrokeRenderer::paintBackground(const QString &engineId)
+{
+    const QPalette pal = QGuiApplication::palette();
+
+    if (engineId == "colorsmudge" || engineId == "deformbrush" || engineId == "filter") {
+        // smudging brushes need something to smudge: alternating gray strips
+        const int strips = 20;
+        const int w = m_image->width();
+        const int stripW = qMax(1, w / strips);
+        for (int i = 0; i < strips; i++) {
+            KoColor c(m_colorSpace);
+            c.fromQColor(i % 2 ? QColor(80, 80, 80) : QColor(140, 140, 140));
+            KisTransaction t(m_layer->paintDevice());
+            m_layer->paintDevice()->fill(QRect(i * stripW, 0, stripW, m_image->height()), c);
+            t.end();
+        }
+        m_paintColor = KoColor(Qt::white, m_colorSpace);
+    } else {
+        KisTransaction t(m_layer->paintDevice());
+        m_layer->paintDevice()->fill(m_image->bounds(), KoColor(pal.color(QPalette::Window), m_colorSpace));
+        t.end();
+        m_paintColor = KoColor(pal.color(QPalette::Text), m_colorSpace);
+    }
+}
+
+void KisPresetStrokeRenderer::startRender(const Job &job)
+{
+    const int w = m_size.width();
+    const int h = m_size.height();
+
+    if (!m_image || m_image->width() != w || m_image->height() != h) {
+        m_image = new KisImage(nullptr, w, h, m_colorSpace, "preset stroke preview");
+        m_layer = new KisPaintLayer(m_image, "presetStrokePreview", OPACITY_OPAQUE_U8, m_colorSpace);
+    }
+
+    const QString engineId = job.preset->paintOp().id();
+    paintBackground(engineId);
+
+    // Keep the brush inside the row: at most about half the row height.
+    qreal brushSize = qBound(3.0, job.preset->settings()->paintOpSize(), qMax(3.0, h * 0.5));
+    if (engineId == "sketchbrush" || engineId == "spraybrush") {
+        brushSize = qMax(3.0, job.preset->settings()->paintOpSize());
+    }
+
+    KisPaintOpPresetSP proxyPreset = job.preset->clone().dynamicCast<KisPaintOpPreset>();
+    KisPaintOpSettingsSP settings = proxyPreset->settings();
+    settings->setPaintOpSize(brushSize);
+    proxyPreset->setSettings(settings);
+
+    KisResourcesSnapshotSP resources =
+        new KisResourcesSnapshot(m_image, m_layer, m_resourceManager, nullptr, {}, proxyPreset);
+    resources->setOpacity(settings->paintOpOpacity());
+    resources->setMirroring(false, false);
+    resources->setFGColorOverride(m_paintColor);
+
+    KisFreehandStrokeInfo *strokeInfo = new KisFreehandStrokeInfo();
+    KisStrokeStrategy *stroke =
+        new FreehandStrokeStrategy(resources, strokeInfo, kundo2_noi18n("temp_stroke"));
+    KisStrokeId strokeId = m_image->startStroke(stroke);
+
+    const QPointF center(w * 0.5, h * 0.5);
+
+    if (engineId == "sketchbrush" || engineId == "curvebrush" || engineId == "particlebrush") {
+        const qreal startX = center.x() - w * 0.4;
+        const qreal endX = center.x() + w * 0.4;
+        KisPaintInformation p1, p2;
+        p1.setPressure(0.0); p1.setPos(QPointF(startX, center.y()));
+        p2.setPressure(0.0); p2.setPos(QPointF(startX, center.y()));
+        const int repeats = 8;
+        for (int i = 0; i < repeats; i++) {
+            p1.setPos(p2.pos());
+            p1.setPressure(p2.pressure());
+            p2.setPressure((1.0 / repeats) * (i + 1));
+            p2.setPos(QPointF(((1.0 / repeats) * (i + 1) * (endX - startX)) + startX, center.y()));
+            const qreal offset = (h / (repeats * 1.5)) * (i + 1);
+            const qreal handleY = (i % 2 == 0) ? center.y() - offset : center.y() + offset;
+            m_image->addJob(strokeId, new FreehandStrokeStrategy::Data(
+                0, p1, QPointF(p1.pos().x(), handleY), QPointF(p2.pos().x(), handleY), p2));
+            m_image->addJob(strokeId, new KisAsynchronousStrokeUpdateHelper::UpdateData(true));
+        }
+    } else {
+        // gentle S-curve with pressure ramping 0 -> 1
+        KisPaintInformation p1, p2;
+        if (engineId == "mypaintbrush") {
+            p1.setCurrentTime(123);
+            p2.setCurrentTime(1230);
+        }
+        p1.setPos(QPointF(center.x() - w * 0.45, center.y() + h * 0.2));
+        p1.setPressure(0.0);
+        p2.setPos(QPointF(center.x() + w * 0.4, center.y() - h * 0.2));
+        p2.setPressure(1.0);
+        m_image->addJob(strokeId, new FreehandStrokeStrategy::Data(
+            0, p1, QPointF(center.x(), center.y() - h), QPointF(center.x(), center.y() + h), p2));
+        m_image->addJob(strokeId, new KisAsynchronousStrokeUpdateHelper::UpdateData(true));
+    }
+    m_image->endStroke(strokeId);
+
+    m_inProgress = true;
+    m_currentJob = job;
+    m_currentGeneration = m_generation;
+
+    PresetStrokeRenderNotification *notification = new PresetStrokeRenderNotification();
+    connect(notification, SIGNAL(timeout()), this, SLOT(slotRenderFinished()));
+    KisStrokeId notificationId = m_image->startStroke(notification);
+    m_image->endStroke(notificationId);
+}
+
+void KisPresetStrokeRenderer::slotRenderFinished()
+{
+    m_inProgress = false;
+    const int id = m_currentJob.id;
+
+    if (m_currentGeneration == m_generation && m_image) {
+        m_cache.insert(id, m_layer->paintDevice()->convertToQImage(nullptr, m_image->bounds()));
+        Q_EMIT sigPreviewReady(id);
+    }
+    m_currentJob = Job();
+
+    if (!m_image || m_image->width() != m_size.width() || m_image->height() != m_size.height()) {
+        m_image.clear();
+        m_layer.clear();
+    }
+
+    QMetaObject::invokeMethod(this, "renderNext", Qt::QueuedConnection);
+}
+
+#include "kis_preset_stroke_renderer.moc"
