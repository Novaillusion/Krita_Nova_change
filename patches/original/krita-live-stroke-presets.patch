+
+void KisPresetChooser::slotModelDataChanged(const QModelIndex &topLeft, const QModelIndex &bottomRight, const QList<int> &roles)
+{
+    if (m_updatingFromRenderer) return;
+
+    // slotCurrentPresetChanged() and resource saves report Thumbnail; an empty list means "everything".
+    if (!roles.isEmpty() && !roles.contains(Qt::UserRole + KisAbstractResourceModel::Thumbnail)) return;
+
+    QAbstractItemModel *model = m_chooser->tagFilterModel();
+    for (int row = topLeft.row(); row <= bottomRight.row(); row++) {
+        const int id = model->index(row, 0).data(Qt::UserRole + KisAbstractResourceModel::Id).toInt();
+        m_renderer->invalidate(id);
+    }
+}
+
+void KisPresetChooser::slotStrokePreviewReady(int resourceId)
+{
+    // Repaint just that row. The flag stops slotModelDataChanged() from invalidating the new stroke.
+    const QModelIndex index = m_chooser->tagFilterModel()->indexForResourceId(resourceId);
+    if (!index.isValid()) return;
+
+    m_updatingFromRenderer = true;
+    Q_EMIT m_chooser->tagFilterModel()->dataChanged(index, index, {Qt::DisplayRole});
+    m_updatingFromRenderer = false;
+}
+
+void KisPresetChooser::changeEvent(QEvent *event)
+{
+    QWidget::changeEvent(event);
+    if (event->type() == QEvent::PaletteChange) {
+        m_renderer->invalidateAll(); // strokes are drawn in theme colors
+    }
+}
