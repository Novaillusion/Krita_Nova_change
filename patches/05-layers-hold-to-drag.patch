+bool NodeDelegate::menuButtonEnabled()
+{
+#ifdef Q_OS_ANDROID
+    return true;
+#else
+    return false;
+#endif
+}
+
+int NodeDelegate::menuButtonWidth() const
+{
+    KisNodeViewColorScheme scm;
+    // wide enough to hit with a fingertip, small enough not to crowd the row
+    return qMax(24, scm.iconSize() + 2 * scm.iconMargin() + 2 * scm.border());
+}
+
+QRect NodeDelegate::menuButtonRect(const QStyleOptionViewItem &option, const QModelIndex &index) const
+{
+    if (!menuButtonEnabled()
+        || index.column() == NodeView::VISIBILITY_COL || index.column() == NodeView::SELECTED_COL) {
+        return QRect();
+    }
+
+    QRect rc(0, 0, menuButtonWidth(), d->rowHeight > 0 ? d->rowHeight : option.rect.height());
+    rc.moveTop(option.rect.top());
+    if (option.direction == Qt::RightToLeft) {
+        rc.moveRight(option.rect.right());
+    } else {
+        rc.moveLeft(option.rect.left());
+    }
+    return rc;
+}
+
+QStyleOptionViewItem NodeDelegate::contentOption(const QStyleOptionViewItem &option, const QModelIndex &index) const
+{
+    QStyleOptionViewItem content = option;
+    const QRect button = menuButtonRect(option, index);
+    if (button.isValid()) {
+        if (option.direction == Qt::RightToLeft) {
+            content.rect.setRight(button.left() - 1);
+        } else {
+            content.rect.setLeft(button.right() + 1);
+        }
+    }
+    return content;
+}
+
+void NodeDelegate::drawMenuButton(QPainter *p, const QStyleOptionViewItem &option, const QModelIndex &index) const
+{
+    const QRect button = menuButtonRect(option, index);
+    if (!button.isValid()) return;
+
+    KisNodeViewColorScheme scm;
+    const QIcon icon = KisIconUtils::loadIcon("hamburger_menu_dots");
+    const int size = qMin(scm.iconSize(), button.width() - 2 * scm.border());
+    QRect iconRect(0, 0, size, size);
+    iconRect.moveCenter(button.center());
+
+    p->save();
+    if (!(option.state & QStyle::State_Enabled)) {
+        p->setOpacity(0.35);
+    }
+    icon.paint(p, iconRect, Qt::AlignCenter,
+               (option.state & QStyle::State_Selected) ? QIcon::Selected : QIcon::Normal);
+
+    // thin divider between the button and the layer thumbnail
+    p->setPen(scm.gridColor(option, d->view));
+    const int x = (option.direction == Qt::RightToLeft) ? button.left() : button.right();
+    p->drawLine(x, button.top() + scm.border(), x, button.bottom() - scm.border());
+    p->restore();
+}
