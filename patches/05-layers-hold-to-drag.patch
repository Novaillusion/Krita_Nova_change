+
+void NodeView::slotLongPressTimeout()
+{
+    const QModelIndex index = d->longPressIndex;
+    d->longPressIndex = QModelIndex();
+    if (!index.isValid() || !model()) return;
+
+    // The finger is still down: stop the kinetic scroller from treating the
+    // rest of the gesture as a scroll, and drag the layer instead.
+    if (QScroller::hasScroller(this)) {
+        QScroller::scroller(this)->stop();
+    }
+
+    QItemSelectionModel *selection = selectionModel();
+    if (!selection->isRowSelected(index.row(), index.parent())) {
+        selection->setCurrentIndex(index, QItemSelectionModel::ClearAndSelect | QItemSelectionModel::Rows);
+    }
+
+    startDrag(Qt::MoveAction);
+}
