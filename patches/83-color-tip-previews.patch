+// Krita Nova (patch 83): brushes whose tip is a color image.
+namespace {
+KisBrushSP novaBrushOf(KisPaintOpPresetSP preset)
+{
+    if (!preset || !preset->settings()) return KisBrushSP();
+    const QString definition = preset->settings()->getString("brush_definition");
+    if (definition.isEmpty()) return KisBrushSP();
+    QDomDocument doc;
+    doc.setContent(definition);
+    const QDomElement element = doc.firstChildElement("Brush");
+    if (element.isNull()) return KisBrushSP();
+    return KisBrush::fromXML(element, KisGlobalResourcesInterface::instance());
+}
+
+/// true if the brush tip is a color image (not a gray or alpha-only tip);
+/// \p average gets its alpha-weighted mean color
+bool novaColorTip(KisBrushSP brush, QColor *average)
+{
+    if (!brush) return false;
+    if (brush->brushType() != IMAGE && brush->brushType() != PIPE_IMAGE) return false;
+    QImage tip = brush->image();
+    if (tip.isNull()) return false;
+    tip = tip.scaled(64, 64, Qt::KeepAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_ARGB32);
+
+    double r = 0, g = 0, b = 0, weight = 0, saturated = 0;
+    for (int y = 0; y < tip.height(); y++) {
+        const QRgb *line = reinterpret_cast<const QRgb *>(tip.constScanLine(y));
+        for (int x = 0; x < tip.width(); x++) {
+            const int a = qAlpha(line[x]);
+            if (a < 16) continue;
+            const QColor c = QColor::fromRgb(line[x]);
+            r += c.red() * a; g += c.green() * a; b += c.blue() * a;
+            weight += a;
+            if (c.hsvSaturation() > 40 && c.value() > 30) saturated += a;
+        }
+    }
+    // gray tips (most image brushes) keep the theme color
+    if (weight <= 0 || saturated / weight < 0.05) return false;
+    if (average) *average = QColor(int(r / weight), int(g / weight), int(b / weight));
+    return true;
+}
+}
