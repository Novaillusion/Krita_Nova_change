diff --git a/plugins/tools/tool_transform2/kis_transform_actions_bar.cpp b/plugins/tools/tool_transform2/kis_transform_actions_bar.cpp
index 1901cfe..18d0fce 100644
--- a/plugins/tools/tool_transform2/kis_transform_actions_bar.cpp
+++ b/plugins/tools/tool_transform2/kis_transform_actions_bar.cpp
@@ -15,6 +15,7 @@
 #include <QTabletEvent>
 #include <QTouchEvent>
 #include <QHash>
+#include <QPointer>
 #include <QTimer>
 
 #include <KConfigGroup>
@@ -208,7 +209,10 @@ void KisTransformActionsBar::updateState()
 void KisTransformActionsBar::showModeMenu()
 {
     if (!m_tool) return;
-    QMenu menu;
+    // not exec(): a menu running its own event loop from a press can lose
+    // the tap on Android, and the bar (or the tool) may go away meanwhile
+    QMenu *menu = new QMenu(this);
+    menu->setAttribute(Qt::WA_DeleteOnClose);
     struct Entry { KisToolTransform::TransformToolMode mode; const char *icon; QString text; };
     const QList<Entry> entries = {
         {KisToolTransform::FreeTransformMode, "transform_icons_main", i18n("Free Transform")},
@@ -220,17 +224,27 @@ void KisTransformActionsBar::showModeMenu()
     };
     const int current = m_tool->transformMode();
     Q_FOREACH (const Entry &e, entries) {
-        QAction *a = menu.addAction(KisIconUtils::loadIcon(QString::fromLatin1(e.icon)), e.text);
+        QAction *a = menu->addAction(KisIconUtils::loadIcon(QString::fromLatin1(e.icon)), e.text);
         a->setCheckable(true);
         a->setChecked(e.mode == current);
         a->setData(int(e.mode));
     }
-    QAction *chosen = menu.exec(m_modeButton->mapToGlobal(QPoint(0, -menu.sizeHint().height())));
-    if (m_modeButton) m_modeButton->setDown(false);
-    if (chosen && m_tool) {
-        m_tool->setTransformMode(KisToolTransform::TransformToolMode(chosen->data().toInt()));
-        updateState();
-    }
+    QPointer<KisToolTransform> tool = m_tool;
+    QPointer<KisTransformActionsBar> self(this);
+    connect(menu, &QMenu::triggered, this, [tool, self](QAction *chosen) {
+        const int mode = chosen->data().toInt();
+        // after the menu has closed
+        QTimer::singleShot(0, self.data(), [tool, self, mode]() {
+            if (!tool) return;
+            tool->novaSetTransformMode(KisToolTransform::TransformToolMode(mode));
+            if (self) self->updateState();
+        });
+    });
+    connect(menu, &QMenu::aboutToHide, this, [self]() {
+        if (self && self->m_modeButton) self->m_modeButton->setDown(false);
+    });
+    const QSize size = menu->sizeHint();
+    menu->popup(m_modeButton->mapToGlobal(QPoint(0, -size.height())));
 }
 
