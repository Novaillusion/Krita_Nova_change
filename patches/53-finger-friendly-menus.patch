+QSize KisTouchFriendlyStyle::sizeFromContents(ContentsType type, const QStyleOption *option,
+                                              const QSize &size, const QWidget *widget) const
+{
+    QSize result = QProxyStyle::sizeFromContents(type, option, size, widget);
+
+    // Krita Nova: menu items tall enough to tap the right one with a finger
+    if (type == CT_MenuItem) {
+        const QStyleOptionMenuItem *item = qstyleoption_cast<const QStyleOptionMenuItem *>(option);
+        if (item && item->menuItemType != QStyleOptionMenuItem::Separator) {
+            result.setHeight(qMax(result.height(), MENU_ITEM_HEIGHT));
+        }
+    }
+    return result;
+}
