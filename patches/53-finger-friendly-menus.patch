+/**
+ * Krita Nova: a tapped menu item is shown highlighted for a moment before the
+ * menu acts on it and closes - with a finger the tap is too short to see which
+ * line was hit. The release over an item is held back for
+ * MENU_TAP_FEEDBACK_MS (the item is highlighted meanwhile) and then replayed.
+ */
+class MenuTapFeedback : public QObject
+{
+public:
+    static void install()
+    {
+        if (!s_instance) {
+            s_instance = new MenuTapFeedback(qApp);
+            qApp->installEventFilter(s_instance);
+        }
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (event->type() != QEvent::MouseButtonRelease || m_replaying) {
+            return false;
+        }
+        QMenu *menu = qobject_cast<QMenu *>(watched);
+        if (!menu || !menu->isVisible()) return false;
+
+        QMouseEvent *mouse = static_cast<QMouseEvent *>(event);
+        if (mouse->button() != Qt::LeftButton) return false;
+
+        QAction *action = menu->actionAt(mouse->pos());
+        // separators, disabled items and submenus behave as before
+        if (!action || action->isSeparator() || !action->isEnabled() || action->menu()) {
+            return false;
+        }
+
+        menu->setActiveAction(action);
+        menu->update();
+
+        const QPointF localPos = mouse->localPos();
+        const QPointF windowPos = mouse->windowPos();
+        const QPointF screenPos = mouse->screenPos();
+        const Qt::KeyboardModifiers modifiers = mouse->modifiers();
+        QPointer<QMenu> menuPointer(menu);
+
+        QTimer::singleShot(KisTouchFriendlyStyle::MENU_TAP_FEEDBACK_MS, this,
+                           [this, menuPointer, localPos, windowPos, screenPos, modifiers]() {
+            if (!menuPointer || !menuPointer->isVisible()) return;
+            QMouseEvent release(QEvent::MouseButtonRelease, localPos, windowPos, screenPos,
+                                Qt::LeftButton, Qt::NoButton, modifiers, Qt::MouseEventSynthesizedByApplication);
+            m_replaying = true;
+            QCoreApplication::sendEvent(menuPointer, &release);
+            m_replaying = false;
+        });
+        return true;
+    }
+
+private:
+    using QObject::QObject;
+    static MenuTapFeedback *s_instance;
+    bool m_replaying {false};
+};
+
+MenuTapFeedback *MenuTapFeedback::s_instance = nullptr;
+
 } // namespace
 
