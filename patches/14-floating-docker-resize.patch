     /// Width (in device-independent pixels) of docker separators and splitter handles.
     static constexpr int TOUCH_HANDLE_EXTENT = 14;
+
+    /// Visible border around floating (undocked) dockers.
+    static constexpr int FLOATING_DOCK_FRAME = 6;
+
+    /**
+     * Depth of the band along the edges of a floating docker that resizes it
+     * when dragged (border + a strip over the docker's content). A tap in that
+     * band (no movement) still reaches the widget underneath.
+     */
+    static constexpr int FLOATING_DOCK_GRAB_EXTENT = 22;
 };
 
