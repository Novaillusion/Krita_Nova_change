Krita Nova 50 - "Paint only inside the canvas"

Krita keeps paint outside the canvas border (layers have no edges). New
setting, Configure Krita > General > Tools, below "Activate transform tool
after pasting": "Paint only inside the canvas" (kritarc
paintOnlyInsideCanvas, off by default).

When on, brush strokes (KisPainterBasedStrokeStrategy: freehand brush, line,
shapes, ... and their level-of-detail previews) get the canvas as their
selection when there is no selection of the user's: the image bounds at the
stroke's level of detail. Nothing is painted outside. Moving and
transforming layers keeps what is outside, as before; a selection of the
user's limits painting as usual; not in wrap-around mode. Read when a stroke
starts, so changing it applies to the next stroke.
diff --git a/libs/ui/dialogs/kis_dlg_preferences.cc b/libs/ui/dialogs/kis_dlg_preferences.cc
index 2c3bfb6..d550081 100644
--- a/libs/ui/dialogs/kis_dlg_preferences.cc
+++ b/libs/ui/dialogs/kis_dlg_preferences.cc
@@ -873,6 +873,7 @@ void GeneralTab::setDefault()
     m_spnPalmRejectionDelay->setValue(100);
     m_chkPalmLargeContacts->setChecked(true);
     m_spnPalmMaxContactMm->setValue(18);
+    m_chkPaintInsideCanvas->setChecked(false);
     chkEnableTransformToolAfterPaste->setChecked(cfg.activateTransformToolAfterPaste(true));
     chkZoomHorizontally->setChecked(cfg.zoomHorizontal(true));
     m_chkConvertOnImport->setChecked(cfg.convertToImageColorspaceOnImport(true));
@@ -1293,6 +1294,30 @@ void GeneralTab::setupPalmRejectionSettings(KisConfig &cfg)
     connect(m_chkPalmRejection, &QCheckBox::toggled, this, [this]() { updatePalmRejectionEnabled(); });
     connect(m_chkPalmLargeContacts, &QCheckBox::toggled, this, [this]() { updatePalmRejectionEnabled(); });
     updatePalmRejectionEnabled();
+
+    // Krita Nova: brush strokes stop at the canvas border
+    m_chkPaintInsideCanvas = new QCheckBox(i18n("Paint only inside the canvas"), this);
+    m_chkPaintInsideCanvas->setToolTip(i18n("Brush strokes stop at the canvas border, so no paint is kept outside of it. "
+                                            "Moving and transforming layers still keeps what is outside. "
+                                            "With a selection, the selection limits painting as usual."));
+    m_chkPaintInsideCanvas->setChecked(cfg.readEntry("paintOnlyInsideCanvas", false));
+
+    QFormLayout *toolsForm = qobject_cast<QFormLayout *>(chkEnableTransformToolAfterPaste->parentWidget()->layout());
+    int toolsRow = -1;
+    QFormLayout::ItemRole toolsRole;
+    if (toolsForm) {
+        toolsForm->getWidgetPosition(chkEnableTransformToolAfterPaste, &toolsRow, &toolsRole);
+    }
+    if (toolsForm && toolsRow >= 0) {
+        toolsForm->insertRow(toolsRow + 1, QString(), m_chkPaintInsideCanvas);
+    } else if (QBoxLayout *box = qobject_cast<QBoxLayout *>(chkEnableTransformToolAfterPaste->parentWidget()->layout())) {
+        const int index = box->indexOf(chkEnableTransformToolAfterPaste);
+        box->insertWidget(index >= 0 ? index + 1 : box->count(), m_chkPaintInsideCanvas);
+    } else if (QGridLayout *grid = qobject_cast<QGridLayout *>(chkEnableTransformToolAfterPaste->parentWidget()->layout())) {
+        grid->addWidget(m_chkPaintInsideCanvas, grid->rowCount(), 0, 1, grid->columnCount());
+    } else if (QLayout *layout = chkEnableTransformToolAfterPaste->parentWidget()->layout()) {
+        layout->addWidget(m_chkPaintInsideCanvas);
+    }
 }
 
