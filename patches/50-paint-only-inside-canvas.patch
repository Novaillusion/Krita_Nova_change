         KisPaintDeviceSP paintDevice = node->paintDevice();
         KisPaintDeviceSP targetDevice = paintDevice;
         KisSelectionSP selection =  m_resources->activeSelection();
+
+        // Krita Nova: "Paint only inside the canvas" - without a selection of
+        // the user's, the stroke is limited to the canvas (the image bounds at
+        // the stroke's level of detail); not in wrap-around mode, which paints
+        // everywhere anyway
+        if (!selection && m_paintInsideCanvas && paintDevice->defaultBounds()
+                && !paintDevice->defaultBounds()->wrapAroundMode()) {
+            const QRect canvasRect = paintDevice->defaultBounds()->bounds();
+            if (!canvasRect.isEmpty()) {
+                selection = new KisSelection(paintDevice->defaultBounds(), KisImageResolutionProxy::identity());
+                selection->pixelSelection()->select(canvasRect);
+            }
+        }
+
         bool hasIndirectPainting = supportsIndirectPainting() && m_resources->needsIndirectPainting();
         const QString indirectCompositeOp = m_resources->indirectPaintingCompositeOp();
 
