+void KisPaintOpPresetsEditor::slotFitToScreen()
+{
+    QWidget *frame = parentWidget();
+    if (!frame || !isVisible() || !frame->screen()) return;
+
+    const QRect avail = frame->screen()->availableGeometry();
+    if (avail.isEmpty()) return;
+
+    QSize size = frame->size();
+
+    // The size was chosen for another screen size (other orientation, or saved on
+    // another device): keep the same proportion of the screen.
+    const QSize ref = m_d->fitReferenceScreenSize;
+    if (ref.isValid() && !ref.isEmpty() && ref != avail.size()) {
+        size = QSize(qRound(size.width() * qreal(avail.width()) / ref.width()),
+                     qRound(size.height() * qreal(avail.height()) / ref.height()));
+    }
+    m_d->fitReferenceScreenSize = avail.size();
+
+    // Keep it a usable fraction of the screen: never a sliver, never covering
+    // everything. Portrait screens get a wide, shorter editor.
+    const bool landscape = avail.width() >= avail.height();
+    const QSize maxSize(qRound(avail.width() * (landscape ? 0.85 : 0.96)),
+                        qRound(avail.height() * (landscape ? 0.90 : 0.70)));
+    const QSize minSize(qRound(avail.width() * (landscape ? 0.45 : 0.80)),
+                        qRound(avail.height() * (landscape ? 0.45 : 0.35)));
+    size = size.expandedTo(minSize).boundedTo(maxSize);
+
+    if (size == frame->size() && avail.contains(frame->geometry())) return;
+
+    QRect rect(frame->pos(), size);
+    if (!avail.contains(rect)) {
+        rect = kisEnsureInRect(rect, avail);
+    }
+    frame->setGeometry(rect);
+}
