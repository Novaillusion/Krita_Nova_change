diff --git a/libs/ui/input/KisPalmRejection.cpp b/libs/ui/input/KisPalmRejection.cpp
index 7dd987f..d1aa636 100644
--- a/libs/ui/input/KisPalmRejection.cpp
+++ b/libs/ui/input/KisPalmRejection.cpp
@@ -21,6 +21,9 @@ namespace {
 // Even with a proximity flag set, stop rejecting when the pen has been silent
 // this long: some drivers never send "leave proximity".
 constexpr qint64 PROXIMITY_TIMEOUT_MS = 5000;
+// A pen event after this long a silence means the pen came (back) into range,
+// for platforms that send no proximity events (Android).
+constexpr qint64 PEN_RETURN_GAP_MS = 400;
 }
 
 KisPalmRejection *KisPalmRejection::instance()
@@ -44,7 +47,7 @@ void KisPalmRejection::reloadConfig()
 {
     KisConfig cfg(true);
     m_enabled = cfg.readEntry("palmRejectionEnabled", true);
-    m_graceMs = qBound(0, cfg.readEntry("palmRejectionDelay", 500), 5000);
+    m_graceMs = qBound(0, cfg.readEntry("palmRejectionLiftDelay", 100), 5000);
     m_checkContactSize = cfg.readEntry("palmRejectionLargeContacts", true);
     m_maxContactMm = qBound(5, cfg.readEntry("palmRejectionMaxContactMm", 18), 100);
 }
@@ -55,24 +58,33 @@ bool KisPalmRejection::eventFilter(QObject *watched, QEvent *event)
     case QEvent::TabletPress:
         m_penDown = true;
         m_penInProximity = true;
+        m_hoverBlocks = false;
         m_lastPenEvent.start();
         break;
     case QEvent::TabletRelease:
+        // lifted: fingers work again once the (short) lift delay is over,
+        // even while the pen still hovers
         m_penDown = false;
+        m_hoverBlocks = false;
         m_lastPenEvent.start();
         break;
     case QEvent::TabletMove:
         // includes hover moves on platforms that report them
+        if (!m_penDown && (!m_lastPenEvent.isValid() || m_lastPenEvent.elapsed() > PEN_RETURN_GAP_MS)) {
+            m_hoverBlocks = true; // the pen is coming (back) to the screen
+        }
         m_penInProximity = true;
         m_lastPenEvent.start();
         break;
     case QEvent::TabletEnterProximity:
         m_penInProximity = true;
+        m_hoverBlocks = true;
         m_lastPenEvent.start();
         break;
     case QEvent::TabletLeaveProximity:
         m_penInProximity = false;
         m_penDown = false;
+        m_hoverBlocks = false;
         m_lastPenEvent.start();
         break;
     default:
@@ -87,7 +99,7 @@ bool KisPalmRejection::isPenActive() const
 
     const qint64 elapsed = m_lastPenEvent.elapsed();
     if (m_penDown) return elapsed < PROXIMITY_TIMEOUT_MS * 6; // a long, still press
-    if (m_penInProximity && elapsed < PROXIMITY_TIMEOUT_MS) return true;
+    if (m_penInProximity && m_hoverBlocks && elapsed < PROXIMITY_TIMEOUT_MS) return true;
     return elapsed < m_graceMs;
 }
 
