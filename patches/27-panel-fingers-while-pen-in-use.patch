+/// Krita Nova (patch 27): a finger touch made while the pen is in use, reported
+/// by MainActivity. Called on the Android UI thread.
+extern "C" JNIEXPORT void JNICALL Java_org_krita_android_JNIWrappers_onPenTimeFinger(JNIEnv * /*env*/,
+                                                                                   jobject /*obj*/,
+                                                                                   jint id,
+                                                                                   jint action,
+                                                                                   jfloat x,
+                                                                                   jfloat y)
+{
+    if (!qApp) return;
+    const int pointerId = id;
+    const int fingerAction = action;
+    const QPointF pos(x, y);
+    QMetaObject::invokeMethod(qApp, [pointerId, fingerAction, pos]() {
+        if (PanelFingerRouter *router = PanelFingerRouter::instance()) {
+            router->fingerEvent(pointerId, fingerAction, pos);
+        }
+    }, Qt::QueuedConnection);
+}
 #endif
 
