+    // Krita Nova: Qt does not deliver finger touches while the pen is in use,
+    // so the Brush Panel stays usable with a finger (see KisMainWindow.cpp,
+    // PanelFingerRouter): such fingers are also reported to Krita, which only
+    // uses those that land on the panel.
+    private static final long PEN_ACTIVE_MS = 1000;
+    private boolean m_penDown = false;
+    private boolean m_penHovering = false;
+    private long m_lastPenEvent = -PEN_ACTIVE_MS;
+    private final android.util.SparseBooleanArray m_reportedFingers = new android.util.SparseBooleanArray();
+    private final int[] m_qtViewOrigin = new int[2];
+
+    private static boolean isPen(int toolType) {
+        return toolType == MotionEvent.TOOL_TYPE_STYLUS || toolType == MotionEvent.TOOL_TYPE_ERASER;
+    }
+
+    private void trackPen(MotionEvent ev) {
+        boolean hasPen = false;
+        for (int i = 0; i < ev.getPointerCount(); ++i) {
+            if (isPen(ev.getToolType(i))) { hasPen = true; break; }
+        }
+        if (!hasPen) return;
+        m_lastPenEvent = android.os.SystemClock.uptimeMillis();
+        switch (ev.getActionMasked()) {
+        case MotionEvent.ACTION_HOVER_ENTER:
+        case MotionEvent.ACTION_HOVER_MOVE:
+            m_penHovering = true;
+            break;
+        case MotionEvent.ACTION_HOVER_EXIT:
+            m_penHovering = false;
+            break;
+        case MotionEvent.ACTION_DOWN:
+        case MotionEvent.ACTION_POINTER_DOWN:
+        case MotionEvent.ACTION_MOVE:
+            m_penDown = true;
+            m_penHovering = false;
+            break;
+        case MotionEvent.ACTION_UP:
+        case MotionEvent.ACTION_CANCEL:
+            m_penDown = false;
+            break;
+        default:
+            break;
+        }
+    }
+
+    private boolean isPenActive(MotionEvent ev) {
+        for (int i = 0; i < ev.getPointerCount(); ++i) {
+            if (isPen(ev.getToolType(i))) return true;
+        }
+        return m_penDown || m_penHovering
+            || android.os.SystemClock.uptimeMillis() - m_lastPenEvent < PEN_ACTIVE_MS;
+    }
+
+    private void reportFinger(MotionEvent ev, int index, int action) {
+        try {
+            JNIWrappers.onPenTimeFinger(ev.getPointerId(index), action,
+                                        ev.getX(index) - m_qtViewOrigin[0],
+                                        ev.getY(index) - m_qtViewOrigin[1]);
+        } catch (UnsatisfiedLinkError e) {
+            // Krita's libraries are not loaded yet
+        }
+    }
+
+    private void reportFingers(MotionEvent ev) {
+        final int action = ev.getActionMasked();
+        final boolean starting = action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_POINTER_DOWN;
+        if (m_reportedFingers.size() == 0 && !(starting && isPenActive(ev))) return;
+
+        android.view.View qtView = findViewById(android.R.id.content);
+        if (qtView != null) {
+            qtView.getLocationInWindow(m_qtViewOrigin);
+        }
+
+        switch (action) {
+        case MotionEvent.ACTION_DOWN:
+        case MotionEvent.ACTION_POINTER_DOWN: {
+            final int i = ev.getActionIndex();
+            if (ev.getToolType(i) == MotionEvent.TOOL_TYPE_FINGER && isPenActive(ev)) {
+                m_reportedFingers.put(ev.getPointerId(i), true);
+                reportFinger(ev, i, 0);
+            }
+            break;
+        }
+        case MotionEvent.ACTION_MOVE:
+            for (int i = 0; i < ev.getPointerCount(); ++i) {
+                if (m_reportedFingers.get(ev.getPointerId(i))) reportFinger(ev, i, 1);
+            }
+            break;
+        case MotionEvent.ACTION_UP:
+        case MotionEvent.ACTION_POINTER_UP: {
+            final int i = ev.getActionIndex();
+            final int id = ev.getPointerId(i);
+            if (m_reportedFingers.get(id)) {
+                reportFinger(ev, i, 2);
+                m_reportedFingers.delete(id);
+            }
+            break;
+        }
+        case MotionEvent.ACTION_CANCEL:
+            for (int i = 0; i < ev.getPointerCount(); ++i) {
+                if (m_reportedFingers.get(ev.getPointerId(i))) reportFinger(ev, i, 3);
+            }
+            m_reportedFingers.clear();
+            break;
+        default:
+            break;
+        }
+    }
+
+    @Override
+    public boolean dispatchTouchEvent(MotionEvent ev) {
+        trackPen(ev);
+        reportFingers(ev);
+        return super.dispatchTouchEvent(ev);
+    }
+
+    @Override
+    public boolean dispatchGenericMotionEvent(MotionEvent ev) {
+        trackPen(ev); // pen hover
+        return super.dispatchGenericMotionEvent(ev);
+    }
