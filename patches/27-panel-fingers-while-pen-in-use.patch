     }
 
+private:
+    static constexpr int DECIDE_DELAY_MS = 80;
+
+    enum State { Idle, Pending, Forwarding, Ignored };
+
+    QPoint toGlobal(const QPointF &physicalPos) const
+    {
+        qreal ratio = 1.0;
+        if (m_panel && m_panel->window()->windowHandle()) {
+            ratio = m_panel->window()->windowHandle()->devicePixelRatio();
+        } else if (QScreen *screen = QGuiApplication::primaryScreen()) {
+            ratio = screen->devicePixelRatio();
+        }
+        if (ratio <= 0.0) ratio = 1.0;
+        return (physicalPos / ratio).toPoint();
+    }
+
+    void decide()
+    {
+        if (m_state != Pending) return;
+        const bool qtDelivered = m_sinceLastPanelPress.isValid()
+            && m_sinceLastPanelPress.elapsed() < DECIDE_DELAY_MS + 120;
+        if (qtDelivered || !m_target) {
+            m_state = Ignored;
+            return;
+        }
+        m_state = Forwarding;
+        send(QEvent::MouseButtonPress, m_pressPos, Qt::LeftButton);
+        if (m_lastPos != m_pressPos) send(QEvent::MouseMove, m_lastPos, Qt::LeftButton);
+    }
