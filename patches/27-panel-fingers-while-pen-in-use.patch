+/// true for the floating Brush Panel and for windows opened from it (the
+/// "more" popup and the popups of its buttons)
+bool belongsToBrushPanel(const QDockWidget *panel, const QWidget *window)
+{
+    if (!panel || !window) return false;
+    if (window == panel) return panel->isFloating();
+    for (const QWidget *w = window->parentWidget(); w; w = w->parentWidget()) {
+        if (w == panel) return true;
+    }
+    return false;
+}
+
+/// the Brush Panel, or a window opened from it, under a screen position
+QWidget *brushPanelWindowAt(QDockWidget *panel, const QPoint &globalPos)
+{
+    if (!panel || !panel->isVisible()) return nullptr;
+
+    QWidget *top = QApplication::topLevelAt(globalPos);
+    if (top && belongsToBrushPanel(panel, top)) return top;
+
+    // topLevelAt may not know about the stacking order: popups first
+    QWidget *found = nullptr;
+    Q_FOREACH (QWidget *w, QApplication::topLevelWidgets()) {
+        if (!w->isVisible() || !w->frameGeometry().contains(globalPos)) continue;
+        if (!belongsToBrushPanel(panel, w)) continue;
+        if (w != panel) return w;
+        found = w;
+    }
+    return found;
+}
