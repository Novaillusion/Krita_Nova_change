+/**
+ * Fingers on the Brush Panel while the pen is in use (patch 27).
+ *
+ * While the pen hovers over or touches the screen, Krita's Android Qt does not
+ * deliver finger touches as touch events (a finger that comes with the pen's
+ * own motion events is lost in its tablet event). MainActivity therefore also
+ * reports finger touches made while the pen is in use (JNIWrappers.onPenTimeFinger),
+ * and this hands a finger that lands on the Brush Panel, or on a popup opened
+ * from it, to the widget under it as mouse press / move / release.
+ *
+ * If Qt does deliver the touch (or patch 24 forwards it), the panel gets a press
+ * of its own within a moment; the finger reported by Java is then dropped, so
+ * nothing is pressed twice. The canvas is not involved: it keeps ignoring
+ * touches while the pen is in use (palm rejection).
+ */
+class PanelFingerRouter : public QObject
+{
+public:
+    enum Action { Down = 0, Move = 1, Up = 2, Cancel = 3 };
+
+    explicit PanelFingerRouter(QDockWidget *panel)
+        : QObject(panel), m_panel(panel)
+    {
+        s_instance = this;
+        m_decideTimer.setSingleShot(true);
+        m_decideTimer.setInterval(DECIDE_DELAY_MS);
+        QObject::connect(&m_decideTimer, &QTimer::timeout, this, [this]() { decide(); });
+        m_sinceLastPanelPress.invalidate();
+        qApp->installEventFilter(this);
+    }
+
+    static PanelFingerRouter *instance() { return s_instance.data(); }
+
+    /// position in physical pixels of the Qt view
+    void fingerEvent(int id, int action, const QPointF &physicalPos)
+    {
+        const QPoint globalPos = toGlobal(physicalPos);
+        switch (action) {
+        case Down: {
+            if (m_state != Idle) return; // one finger at a time
+            QWidget *top = brushPanelWindowAt(m_panel, globalPos);
+            if (!top) return;
+            QWidget *target = top->childAt(top->mapFromGlobal(globalPos));
+            m_target = target ? target : top;
+            m_id = id;
+            m_pressPos = m_lastPos = globalPos;
+            m_state = Pending;
+            m_decideTimer.start();
+            break;
+        }
+        case Move:
+            if (m_state == Idle || id != m_id) return;
+            m_lastPos = globalPos;
+            if (m_state == Forwarding) send(QEvent::MouseMove, globalPos, Qt::LeftButton);
+            break;
+        case Up:
+        case Cancel:
+            if (m_state == Idle || id != m_id) return;
+            if (action == Up) m_lastPos = globalPos;
+            if (m_state == Pending) {
+                m_decideTimer.stop();
+                decide();
+            }
+            if (m_state == Forwarding) send(QEvent::MouseButtonRelease, m_lastPos, Qt::NoButton);
+            reset();
+            break;
+        default:
+            break;
         }
-        return found;
     }
 
-    bool belongsToPanel(QWidget *window) const
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
     {
-        if (window == m_panel) return m_panel->isFloating();
-        for (QWidget *w = window->parentWidget(); w; w = w->parentWidget()) {
