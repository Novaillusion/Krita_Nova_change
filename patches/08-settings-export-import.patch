+#ifndef KIS_SETTINGS_TRANSFER_CORE_H
+#define KIS_SETTINGS_TRANSFER_CORE_H
+
+#include <QByteArray>
+#include <QHash>
+#include <QJsonObject>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+#include "kritaui_export.h"
+
+/**
+ * Archive-independent logic of Krita's settings export/import
+ * (see KisSettingsTransfer for the UI and the zip handling).
+ *
+ * Only depends on QtCore and KConfigCore, and never touches
+ * KSharedConfig, so it can run at the very beginning of main(),
+ * before the application object and its configuration exist.
+ *
+ * Archive layout:
+ *   krita-settings.json          manifest (format, version, origin, file list)
+ *   config/<name>                files from the config folder (kritarc, ...)
+ *   resources/<path>             files from the resource folder (toolbars, input profiles)
+ */
+namespace KisSettingsTransferCore
+{
+
+struct Entry {
+    QString location; ///< "config" or "resources"
+    QString path;     ///< relative path inside that location, '/' separated
+
+    bool operator==(const Entry &rhs) const {
+        return location == rhs.location && path == rhs.path;
+    }
+};
+
+static const QString MANIFEST_NAME = QStringLiteral("krita-settings.json");
+static const QString FORMAT_ID = QStringLiteral("krita-nova-settings");
+static constexpr int FORMAT_VERSION = 1;
+
+static const QString LOCATION_CONFIG = QStringLiteral("config");
+static const QString LOCATION_RESOURCES = QStringLiteral("resources");
+
+/// Settings files in the config folder that are transferred
+KRITAUI_EXPORT QStringList configFileNames();
+
+/// Entries in kritarc that describe this device rather than the user's preferences;
+/// on import the receiving device keeps its own values for these.
+KRITAUI_EXPORT QStringList preservedRootKeys();
+KRITAUI_EXPORT QStringList preservedGroups();
+
+/// Only whitelisted file names, no absolute paths, no "..": archives may come from anywhere.
+KRITAUI_EXPORT bool isAllowedEntry(const Entry &entry);
+
+/// Path of the entry inside the archive, e.g. "config/kritarc"
+KRITAUI_EXPORT QString archivePath(const Entry &entry);
+
+/**
+ * Krita's writable resource folder, resolved the same way as
+ * KoResourcePaths::saveLocation("data"): the "ResourceDirectory" entry
+ * of kritarc if set, otherwise \p appDataLocation (plus "/krita" outside
+ * of Android).
+ */
+KRITAUI_EXPORT QString resolveResourceDir(const QString &configDir, const QString &appDataLocation);
+
+/// The settings files that currently exist on this device
+KRITAUI_EXPORT QVector<Entry> collectEntries(const QString &configDir, const QString &resourceDir);
+
+/// Absolute path of an entry on this device
+KRITAUI_EXPORT QString localPath(const Entry &entry, const QString &configDir, const QString &resourceDir);
+
+KRITAUI_EXPORT QByteArray createManifest(const QVector<Entry> &entries,
+                                         const QString &kritaVersion,
+                                         const QString &platform);
+
+/**
+ * Parses and validates a manifest. \p info receives the manifest object
+ * (kritaVersion, platform, created...).
+ */
+KRITAUI_EXPORT bool parseManifest(const QByteArray &json,
+                                  QVector<Entry> *entries,
+                                  QJsonObject *info,
+                                  QString *error);
+
+/**
+ * Writes the imported kritarc (\p imported) to \p targetPath, keeping the
+ * device-specific entries (preservedRootKeys(), preservedGroups()) from the
+ * current kritarc at \p currentPath, or dropping them when there is none.
+ */
+KRITAUI_EXPORT bool mergeKritarc(const QByteArray &imported,
+                                 const QString &currentPath,
+                                 const QString &targetPath,
+                                 QString *error);
+
+/**
+ * Applies an import: backs up the current settings files to \p backupDir
+ * (replacing any older backup), then writes the config files (kritarc merged,
+ * see mergeKritarc()), then the resource files into the resource folder.
+ *
+ * \p files maps archivePath(entry) to the file contents.
+ */
+KRITAUI_EXPORT bool applyFiles(const QVector<Entry> &entries,
+                               const QHash<QString, QByteArray> &files,
+                               const QString &configDir,
+                               const QString &appDataLocation,
+                               const QString &backupDir,
+                               QStringList *log,
+                               QString *error);
+
+} // namespace KisSettingsTransferCore
+
+#endif // KIS_SETTINGS_TRANSFER_CORE_H
