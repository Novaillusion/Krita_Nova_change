+
+namespace KisSettingsTransferCore
+{
+
+namespace {
+
+const QString RESOURCE_DIRECTORY_KEY = QStringLiteral("ResourceDirectory"); // KisResourceLocator::resourceLocationKey
+const QString TOOLBARS_FILE = QStringLiteral("krita5.xmlgui");
+const QString INPUT_PROFILES_DIR = QStringLiteral("input");
+
+bool writeFileAtomically(const QString &path, const QByteArray &data, QString *error)
+{
+    QDir().mkpath(QFileInfo(path).absolutePath());
+    QSaveFile file(path);
+    if (!file.open(QIODevice::WriteOnly) || file.write(data) != data.size() || !file.commit()) {
+        if (error) *error = QStringLiteral("cannot write %1: %2").arg(path, file.errorString());
+        return false;
+    }
+    return true;
+}
+
+bool readFile(const QString &path, QByteArray *data)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) return false;
+    *data = file.readAll();
+    return true;
+}
+
+} // namespace
+
+QStringList configFileNames()
+{
+    return {
+        QStringLiteral("kritarc"),              // almost all preferences
+        QStringLiteral("kritadisplayrc"),       // display / OpenGL / tablet resolution
+        QStringLiteral("kritashortcutsrc"),     // keyboard shortcuts
+        QStringLiteral("klanguageoverridesrc"), // interface language
+    };
+}
+
+QStringList preservedRootKeys()
+{
+    return {RESOURCE_DIRECTORY_KEY};
+}
+
+QStringList preservedGroups()
+{
+    // paths that only make sense on the device that wrote them
+    return {QStringLiteral("RecentFiles"), QStringLiteral("File Dialogs")};
+}
+
+bool isAllowedEntry(const Entry &entry)
+{
+    if (entry.path.isEmpty() || entry.path.contains(QLatin1String("..")) ||
+        entry.path.startsWith(QLatin1Char('/')) || entry.path.contains(QLatin1Char('\\')) ||
+        entry.path.contains(QLatin1Char(':'))) {
+        return false;
+    }
+
+    if (entry.location == LOCATION_CONFIG) {
+        return configFileNames().contains(entry.path);
+    }
+
+    if (entry.location == LOCATION_RESOURCES) {
+        static const QRegularExpression inputProfile(
+            QStringLiteral("^input/[A-Za-z0-9_.-]+\\.profile$"));
+        return entry.path == TOOLBARS_FILE || inputProfile.match(entry.path).hasMatch();
+    }
+
+    return false;
+}
+
+QString archivePath(const Entry &entry)
+{
+    return entry.location + QLatin1Char('/') + entry.path;
+}
+
+QString resolveResourceDir(const QString &configDir, const QString &appDataLocation)
+{
+    QString path;
+
+    const QString kritarcPath = QDir(configDir).absoluteFilePath(QStringLiteral("kritarc"));
+    if (QFile::exists(kritarcPath)) {
+        KConfig kritarc(kritarcPath, KConfig::SimpleConfig);
+        path = KConfigGroup(&kritarc, QString()).readEntry(RESOURCE_DIRECTORY_KEY, QString());
+    }
+
+    if (path.isEmpty()) {
+        path = appDataLocation;
+#ifndef Q_OS_ANDROID
+        // KoResourcePaths: on Android the app-specific locations don't end with "krita"
+        if (!path.endsWith(QLatin1String("krita"))) {
+            path += QStringLiteral("/krita");
+        }
+#endif
+    }
+
+    return QDir::cleanPath(path);
+}
+
+QString localPath(const Entry &entry, const QString &configDir, const QString &resourceDir)
+{
+    const QString base = entry.location == LOCATION_CONFIG ? configDir : resourceDir;
+    return QDir(base).absoluteFilePath(entry.path);
+}
+
+QVector<Entry> collectEntries(const QString &configDir, const QString &resourceDir)
+{
+    QVector<Entry> entries;
+
+    Q_FOREACH (const QString &name, configFileNames()) {
+        if (QFileInfo(QDir(configDir).absoluteFilePath(name)).isFile()) {
+            entries.append({LOCATION_CONFIG, name});
+        }
+    }
+
+    if (QFileInfo(QDir(resourceDir).absoluteFilePath(TOOLBARS_FILE)).isFile()) {
+        entries.append({LOCATION_RESOURCES, TOOLBARS_FILE});
+    }
+
+    const QDir inputDir(QDir(resourceDir).absoluteFilePath(INPUT_PROFILES_DIR));
+    const QStringList profiles = inputDir.entryList({QStringLiteral("*.profile")}, QDir::Files, QDir::Name);
+    Q_FOREACH (const QString &profile, profiles) {
+        const Entry entry{LOCATION_RESOURCES, INPUT_PROFILES_DIR + QLatin1Char('/') + profile};
+        if (isAllowedEntry(entry)) {
+            entries.append(entry);
+        }
+    }
+
+    return entries;
+}
+
+QByteArray createManifest(const QVector<Entry> &entries, const QString &kritaVersion, const QString &platform)
+{
+    QJsonArray files;
+    Q_FOREACH (const Entry &entry, entries) {
+        files.append(QJsonObject{{QStringLiteral("location"), entry.location},
+                                 {QStringLiteral("path"), entry.path}});
+    }
+
+    const QJsonObject manifest{
+        {QStringLiteral("format"), FORMAT_ID},
+        {QStringLiteral("version"), FORMAT_VERSION},
+        {QStringLiteral("kritaVersion"), kritaVersion},
+        {QStringLiteral("platform"), platform},
+        {QStringLiteral("created"), QDateTime::currentDateTimeUtc().toString(Qt::ISODate)},
+        {QStringLiteral("files"), files},
+    };
+    return QJsonDocument(manifest).toJson(QJsonDocument::Indented);
+}
+
+bool parseManifest(const QByteArray &json, QVector<Entry> *entries, QJsonObject *info, QString *error)
+{
+    auto fail = [error](const QString &message) {
+        if (error) *error = message;
+        return false;
+    };
+
+    QJsonParseError parseError;
+    const QJsonDocument doc = QJsonDocument::fromJson(json, &parseError);
+    if (doc.isNull() || !doc.isObject()) {
+        return fail(QStringLiteral("the manifest is not valid JSON (%1)").arg(parseError.errorString()));
+    }
+
+    const QJsonObject manifest = doc.object();
+    if (manifest.value(QStringLiteral("format")).toString() != FORMAT_ID) {
+        return fail(QStringLiteral("this is not a Krita settings archive"));
+    }
+    const int version = manifest.value(QStringLiteral("version")).toInt(-1);
+    if (version < 1 || version > FORMAT_VERSION) {
+        return fail(QStringLiteral("unsupported settings archive version %1").arg(version));
+    }
+
+    const QJsonArray files = manifest.value(QStringLiteral("files")).toArray();
+    if (files.isEmpty()) {
+        return fail(QStringLiteral("the archive contains no settings files"));
+    }
+
+    QVector<Entry> result;
+    Q_FOREACH (const QJsonValue &value, files) {
+        const QJsonObject file = value.toObject();
+        const Entry entry{file.value(QStringLiteral("location")).toString(),
+                          file.value(QStringLiteral("path")).toString()};
+        if (!isAllowedEntry(entry)) {
+            return fail(QStringLiteral("the archive contains an unexpected file: %1").arg(archivePath(entry)));
+        }
+        if (!result.contains(entry)) {
+            result.append(entry);
+        }
+    }
+
+    if (entries) *entries = result;
+    if (info) *info = manifest;
+    return true;
+}
+
+bool mergeKritarc(const QByteArray &imported, const QString &currentPath, const QString &targetPath, QString *error)
+{
+    const QString tmpPath = targetPath + QStringLiteral(".import-tmp");
+    QFile::remove(tmpPath);
+    if (!writeFileAtomically(tmpPath, imported, error)) {
+        return false;
+    }
+
+    {
+        KConfig importedConfig(tmpPath, KConfig::SimpleConfig);
+        KConfigGroup importedRoot(&importedConfig, QString());
+
+        if (QFile::exists(currentPath)) {
+            KConfig currentConfig(currentPath, KConfig::SimpleConfig);
+            KConfigGroup currentRoot(&currentConfig, QString());
+
+            Q_FOREACH (const QString &key, preservedRootKeys()) {
+                if (currentRoot.hasKey(key)) {
+                    importedRoot.writeEntry(key, currentRoot.readEntry(key, QString()));
+                } else {
+                    importedRoot.deleteEntry(key);
+                }
+            }
+
+            Q_FOREACH (const QString &groupName, preservedGroups()) {
+                importedConfig.deleteGroup(groupName);
+                const KConfigGroup source(&currentConfig, groupName);
+                KConfigGroup target(&importedConfig, groupName);
+                const QMap<QString, QString> values = source.entryMap();
+                for (auto it = values.constBegin(); it != values.constEnd(); ++it) {
+                    target.writeEntry(it.key(), it.value());
+                }
+            }
+        } else {
+            Q_FOREACH (const QString &key, preservedRootKeys()) {
+                importedRoot.deleteEntry(key);
+            }
+            Q_FOREACH (const QString &groupName, preservedGroups()) {
+                importedConfig.deleteGroup(groupName);
+            }
+        }
+
+        if (!importedConfig.sync()) {
+            QFile::remove(tmpPath);
+            if (error) *error = QStringLiteral("cannot write %1").arg(tmpPath);
+            return false;
+        }
+    }
+
+    QByteArray merged;
+    const bool ok = readFile(tmpPath, &merged) && writeFileAtomically(targetPath, merged, error);
+    QFile::remove(tmpPath);
+    return ok;
+}
+
+bool applyFiles(const QVector<Entry> &entries,
+                const QHash<QString, QByteArray> &files,
+                const QString &configDir,
+                const QString &appDataLocation,
+                const QString &backupDir,
+                QStringList *log,
+                QString *error)
+{
+    auto note = [log](const QString &line) { if (log) log->append(line); };
+
+    Q_FOREACH (const Entry &entry, entries) {
+        if (!isAllowedEntry(entry)) {
+            if (error) *error = QStringLiteral("refusing unexpected file %1").arg(archivePath(entry));
+            return false;
+        }
+        if (!files.contains(archivePath(entry))) {
+            if (error) *error = QStringLiteral("%1 is missing from the archive").arg(archivePath(entry));
+            return false;
+        }
+    }
+
+    // 1. Back up what is there now (only the latest backup is kept)
+    const QString currentResourceDir = resolveResourceDir(configDir, appDataLocation);
+    QDir(backupDir).removeRecursively();
+    const QVector<Entry> current = collectEntries(configDir, currentResourceDir);
+    Q_FOREACH (const Entry &entry, current) {
+        QByteArray data;
+        if (readFile(localPath(entry, configDir, currentResourceDir), &data)) {
+            QString backupError;
+            if (!writeFileAtomically(QDir(backupDir).absoluteFilePath(archivePath(entry)), data, &backupError)) {
+                if (error) *error = QStringLiteral("backup failed, nothing was imported: %1").arg(backupError);
+                return false;
+            }
+        }
+    }
+    note(QStringLiteral("backed up %1 files to %2").arg(current.size()).arg(backupDir));
+
+    // 2. Config files first: kritarc decides where the resource folder is
+    Q_FOREACH (const Entry &entry, entries) {
+        if (entry.location != LOCATION_CONFIG) continue;
+        const QString target = localPath(entry, configDir, currentResourceDir);
+        const QByteArray &data = files[archivePath(entry)];
+        const bool ok = entry.path == QLatin1String("kritarc")
+            ? mergeKritarc(data, target, target, error)
+            : writeFileAtomically(target, data, error);
+        if (!ok) return false;
+        note(QStringLiteral("imported %1").arg(target));
+    }
+
+    // 3. Resource files (toolbars, input profiles) into the resource folder
+    const QString resourceDir = resolveResourceDir(configDir, appDataLocation);
+    Q_FOREACH (const Entry &entry, entries) {
+        if (entry.location != LOCATION_RESOURCES) continue;
+        const QString target = localPath(entry, configDir, resourceDir);
+        if (!writeFileAtomically(target, files[archivePath(entry)], error)) return false;
+        note(QStringLiteral("imported %1").arg(target));
+    }
+
+    return true;
+}
+
+} // namespace KisSettingsTransferCore
