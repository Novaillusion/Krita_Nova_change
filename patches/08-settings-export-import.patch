+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova contributors
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_SETTINGS_TRANSFER_H
+#define KIS_SETTINGS_TRANSFER_H
+
+#include <QString>
+
+#include "kritaui_export.h"
+
+class QWidget;
+
+/**
+ * Settings → Export Settings... / Import Settings...
+ *
+ * Export packs Krita's settings (kritarc, display settings, shortcuts,
+ * interface language, toolbar layout, canvas input profiles) into a zip file.
+ *
+ * Import validates such a zip and *stages* it. The settings are applied by
+ * applyPendingImport() at the very beginning of the next start, before
+ * anything reads them, so nothing Krita writes while running or quitting can
+ * overwrite them. The previous settings are backed up first.
+ *
+ * Brushes, patterns and other resources are not included: use resource
+ * bundles for those.
+ */
+class KRITAUI_EXPORT KisSettingsTransfer
+{
+public:
+    static void exportSettings(QWidget *parent);
+    static void importSettings(QWidget *parent);
+
+    /// Call first thing in main(), before any configuration is read.
+    static void applyPendingImport();
+
+    /// After startup: tells the user about an import applied by applyPendingImport().
+    static void showImportResult(QWidget *parent);
+
+    static QString pendingImportPath();
+    static QString backupDir();
+
+private:
+    static QString resultPath();
+};
+
+#endif // KIS_SETTINGS_TRANSFER_H
