+namespace Core = KisSettingsTransferCore;
+
+namespace {
+
+// Success messages without an icon: on Android the "information" icon is drawn
+// as a warning triangle, which made a successful export look like a failure.
+void showSuccess(QWidget *parent, const QString &title, const QString &text)
+{
+    QMessageBox box(QMessageBox::NoIcon, title, text, QMessageBox::Ok, parent);
+    box.exec();
+}
+
+// "content://.../document/primary%3Afolder%2Fname.zip" -> "folder/name.zip (internal storage)"
+QString readableLocation(const QString &fileName)
+{
+    if (!fileName.startsWith(QLatin1String("content://"))) {
+        return QDir::toNativeSeparators(fileName);
+    }
+    const QString decoded = QUrl::fromPercentEncoding(fileName.section(QLatin1Char('/'), -1).toUtf8());
+    const QString volume = decoded.section(QLatin1Char(':'), 0, 0);
+    const QString path = decoded.section(QLatin1Char(':'), 1);
+    if (path.isEmpty()) return decoded;
+    return volume == QLatin1String("primary")
+        ? i18nc("file location on an Android device", "%1 (internal storage)", path)
+        : QStringLiteral("%1 (%2)").arg(path, volume);
+}
+
+QString configDir()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::GenericConfigLocation);
+}
+
+QString appDataLocation()
+{
+    return QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+}
+
+QString platformName()
+{
+    return QSysInfo::productType(); // "android", "windows", "macos", "ubuntu"...
+}
+
+bool readArchive(const QByteArray &zip,
+                 QVector<Core::Entry> *entries,
+                 QJsonObject *info,
+                 QHash<QString, QByteArray> *files,
+                 QString *error)
+{
+    QBuffer buffer;
+    buffer.setData(zip);
+    QScopedPointer<KoStore> store(KoStore::createStore(&buffer, KoStore::Read, QByteArray(), KoStore::Zip));
+    if (!store || store->bad()) {
+        *error = i18n("The file is not a valid zip archive.");
+        return false;
+    }
+
+    if (!store->hasFile(Core::MANIFEST_NAME) || !store->open(Core::MANIFEST_NAME)) {
+        *error = i18n("This is not a Krita settings file (%1 is missing).", Core::MANIFEST_NAME);
+        return false;
+    }
+    const QByteArray manifest = store->read(store->size());
+    store->close();
+
+    QString parseError;
+    if (!Core::parseManifest(manifest, entries, info, &parseError)) {
+        *error = parseError;
+        return false;
+    }
+
+    if (files) {
+        Q_FOREACH (const Core::Entry &entry, *entries) {
+            const QString name = Core::archivePath(entry);
+            if (!store->hasFile(name) || !store->open(name)) {
+                *error = i18n("The settings file is incomplete: %1 is missing.", name);
+                return false;
+            }
+            files->insert(name, store->read(store->size()));
+            store->close();
+        }
+    }
+    return true;
+}
+
+QString describe(const QJsonObject &info, int fileCount)
+{
+    const QDateTime created = QDateTime::fromString(info.value(QStringLiteral("created")).toString(), Qt::ISODate);
+    return i18n("Created: %1\nKrita version: %2\nDevice type: %3\nFiles: %4",
+                created.isValid() ? QLocale().toString(created.toLocalTime(), QLocale::ShortFormat) : i18n("unknown"),
+                info.value(QStringLiteral("kritaVersion")).toString(),
+                info.value(QStringLiteral("platform")).toString(),
+                fileCount);
+}
+
+} // namespace
+
+QString KisSettingsTransfer::pendingImportPath()
+{
+    return QDir(configDir()).absoluteFilePath(QStringLiteral("krita-settings-import.pending.zip"));
+}
+
+QString KisSettingsTransfer::backupDir()
+{
+    return QDir(configDir()).absoluteFilePath(QStringLiteral("krita-settings-backup"));
+}
+
+QString KisSettingsTransfer::resultPath()
+{
+    return QDir(configDir()).absoluteFilePath(QStringLiteral("krita-settings-import.result"));
+}
+
+void KisSettingsTransfer::exportSettings(QWidget *parent)
+{
+    // Write all pending in-memory changes to kritarc first
+    KSharedConfig::openConfig()->sync();
+
+    const QString cfgDir = configDir();
+    const QString resourceDir = Core::resolveResourceDir(cfgDir, appDataLocation());
+    const QVector<Core::Entry> entries = Core::collectEntries(cfgDir, resourceDir);
+    if (entries.isEmpty()) {
+        QMessageBox::information(parent, i18nc("@title:window", "Export Settings"),
+                                 i18n("There are no settings to export yet."));
+        return;
+    }
+
+    KoFileDialog dialog(parent, KoFileDialog::SaveFile, "KritaSettingsExport");
+    dialog.setCaption(i18n("Export Krita Settings"));
+    dialog.setDefaultDir(QDir(QStandardPaths::writableLocation(QStandardPaths::DocumentsLocation))
+                             .absoluteFilePath(QStringLiteral("krita-settings-%1.zip")
+                                                   .arg(QDate::currentDate().toString(Qt::ISODate))));
+    dialog.setMimeTypeFilters(QStringList() << QStringLiteral("application/zip"), QStringLiteral("application/zip"));
+    QString fileName = dialog.filename();
+    if (fileName.isEmpty()) return;
+    if (!fileName.startsWith(QLatin1String("content://")) && !fileName.endsWith(QLatin1String(".zip"), Qt::CaseInsensitive)) {
+        fileName += QStringLiteral(".zip");
+    }
+
+    QBuffer buffer;
+    {
+        QScopedPointer<KoStore> store(KoStore::createStore(&buffer, KoStore::Write,
+                                                           "application/x-krita-settings", KoStore::Zip));
+        bool ok = store && !store->bad();
+
+        auto add = [&store, &ok](const QString &name, const QByteArray &data) {
+            ok = ok && store->open(name) && store->write(data) == data.size() && store->close();
+        };
+
+        add(Core::MANIFEST_NAME,
+            Core::createManifest(entries, KritaVersionWrapper::versionString(true), platformName()));
+
+        Q_FOREACH (const Core::Entry &entry, entries) {
+            QFile file(Core::localPath(entry, cfgDir, resourceDir));
+            if (!file.open(QIODevice::ReadOnly)) {
+                ok = false;
+                break;
+            }
+            add(Core::archivePath(entry), file.readAll());
+        }
+
+        ok = ok && store->finalize();
+        if (!ok) {
+            QMessageBox::warning(parent, i18nc("@title:window", "Export Settings"),
+                                 i18n("Could not create the settings archive."));
+            return;
+        }
+    }
+
+    QFile out(fileName);
+    if (!out.open(QIODevice::WriteOnly) || out.write(buffer.data()) != buffer.data().size()) {
+        QMessageBox::warning(parent, i18nc("@title:window", "Export Settings"),
+                             i18n("Could not write %1:\n%2", fileName, out.errorString()));
+        return;
+    }
+    out.close();
+
+    // Read the archive back where possible (content:// URIs may not allow it)
+    {
+        QFile check(fileName);
+        if (check.open(QIODevice::ReadOnly) && check.size() > 0 && check.size() != buffer.data().size()) {
+            QMessageBox::warning(parent, i18nc("@title:window", "Export Settings"),
+                                 i18n("The settings archive was not written completely:\n%1",
+                                      readableLocation(fileName)));
+            return;
+        }
+    }
+
+    showSuccess(parent, i18nc("@title:window", "Export Settings"),
+                i18np("Settings exported successfully (1 file) to:\n%2",
+                      "Settings exported successfully (%1 files) to:\n%2",
+                      entries.size(), readableLocation(fileName)));
+}
+
+void KisSettingsTransfer::importSettings(QWidget *parent)
+{
+    KoFileDialog dialog(parent, KoFileDialog::OpenFile, "KritaSettingsImport");
+    dialog.setCaption(i18n("Import Krita Settings"));
+    dialog.setDefaultDir(QStandardPaths::writableLocation(QStandardPaths::DocumentsLocation));
+    dialog.setMimeTypeFilters(QStringList() << QStringLiteral("application/zip"), QStringLiteral("application/zip"));
+    const QString fileName = dialog.filename();
+    if (fileName.isEmpty()) return;
+
+    QFile in(fileName);
+    if (!in.open(QIODevice::ReadOnly)) {
+        QMessageBox::warning(parent, i18nc("@title:window", "Import Settings"),
+                             i18n("Could not read %1:\n%2", fileName, in.errorString()));
+        return;
+    }
+    const QByteArray zip = in.readAll();
+    in.close();
+
+    QVector<Core::Entry> entries;
+    QJsonObject info;
+    QHash<QString, QByteArray> files;
+    QString error;
+    if (!readArchive(zip, &entries, &info, &files, &error)) {
+        QMessageBox::warning(parent, i18nc("@title:window", "Import Settings"),
+                             i18n("This file cannot be imported:\n%1", error));
+        return;
+    }
+
+    const QMessageBox::StandardButton answer = QMessageBox::question(
+        parent, i18nc("@title:window", "Import Settings"),
+        i18n("Import these Krita settings?\n\n%1\n\n"
+             "They replace your current settings the next time Krita starts. "
+             "Your current settings are backed up first, to:\n%2\n\n"
+             "Recent files and the resource folder location of this device are kept.",
+             describe(info, entries.size()), backupDir()),
+        QMessageBox::Yes | QMessageBox::No, QMessageBox::No);
+    if (answer != QMessageBox::Yes) return;
+
+    QSaveFile pending(pendingImportPath());
+    if (!pending.open(QIODevice::WriteOnly) || pending.write(zip) != zip.size() || !pending.commit()) {
+        QMessageBox::warning(parent, i18nc("@title:window", "Import Settings"),
+                             i18n("Could not prepare the import:\n%1", pending.errorString()));
+        return;
+    }
+
+    const QMessageBox::StandardButton quit = QMessageBox::question(
+        parent, i18nc("@title:window", "Import Settings"),
+        i18n("The settings will be applied when Krita starts again.\n\nClose Krita now?"),
+        QMessageBox::Yes | QMessageBox::No, QMessageBox::Yes);
+    if (quit == QMessageBox::Yes && parent && parent->window()) {
+        // closing the main window asks about unsaved documents, then quits
+        QWidget *window = parent->window();
+        QTimer::singleShot(0, window, [window]() { window->close(); });
+    }
+}
+
+void KisSettingsTransfer::applyPendingImport()
+{
+    const QString pendingPath = pendingImportPath();
+    if (!QFile::exists(pendingPath)) return;
+
+    // Move it out of the way first: a broken archive must never be retried at every start.
+    const QString applyingPath = pendingPath + QStringLiteral(".applying");
+    QFile::remove(applyingPath);
+    if (!QFile::rename(pendingPath, applyingPath)) {
+        qWarning() << "Krita settings import: cannot move" << pendingPath << "- skipping import";
+        QFile::remove(pendingPath);
+        return;
+    }
+
+    QByteArray zip;
+    {
+        QFile file(applyingPath);
+        if (file.open(QIODevice::ReadOnly)) zip = file.readAll();
+    }
+
+    QVector<Core::Entry> entries;
+    QJsonObject info;
+    QHash<QString, QByteArray> files;
+    QString error;
+    QStringList log;
+
+    const bool ok = readArchive(zip, &entries, &info, &files, &error)
+        && Core::applyFiles(entries, files, configDir(), appDataLocation(), backupDir(), &log, &error);
+
+    Q_FOREACH (const QString &line, log) {
+        qInfo() << "Krita settings import:" << line;
+    }
+
+    QFile result(resultPath());
+    if (result.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        const QByteArray text = ok
+            ? QByteArray("ok\n") + describe(info, entries.size()).toUtf8()
+            : QByteArray("error\n") + error.toUtf8();
+        result.write(text);
+    }
+
+    if (ok) {
+        QFile::remove(applyingPath);
+    } else {
+        qWarning() << "Krita settings import failed:" << error;
+        QFile::remove(pendingPath + QStringLiteral(".failed"));
+        QFile::rename(applyingPath, pendingPath + QStringLiteral(".failed"));
+    }
+}
+
+void KisSettingsTransfer::showImportResult(QWidget *parent)
+{
+    QFile result(resultPath());
+    if (!result.exists() || !result.open(QIODevice::ReadOnly)) return;
+    const QString text = QString::fromUtf8(result.readAll());
+    result.close();
+    result.remove();
+
+    const QString status = text.section(QLatin1Char('\n'), 0, 0);
+    const QString details = text.section(QLatin1Char('\n'), 1);
+
+    if (status == QLatin1String("ok")) {
+        showSuccess(parent, i18nc("@title:window", "Import Settings"),
+                    i18n("Your settings were imported successfully.\n\n%1\n\n"
+                         "Your previous settings were backed up to:\n%2",
+                         details, backupDir()));
+    } else {
+        QMessageBox::warning(parent, i18nc("@title:window", "Import Settings"),
+                             i18n("Importing the settings failed:\n%1\n\n"
+                                  "If some settings were changed anyway, your previous settings are in:\n%2",
+                                  details, backupDir()));
+    }
+}
