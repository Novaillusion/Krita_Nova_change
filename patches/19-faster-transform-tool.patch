+                    bounds.unite(applicator.processLine<T>(srcPos, i, &buf, support));
+                }
+                chunkBounds[c] = bounds;
+            });
+        }
+        for (std::thread &worker : workers) {
+            worker.join();
+        }
+
+        bool first = true;
+        for (const KisFilterWeightsApplicator::LinePos &bounds : chunkBounds) {
+            if (first || bounds.size() > 0) {
+                if (first) {
+                    dstBounds = bounds;
+                    first = false;
+                } else {
+                    dstBounds.unite(bounds);
+                }
+            }
+        }
+
+        for (int i = 0; i < numLines; i++) {
+            progressHelper.step();
+        }
     }
 
