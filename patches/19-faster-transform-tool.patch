+    /**
+     * Krita Nova: every line (column for the vertical pass) is resampled
+     * independently and only writes to itself, so big passes are split into
+     * chunks of lines processed on several threads. The paint device's tiles
+     * are thread-safe (filters process one device from many threads, too);
+     * the weights buffer and the applicator are only read.
+     */
+    const int maxThreads = qBound(1, QThread::idealThreadCount(), 8);
+    const int minLinesPerChunk = 64;
+    const int chunks = qMin(maxThreads, numLines / minLinesPerChunk);
 
-        dstPos = applicator.processLine<T>(srcPos, i, &buf, filterStrategy->support(buf.weightsPositionScale().toFloat()));
-        dstBounds.unite(dstPos);
+    if (chunks <= 1) {
+        for (int i = firstLine; i < firstLine + numLines; i++) {
+            KisFilterWeightsApplicator::LinePos dstPos;
+            KisFilterWeightsApplicator::LinePos srcPos(srcStart, srcLen);
 
-        progressHelper.step();
+            dstPos = applicator.processLine<T>(srcPos, i, &buf, support);
+            dstBounds.unite(dstPos);
+
+            progressHelper.step();
+        }
+    } else {
+        std::vector<KisFilterWeightsApplicator::LinePos> chunkBounds(chunks);
+        std::vector<std::thread> workers;
+        workers.reserve(chunks);
+
+        for (int c = 0; c < chunks; c++) {
+            const int begin = firstLine + int(qint64(numLines) * c / chunks);
+            const int end = firstLine + int(qint64(numLines) * (c + 1) / chunks);
+
+            workers.emplace_back([&applicator, &buf, &chunkBounds, c, begin, end, srcStart, srcLen, support]() {
+                KisFilterWeightsApplicator::LinePos bounds;
+                for (int i = begin; i < end; i++) {
