+/**
+ * Krita Nova (patch 61): the Brush Panel docks to the left, right or bottom
+ * edge of the window. Drop it (by its grip) within a short distance of an
+ * edge and it docks there: as tall (or, at the bottom, as wide) as the
+ * window, lying down at the bottom. The window's contents - the dockers of
+ * that side, the canvas, the toolbars - move toward the center to make room
+ * (contents margins of the main window), so nothing is covered. Drag it away
+ * from the edge to float it again. The side is remembered (kritarc
+ * androidBrushPanelSide: 0 floating, 1 left, 2 right, 3 bottom).
+ */
+class BrushPanelDocking : public QObject
+{
+public:
+    enum Side { Floating = 0, Left = 1, Right = 2, Bottom = 3 };
+
+    BrushPanelDocking(QMainWindow *mainWindow, QDockWidget *dock, QWidget *container,
+                      BrushPanelToolBarKeeper *keeper, NovaPanelGrip *grip)
+        : QObject(dock), m_mainWindow(mainWindow), m_dock(dock), m_container(container),
+          m_keeper(keeper), m_grip(grip)
+    {
+        m_baseMargins = mainWindow->contentsMargins();
+        m_side = Side(qBound(0, KisConfig(true).readEntry("androidBrushPanelSide", 0), 3));
+        m_settle.setSingleShot(true);
+        m_settle.setInterval(250);
+        connect(&m_settle, &QTimer::timeout, this, [this]() { settle(); });
+        dock->installEventFilter(this);
+        mainWindow->installEventFilter(this);
+        if (m_side == Bottom) setLying(true);
+    }
+
+    bool isDocked() const { return m_side != Floating; }
+
+    /// put the docked panel at its edge and make room for it
+    bool placeDocked()
+    {
+        if (!isDocked() || !m_dock || !m_mainWindow) return false;
+        apply();
+        return true;
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        const QEvent::Type type = event->type();
+        if (watched == m_dock) {
+            if (type == QEvent::MouseButtonPress) {
+                m_pressed = true;
+                m_waits = 0;
+                m_moved = false;
+                m_pressSize = m_dock->size();
+            } else if (type == QEvent::MouseButtonRelease) {
+                m_pressed = false;
+                m_settle.start();
+            } else if (type == QEvent::Move && !m_applying) {
+                if (m_pressed) m_moved = true;
+                if (isDocked() && m_pressed && m_dock->size() == m_pressSize) {
+                    // dragged away from its edge: float again
+                    const QPoint d = m_dock->geometry().topLeft() - m_dockedRect.topLeft();
+                    if (d.manhattanLength() > 30) undock();
+                }
+                m_settle.start();
+            } else if (type == QEvent::Show) {
+                if (isDocked()) QTimer::singleShot(0, this, [this]() { apply(); });
+            } else if (type == QEvent::Hide) {
+                setMargins(0, 0, 0); // the space is given back while the panel is hidden
+            }
+        } else if (watched == m_mainWindow && (type == QEvent::Resize || type == QEvent::Move)) {
+            if (isDocked() && m_dock && m_dock->isVisible() && !m_applying) {
+                QTimer::singleShot(0, this, [this]() { apply(); });
+            }
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+private:
+    QRect area() const { return m_mainWindow->geometry(); }
+
+    /// the drag is over: dock to a near edge, or back to the docked place
+    void settle()
+    {
+        if (!m_dock || !m_mainWindow || !m_dock->isVisible()) return;
+        if (m_pressed) {
+            // a release that never reached the panel: give up after ~10 s
+            if (++m_waits < 40) { m_settle.start(); return; }
+            m_pressed = false;
+        }
+        m_waits = 0;
+        const bool userMoved = m_moved && m_dock->size() == m_pressSize; // a move, not a resize
+        m_moved = false;
+        if (isDocked()) {
+            apply(); // a nudge or a resize: back to the edge
+            return;
+        }
+        if (!userMoved) return;
+        const QRect a = area();
+        const QRect g = m_dock->frameGeometry();
+        const int snap = 40;
+        const int left = g.left() - a.left();
+        const int right = a.right() - g.right();
+        const int bottom = a.bottom() - g.bottom();
+        Side side = Floating;
+        int best = snap + 1;
+        if (left <= snap && left < best) { side = Left; best = left; }
+        if (right <= snap && right < best) { side = Right; best = right; }
+        if (bottom <= snap && bottom < best) { side = Bottom; best = bottom; }
+        if (side != Floating) dockTo(side);
+    }
+
+    void dockTo(Side side)
+    {
+        m_side = side;
+        KisConfig(false).writeEntry("androidBrushPanelSide", int(side));
+        setLying(side == Bottom);
+        apply();
+    }
+
+    void undock()
+    {
+        const QRect a = area();
+        m_side = Floating;
+        KisConfig(false).writeEntry("androidBrushPanelSide", int(Floating));
+        setMargins(0, 0, 0);
+        setLying(false);
+        m_applying = true;
+        const int width = panelThickness();
+        m_dock->setFixedWidth(width);
+        m_dock->setMinimumHeight(0);
+        m_dock->setMaximumHeight(QWIDGETSIZE_MAX);
+        m_dock->resize(width, floatingPanelHeight(a));
+        m_applying = false;
+    }
+
+    /// the panel's width standing up / its height lying down
+    int panelThickness() const
+    {
+        const int frame = 2 * m_dock->style()->pixelMetric(QStyle::PM_DockWidgetFrameWidth, nullptr, m_dock);
+        QWidget *content = m_dock->widget();
+        if (m_side == Bottom) {
+            return qMax(content ? content->sizeHint().height() : 0, 46) + frame;
+        }
+        return qMax(content ? content->sizeHint().width() : 0, 46) + frame;
+    }
+
+    void apply()
+    {
+        if (!isDocked() || !m_dock || !m_mainWindow || !m_dock->isVisible()) return;
+        m_applying = true;
+        const QRect a = area();
+        const int thickness = panelThickness();
+        QRect r;
+        if (m_side == Bottom) {
+            m_dock->setMinimumWidth(0);
+            m_dock->setMaximumWidth(QWIDGETSIZE_MAX);
+            m_dock->setFixedHeight(thickness);
+            r = QRect(a.left(), a.bottom() - thickness + 1, a.width(), thickness);
+            setMargins(0, 0, thickness);
+        } else {
+            m_dock->setMinimumHeight(0);
+            m_dock->setMaximumHeight(QWIDGETSIZE_MAX);
+            m_dock->setFixedWidth(thickness);
+            const int x = m_side == Left ? a.left() : a.right() - thickness + 1;
+            r = QRect(x, a.top(), thickness, a.height());
+            setMargins(m_side == Left ? thickness : 0, m_side == Right ? thickness : 0, 0);
+        }
+        m_dockedRect = r;
+        if (m_dock->geometry() != r) m_dock->setGeometry(r);
+        m_dock->raise();
+        m_applying = false;
+    }
+
+    void setMargins(int left, int right, int bottom)
+    {
+        if (!m_mainWindow) return;
+        const QMargins wanted(m_baseMargins.left() + left, m_baseMargins.top(),
+                              m_baseMargins.right() + right, m_baseMargins.bottom() + bottom);
+        if (m_mainWindow->contentsMargins() == wanted) return;
+        const bool was = m_applying;
+        m_applying = true;
+        m_mainWindow->setContentsMargins(wanted);
+        m_applying = was;
+    }
+
+    /// the panel standing up (a column) or lying down (a row, docked at the bottom)
+    void setLying(bool lying)
+    {
+        if (!m_container || !m_dock) return;
+        QBoxLayout *layout = qobject_cast<QBoxLayout *>(m_container->layout());
+        if (!layout) return;
+        layout->setDirection(lying ? QBoxLayout::LeftToRight : QBoxLayout::TopToBottom);
+        layout->setContentsMargins(lying ? QMargins(2, 3, 8, 3) : QMargins(3, 2, 3, 8));
+        const Qt::Alignment across = lying ? Qt::AlignVCenter : Qt::AlignHCenter;
+        for (int i = 0; i < layout->count(); ++i) {
+            QWidget *w = layout->itemAt(i)->widget();
+            if (!w) continue;
+            if (w->objectName() == QLatin1String("KritaNovaVerticalSliders")) {
+                if (QBoxLayout *inner = qobject_cast<QBoxLayout *>(w->layout())) {
+                    inner->setDirection(lying ? QBoxLayout::LeftToRight : QBoxLayout::TopToBottom);
+                    inner->setContentsMargins(lying ? QMargins(2, 0, 2, 0) : QMargins(0, 2, 0, 2));
+                    for (int j = 0; j < inner->count(); ++j) {
+                        if (QWidget *child = inner->itemAt(j)->widget()) inner->setAlignment(child, across);
+                    }
+                }
+                // (no Q_OBJECT in these small classes: no findChildren<NovaVerticalSlider *>)
+                Q_FOREACH (QWidget *child, w->findChildren<QWidget *>(QString(), Qt::FindDirectChildrenOnly)) {
+                    if (NovaVerticalSlider *slider = dynamic_cast<NovaVerticalSlider *>(child)) {
+                        slider->setHorizontal(lying);
+                    }
+                }
+                w->setSizePolicy(lying ? QSizePolicy::Expanding : QSizePolicy::Preferred,
+                                 lying ? QSizePolicy::Preferred : QSizePolicy::Expanding);
+            }
+            if (w->objectName() == QLatin1String("KritaNovaBrushPanelColors")) {
+                if (w->layout()) w->layout()->setContentsMargins(lying ? QMargins(8, 0, 4, 0) : QMargins(0, 8, 0, 4));
+            }
+            layout->setAlignment(w, across);
+        }
+        if (m_keeper) {
+            m_keeper->setEditOrientation(lying ? Qt::Horizontal : Qt::Vertical);
+            m_keeper->relocate();
+            // relocate() inserts the undo / redo toolbar centered: keep it in line
+            if (KisToolBar *edit = m_mainWindow ? m_mainWindow->findChild<KisToolBar *>(QStringLiteral("editToolBar")) : nullptr) {
+                if (layout->indexOf(edit) >= 0) layout->setAlignment(edit, across);
+            }
+        }
+        if (m_grip) m_grip->setVertical(lying);
+        m_dock->setFeatures(lying ? (m_dock->features() | QDockWidget::DockWidgetVerticalTitleBar)
+                                  : (m_dock->features() & ~QDockWidget::DockWidgetVerticalTitleBar));
+        layout->invalidate();
+        m_container->updateGeometry();
+    }
+
+    QPointer<QMainWindow> m_mainWindow;
+    QPointer<QDockWidget> m_dock;
+    QPointer<QWidget> m_container;
+    QPointer<BrushPanelToolBarKeeper> m_keeper;
+    QPointer<NovaPanelGrip> m_grip;
+    QMargins m_baseMargins;
+    Side m_side {Floating};
+    QRect m_dockedRect;
+    QSize m_pressSize;
+    QTimer m_settle;
+    int m_waits {0};
+    bool m_pressed {false};
+    bool m_moved {false};
+    bool m_applying {false};
+};
