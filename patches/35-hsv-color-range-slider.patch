+/**
+ * Krita Nova (patch 35): Photoshop's color range slider for the HSV
+ * adjustment. Two hue spectrum bars (top: the colors as they are, bottom: as
+ * the adjustment turns them) with the range of the color being edited in
+ * between: full effect between the two inner bars, fading out towards the two
+ * outer triangles. Drag a limit to move it, drag the range to move all four.
+ * Hues are continuous degrees; the bars are centered on the edited range.
+ */
+class KisHueRangeSlider : public QWidget
+{
+    Q_OBJECT
+public:
