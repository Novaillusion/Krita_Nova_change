+    /**
+     * How much color range \p i affects a pixel of hue \p hue (degrees):
+     * fully between its inner limits b..c, fading out linearly towards its
+     * outer limits a and d (Photoshop's range slider). The limits are
+     * continuous degrees (a <= b <= c <= d, d - a < 360) and may go below 0
+     * or above 360. Default: center -/+ 15 full, -/+ 45 outer.
+     */
+    inline float rangeWeight(int i, float hue) const
+    {
+        const float *r = m_rangeBounds[i];
+        float x = hue;
+        while (x < r[0]) x += 360.0f;
+        while (x >= r[0] + 360.0f) x -= 360.0f;
+        if (x < r[1]) return r[1] > r[0] ? (x - r[0]) / (r[1] - r[0]) : 1.0f;
+        if (x <= r[2]) return 1.0f;
+        if (x < r[3]) return (r[3] - x) / (r[3] - r[2]);
+        return 0.0f;
+    }
+
+    float m_rangeBounds[6][4] {
+        {-45, -15, 15, 45}, {15, 45, 75, 105}, {75, 105, 135, 165},
+        {135, 165, 195, 225}, {195, 225, 255, 285}, {255, 285, 315, 345},
+    };
     float m_rangeH[6] {0, 0, 0, 0, 0, 0};
     float m_rangeS[6] {0, 0, 0, 0, 0, 0};
     float m_rangeV[6] {0, 0, 0, 0, 0, 0};
