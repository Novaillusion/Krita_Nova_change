+
+void KisHSVConfigWidget::updateRangeSlider()
+{
+    if (!m_rangeSlider) return;
+    const bool isRange = m_currentRange >= 1;
+    const int masterHue = isRange ? m_rangeValues[0][0] : m_page->hSlider->value();
+    const int rangeHue = isRange ? m_page->hSlider->value() : 0;
+
+    m_rangeSlider->setRangeVisible(isRange);
+    if (isRange) {
+        const std::array<int, 4> &r = m_rangeLimits[m_currentRange];
+        m_rangeSlider->setLimits(r);
+        m_rangeSlider->setCenterHue((m_currentRange - 1) * 60);
+        // like Photoshop: 315°/345° \ 15°/45°
+        m_rangeLimitsLabel->setText(QString("%1/%2  \\  %3/%4")
+                                        .arg(hueText(r[0]), hueText(r[1]), hueText(r[2]), hueText(r[3])));
+    } else {
+        m_rangeSlider->setCenterHue(0); // red in the middle, like Photoshop
+        m_rangeLimitsLabel->setText(QString());
+    }
+    m_rangeSlider->setHueShifts(masterHue, rangeHue);
+}
+
+// ---------------------------------------------------------------------------
+// KisHueRangeSlider (Krita Nova, patch 35)
+
+namespace {
+const int BAR_HEIGHT = 10;
+const int RANGE_HEIGHT = 16;
+const int SIDE_MARGIN = 8;
+const int HANDLE_GRAB = 10;
+}
+
+KisHueRangeSlider::KisHueRangeSlider(QWidget *parent)
+    : QWidget(parent)
+{
+    setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+    setMouseTracking(false);
+}
+
+QSize KisHueRangeSlider::sizeHint() const
+{
+    return QSize(360, 2 * BAR_HEIGHT + RANGE_HEIGHT + 8);
+}
+
+QSize KisHueRangeSlider::minimumSizeHint() const
+{
+    return QSize(180, 2 * BAR_HEIGHT + RANGE_HEIGHT + 8);
+}
+
+void KisHueRangeSlider::setLimits(const std::array<int, 4> &limits)
+{
+    if (m_limits == limits) return;
+    m_limits = limits;
+    update();
+}
+
+void KisHueRangeSlider::setRangeVisible(bool visible)
+{
+    if (m_rangeVisible == visible) return;
+    m_rangeVisible = visible;
+    m_drag = -1;
+    update();
+}
+
+void KisHueRangeSlider::setCenterHue(qreal hue)
+{
+    m_center = hue;
+    update();
+}
+
+void KisHueRangeSlider::setHueShifts(qreal master, qreal range)
+{
+    m_masterShift = master;
+    m_rangeShift = range;
+    update();
+}
+
+QRect KisHueRangeSlider::barsRect() const
+{
+    return rect().adjusted(SIDE_MARGIN, 2, -SIDE_MARGIN, -2);
+}
+
+qreal KisHueRangeSlider::xForHue(qreal hue) const
+{
+    const QRect r = barsRect();
+    // the hue's position within the 360 degrees around the center
+    qreal offset = hue - (m_center - 180.0);
+    offset = std::fmod(offset, 360.0);
+    if (offset < 0) offset += 360.0;
+    return r.left() + offset / 360.0 * r.width();
+}
+
+qreal KisHueRangeSlider::hueForX(qreal x) const
+{
+    const QRect r = barsRect();
+    return m_center - 180.0 + (x - r.left()) / qMax(1, r.width()) * 360.0;
+}
+
+qreal KisHueRangeSlider::weightAt(qreal hue) const
+{
+    const std::array<int, 4> &r = m_limits;
+    qreal x = hue;
+    while (x < r[0]) x += 360.0;
+    while (x >= r[0] + 360.0) x -= 360.0;
+    if (x < r[1]) return r[1] > r[0] ? (x - r[0]) / (r[1] - r[0]) : 1.0;
+    if (x <= r[2]) return 1.0;
+    if (x < r[3]) return (r[3] - x) / (r[3] - r[2]);
+    return 0.0;
+}
+
+void KisHueRangeSlider::paintEvent(QPaintEvent *)
+{
+    QPainter p(this);
+    const QRect r = barsRect();
+    const int top = r.top();
+    const int bottom = r.bottom() - BAR_HEIGHT + 1;
+    const int rangeTop = top + BAR_HEIGHT + 4;
+
+    auto hueColor = [](qreal hue) {
+        qreal h = std::fmod(hue, 360.0);
+        if (h < 0) h += 360.0;
+        return QColor::fromHsvF(h / 360.0, 1.0, 1.0);
+    };
+
+    // spectrum bars: as they are (top) and as adjusted (bottom)
+    for (int x = r.left(); x <= r.right(); ++x) {
+        const qreal hue = hueForX(x + 0.5);
+        p.setPen(hueColor(hue));
+        p.drawLine(x, top, x, top + BAR_HEIGHT - 1);
+        const qreal shift = m_masterShift + (m_rangeVisible ? weightAt(hue) * m_rangeShift : 0.0);
+        p.setPen(hueColor(hue + shift));
+        p.drawLine(x, bottom, x, bottom + BAR_HEIGHT - 1);
+    }
+    p.setPen(palette().color(QPalette::Mid));
+    p.setBrush(Qt::NoBrush);
+    p.drawRect(r.left(), top, r.width() - 1, BAR_HEIGHT - 1);
+    p.drawRect(r.left(), bottom, r.width() - 1, BAR_HEIGHT - 1);
+
+    if (!m_rangeVisible) return;
+
+    // the range: falloff (light), full effect (dark), limits
+    const qreal xa = xForHue(m_limits[0]);
+    const qreal span = (m_limits[3] - m_limits[0]) / 360.0 * r.width();
+    const qreal xb = xa + (m_limits[1] - m_limits[0]) / 360.0 * r.width();
+    const qreal xc = xa + (m_limits[2] - m_limits[0]) / 360.0 * r.width();
+    const qreal xd = xa + span;
+    const int barY = rangeTop + RANGE_HEIGHT / 2 - 3;
+    const QColor falloff = palette().color(QPalette::Mid);
+    const QColor full = palette().color(QPalette::Dark).darker(110);
+
+    p.setRenderHint(QPainter::Antialiasing, true);
+    // the range may run past the right end: draw it once more shifted left
+    for (const qreal shiftX : {0.0, -qreal(r.width())}) {
+        p.save();
+        p.setClipRect(r);
+        p.translate(shiftX, 0);
+        p.fillRect(QRectF(xa, barY, xd - xa, 6), falloff);
+        p.fillRect(QRectF(xb, barY, xc - xb, 6), full);
+
+        p.setPen(QPen(palette().color(QPalette::WindowText), 1));
+        p.setBrush(palette().color(QPalette::Button));
+        // inner limits: small bars
+        for (const qreal x : {xb, xc}) {
+            p.drawRect(QRectF(x - 2.5, rangeTop, 5, RANGE_HEIGHT));
+        }
+        // outer limits: triangles
+        for (const qreal x : {xa, xd}) {
+            const QPointF tri[3] = {QPointF(x, barY - 1), QPointF(x - 5, rangeTop + RANGE_HEIGHT),
+                                    QPointF(x + 5, rangeTop + RANGE_HEIGHT)};
+            p.drawPolygon(tri, 3);
+        }
+        p.restore();
+    }
+}
+
+void KisHueRangeSlider::mousePressEvent(QMouseEvent *event)
+{
+    if (!m_rangeVisible || event->button() != Qt::LeftButton) {
+        QWidget::mousePressEvent(event);
+        return;
+    }
+    const QRect r = barsRect();
+    const qreal xa = xForHue(m_limits[0]);
+    qreal xs[4];
+    for (int k = 0; k < 4; ++k) xs[k] = xa + (m_limits[k] - m_limits[0]) / 360.0 * r.width();
+
+    // the range drawn where it was pressed (it may wrap past the right end)
+    qreal px = event->pos().x();
+    if (px < xa - HANDLE_GRAB) px += r.width();
+
+    int best = -1;
+    qreal bestDistance = HANDLE_GRAB;
+    // inner limits first: they win when both are in reach
+    for (int k : {1, 2, 0, 3}) {
+        const qreal distance = std::abs(px - xs[k]);
+        if (distance < bestDistance - 0.5) {
+            best = k;
+            bestDistance = distance;
+        }
+    }
+    if (best < 0 && px > xs[0] && px < xs[3]) best = 4;
+
+    m_drag = best;
+    m_pressX = event->pos().x();
+    m_pressLimits = m_limits;
+    event->accept();
+}
+
+void KisHueRangeSlider::mouseMoveEvent(QMouseEvent *event)
+{
+    if (m_drag < 0) {
+        QWidget::mouseMoveEvent(event);
+        return;
+    }
+    const QRect r = barsRect();
+    const int delta = qRound((event->pos().x() - m_pressX) * 360.0 / qMax(1, r.width()));
+    std::array<int, 4> l = m_pressLimits;
+    if (m_drag == 4) {
+        for (int &v : l) v += delta;
+    } else {
+        const int k = m_drag;
+        int v = m_pressLimits[k] + delta;
+        const int lower = k > 0 ? l[k - 1] : l[3] - 359;
+        const int upper = k < 3 ? l[k + 1] : l[0] + 359;
+        v = qBound(lower, v, upper);
+        l[k] = v;
+    }
+    if (l != m_limits) {
+        m_limits = l;
+        update();
+        Q_EMIT limitsChanged();
+    }
+    event->accept();
+}
+
+void KisHueRangeSlider::mouseReleaseEvent(QMouseEvent *event)
+{
+    m_drag = -1;
+    QWidget::mouseReleaseEvent(event);
+}
