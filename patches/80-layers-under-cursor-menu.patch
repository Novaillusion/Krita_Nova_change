+    // Krita Nova (patch 80): like Photoshop, the right-click menu starts with
+    // the layers that have visible content under the cursor, top to bottom;
+    // picking one makes it the active layer
+    void novaAddLayersUnderCursor(QMenu *menu, KisCanvas2 *kisCanvas) {
+        if (!menu || !kisCanvas || !kisCanvas->viewManager()) return;
+        KisImageSP image = this->image();
+        if (!image || !image->root()) return;
+
+        const QPoint pos = m_currentPos.toPoint();
+        if (!image->bounds().contains(pos)) return;
+
+        const KisNodeList found =
+            KisToolUtils::findNodes(image->root()->firstChild(), pos, false, false);
+        if (found.isEmpty()) return;
+
+        QPointer<KisViewManager> view = kisCanvas->viewManager();
+        const KisNodeSP active = this->currentNode();
+        QAction *before = menu->actions().value(0);
+
+        menu->insertSection(before, i18n("Layers Under Cursor"));
+
+        // findNodes() lists bottom to top: reverse, so the menu reads like
+        // the Layers docker
+        for (int i = found.size() - 1; i >= 0; --i) {
+            KisNodeSP node = found[i];
+            int indentation = -1;
+            for (KisNodeSP n = node; n->parent(); n = n->parent()) ++indentation;
+
+            QAction *action = new QAction(QString(4 * qMax(0, indentation), ' ') + node->name(), menu);
+            action->setCheckable(true);
+            action->setChecked(node == active);
+            QObject::connect(action, &QAction::triggered, [view, node]() {
+                if (view && view->nodeManager() && node->graphListener()) {
+                    view->nodeManager()->slotImageRequestNodeReselection(node, {node});
+                }
+            });
+            menu->insertAction(before, action);
+        }
     }
 
     KisPopupWidgetInterface* popupWidget() override
