@@ -36,9 +36,50 @@
 #include "KisAnimAutoKey.h"
 
 #include <QApplication>
+#include <QMenu>
+#include <QAction>
+#include <QPointer>
+#include <klocalizedstring.h>
 
 namespace KisToolUtils {
 
+    int novaAddLayersUnderCursor(QMenu *menu, KisCanvas2 *canvas, const QPoint &pixelPos)
+    {
+        if (!menu || !canvas || !canvas->viewManager()) return 0;
+        KisImageSP image = canvas->image();
+        if (!image || !image->root()) return 0;
+        if (!image->bounds().contains(pixelPos)) return 0;
+
+        const KisNodeList found = findNodes(image->root()->firstChild(), pixelPos, false, false);
+        if (found.isEmpty()) return 0;
+
+        QPointer<KisViewManager> view = canvas->viewManager();
+        const KisNodeSP active = view->activeNode();
+        QAction *before = menu->actions().value(0);
+
+        menu->insertSection(before, i18n("Layers Under Cursor"));
+
+        // findNodes() lists bottom to top: reverse, so the menu reads like
+        // the Layers docker
+        for (int i = found.size() - 1; i >= 0; --i) {
+            KisNodeSP node = found[i];
+            int indentation = -1;
+            for (KisNodeSP n = node; n->parent(); n = n->parent()) ++indentation;
+
+            QAction *action = new QAction(QString(4 * qMax(0, indentation), ' ') + node->name(), menu);
+            action->setCheckable(true);
+            action->setChecked(node == active);
+            QObject::connect(action, &QAction::triggered, [view, node]() {
+                if (view && view->nodeManager() && node->graphListener()) {
+                    view->nodeManager()->slotImageRequestNodeReselection(node, {node});
+                }
+            });
+            menu->insertAction(before, action);
+        }
+        if (before) menu->insertSeparator(before);
+        return found.size();
+    }
