+QMenu *KisToolMove::popupActionsMenu()
+{
+    // Krita Nova (patch 81): like Photoshop's Move tool, right-click lists
+    // the layers with content under the cursor; picking one activates it
+    if (mode() == KisTool::PAINT_MODE) return nullptr;
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(canvas());
+    if (!kisCanvas) return nullptr;
+
+    if (!m_novaLayersMenu) m_novaLayersMenu.reset(new QMenu());
+    m_novaLayersMenu->clear();
+    if (!KisToolUtils::novaAddLayersUnderCursor(m_novaLayersMenu.data(), kisCanvas, m_lastCursorPos)) {
+        return nullptr;
+    }
+    return m_novaLayersMenu.data();
+}
