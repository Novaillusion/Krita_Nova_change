+KisAbrPresetImporter::ParsedFile KisAbrPresetImporter::parse(const QByteArray &data)
+{
+    ParsedFile result;
+    Reader r(data);
+
+    result.version = r.u16();
+    r.u16(); // subversion
+    if (r.failed()) {
+        result.error = i18n("The file is too short to be a Photoshop brush file.");
+        return result;
+    }
+
+    if (result.version == 1 || result.version == 2) {
+        // no settings in these old files, the tips have names of their own
+        result.ok = true;
+        return result;
+    }
+    if (result.version < 6 || result.version > 10) {
+        result.error = i18n("This version of Photoshop brush files (%1) is not supported.", result.version);
+        return result;
+    }
+
+    QByteArray samples;
+    QByteArray descriptor;
+
+    while (r.pos() + 12 <= r.size() && !r.failed()) {
+        const QString signature = r.fixed4();
+        const QString key = r.fixed4();
+        const quint32 length = r.u32();
+        if (signature != "8BIM" || !r.has(int(length))) break;
+
+        if (key == "samp") samples = r.bytes(int(length));
+        else if (key == "desc") descriptor = r.bytes(int(length));
+        else r.seek(r.pos() + int(length));
+    }
+
+    // the samples: each starts with its length and its id (a Pascal string)
+    {
+        Reader s(samples);
+        while (s.pos() + 4 < s.size() && !s.failed()) {
+            const quint32 length = s.u32();
+            const int next = s.pos() + int((length + 3) & ~3u);
+            const int idLength = s.u8();
+            result.sampleUuids.append(QString::fromLatin1(s.bytes(idLength)));
+            if (next > s.size()) break;
+            s.seek(next);
+        }
+    }
+
+    if (!descriptor.isEmpty()) {
+        Reader d(descriptor);
+        d.u32(); // descriptor version (16)
+        const QVariantMap root = readDescriptor(d, 0);
+        if (d.failed()) {
+            warnKrita << "Photoshop brushes: could not read the brush settings, importing the tips only";
+        } else {
+            const QVariantList list = root.value("Brsh").toList();
+            for (const QVariant &item : list) {
+                const QVariantMap preset = item.toMap();
+                if (preset.value("_class").toString() != "brushPreset" && !preset.contains("Brsh")) continue;
+                result.brushes.append(brushInfo(preset));
+            }
+        }
+    }
+
+    result.ok = true;
+    return result;
+}
+
+KisAbrPresetImporter::Result KisAbrPresetImporter::importData(const QString &fileName, const QByteArray &data)
+{
+    Result result;
+
+    const ParsedFile parsed = parse(data);
+    if (!parsed.ok) {
+        result.error = parsed.error;
+        return result;
+    }
+
+    // 1. the tips: the .abr becomes a storage in the resource folder
+    bool alreadyThere = false;
+    const QString storageName = storageNameFor(fileName, data, &alreadyThere);
+    if (storageName.isEmpty()) {
+        result.error = i18n("Could not find a free file name in the resource folder.");
+        return result;
+    }
+    const QString storageLocation = KoResourcePaths::getAppDataLocation() + '/' + storageName;
+
+    if (!alreadyThere || !KisResourceLocator::instance()->hasStorage(storageLocation)) {
+        KisStorageModel storageModel;
+        if (!alreadyThere && !storageModel.importStorageData(storageName, KisStorageModel::None, data)) {
+            result.error = i18n("Could not import the brush tips of %1.", fileName);
+            return result;
+        }
+        if (alreadyThere && !KisResourceLocator::instance()->hasStorage(storageLocation)) {
+            KisResourceStorageSP storage = QSharedPointer<KisResourceStorage>::create(storageLocation);
+            if (!storage->valid() || !KisResourceLocator::instance()->addStorage(storageLocation, storage)) {
+                result.error = i18n("Could not import the brush tips of %1.", fileName);
+                return result;
+            }
+        }
+    }
+
+    const QString base = QFileInfo(storageName).completeBaseName();
+    result.tagName = base;
+
+    KisResourceModel brushes(ResourceType::Brushes);
+
+    // 2. the brushes to make: from the settings, or one per tip
+    QVector<BrushInfo> infos = parsed.brushes;
+    QVector<KisBrushSP> tips;
+
+    if (infos.isEmpty()) {
+        if (!parsed.sampleUuids.isEmpty()) {
+            for (int i = 0; i < parsed.sampleUuids.size(); i++) {
+                BrushInfo info;
+                info.computed = false;
+                info.sampleUuid = parsed.sampleUuids[i];
+                info.name = i18n("%1 %2", base, i + 1);
+                infos.append(info);
+            }
+        } else {
+            // version 1 / 2: the names Krita gave the tips
+            KisAbrBrushCollection collection(storageLocation);
+            collection.load();
+            QStringList names = collection.brushesMap()->keys();
+            for (const QString &name : names) {
+                BrushInfo info;
+                info.computed = false;
+                info.name = name;
+                info.sampleUuid = QStringLiteral("name:") + name;
+                infos.append(info);
+            }
+        }
+    }
+
+    KisResourceModel presets(ResourceType::PaintOpPresets);
+    QVector<KoResourceSP> added;
+    QSet<QString> usedNames;
+    const KoID paintbrush("paintbrush");
+
+    for (int i = 0; i < infos.size(); i++) {
+        const BrushInfo &info = infos[i];
+        QString name = info.name.isEmpty() ? i18n("%1 %2", base, i + 1) : info.name;
+        if (usedNames.contains(name)) {
+            int n = 2;
+            while (usedNames.contains(QString("%1 (%2)").arg(name).arg(n))) n++;
+            name = QString("%1 (%2)").arg(name).arg(n);
+        }
+        usedNames.insert(name);
+
+        // the tip
+        KisBrushSP brush;
+        qreal ratio = 1.0; // roundness of a sampled tip (a computed one has it in its shape)
+
+        if (info.computed) {
+            KisCircleMaskGenerator *shape = new KisCircleMaskGenerator(info.diameter, info.roundness,
+                                                                       qMax(0.01, info.hardness),
+                                                                       qMax(0.01, info.hardness),
+                                                                       2, true);
+            brush = KisBrushSP(new KisAutoBrush(shape, qDegreesToRadians(info.angle), 0.0));
+        } else {
+            QString tipName;
+            if (info.sampleUuid.startsWith("name:")) {
+                tipName = info.sampleUuid.mid(5);
+            } else {
+                const int index = parsed.sampleUuids.indexOf(info.sampleUuid);
+                if (index >= 0) tipName = QString("%1_%2").arg(base).arg(index + 1);
+            }
+            brush = tipName.isEmpty() ? KisBrushSP() : tipByName(brushes, tipName);
+            if (!brush) {
+                result.skipped << name;
+                continue;
+            }
+            const QImage tip = brush->brushTipImage();
+            const int tipSize = qMax(tip.width(), tip.height());
+            if (tipSize > 0 && !parsed.brushes.isEmpty()) {
+                brush->setScale(info.diameter / tipSize);
+            }
+            brush->setAngle(qDegreesToRadians(info.angle));
+            ratio = info.roundness;
+        }
+        brush->setSpacing(info.spacing);
+        brush->setAutoSpacing(false, 1.0);
+
+        // the settings
+        KisPaintOpSettingsSP settings =
+            KisPaintOpRegistry::instance()->createSettings(paintbrush, KisGlobalResourcesInterface::instance());
+        if (!settings) {
+            result.error = i18n("The Pixel brush engine is not available.");
+            return result;
+        }
+        settings->setProperty("brush_definition", brushDefinition(brush));
+
+        KisSizeOptionData size;
+        applySizeLike(size, info.tipDynamics ? info.size : Variation(), info.minimumDiameter);
+        size.write(settings.data());
+
+        KisRotationOptionData rotation;
+        applyRotation(rotation, info.tipDynamics ? info.angleVariation : Variation());
+        rotation.write(settings.data());
+
+        KisRatioOptionData ratioOption;
+        resetSensors(ratioOption);
+        ratioOption.isChecked = ratio < 0.999;
+        ratioOption.strengthValue = ratio;
+        ratioOption.write(settings.data());
+
+        KisScatterOptionData scatter;
+        resetSensors(scatter);
+        scatter.isChecked = info.scatterOn && info.scatter.jitter > 0.0;
+        scatter.strengthValue = qMin(5.0, info.scatter.jitter);
+        scatter.axisX = info.scatterBothAxes;
+        scatter.axisY = true;
+        if (info.scatter.control == 2) {
+            scatter.sensorStruct().sensorPressure.isActive = true;
+        } else if (info.scatter.control == 1) {
+            scatter.sensorStruct().sensorFade.isActive = true;
+            scatter.sensorStruct().sensorFade.length = info.scatter.fadeSteps;
+            scatter.sensorStruct().sensorFade.curve = curveString(1.0, 0.0);
+        }
+        scatter.write(settings.data());
+
+        KisOpacityOptionData opacity;
+        applySizeLike(opacity, info.paintDynamics ? info.opacity : Variation(), 0.0);
+        opacity.write(settings.data());
+
+        KisFlowOptionData flow;
+        applySizeLike(flow, info.paintDynamics ? info.flow : Variation(), 0.0);
+        flow.write(settings.data());
+
+        // the preset
+        KisPaintOpPresetSP preset(new KisPaintOpPreset());
+        preset->setName(name);
+        preset->setPaintOp(paintbrush);
+        preset->setSettings(settings);
+        preset->setImage(thumbnailFor(brush));
+        preset->setFilename(QString(name).replace(QRegularExpression("[\\\\/:*?\"<>|]"), "_") + preset->defaultFileExtension());
+        preset->setValid(true);
+
+        if (!presets.addResourceDeduplicateFileName(preset)) {
+            result.skipped << name;
+            continue;
+        }
+        added.append(preset);
+    }
+
+    // 3. a tag named after the file
+    if (!added.isEmpty()) {
+        KisTagModel tagModel(ResourceType::PaintOpPresets);
+        KisTagSP tag = tagModel.tagForUrl(result.tagName);
+        if (!tag) {
+            tag = tagModel.addTag(result.tagName, false, added);
+        } else {
+            QVector<int> ids;
+            for (const KoResourceSP &resource : added) ids << resource->resourceId();
+            KisTagResourceModel tagResources(ResourceType::PaintOpPresets);
+            tagResources.tagResources(tag, ids);
+        }
+    }
+
+    result.presets = added.size();
+    result.ok = added.size() > 0;
+    if (!result.ok && result.error.isEmpty()) {
+        result.error = i18n("No brushes could be made from %1.", fileName);
+    }
+    return result;
+}
diff --git a/plugins/extensions/photoshopbrushes/KisAbrPresetImporter.h b/plugins/extensions/photoshopbrushes/KisAbrPresetImporter.h
new file mode 100644
index 0000000..5d74ba1
--- /dev/null
+++ b/plugins/extensions/photoshopbrushes/KisAbrPresetImporter.h
@@ -0,0 +1,93 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_ABR_PRESET_IMPORTER_H
+#define KIS_ABR_PRESET_IMPORTER_H
+
+#include <QByteArray>
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+/**
+ * Krita Nova: imports a Photoshop brush file (.abr) as ready-to-use pixel
+ * brush presets.
+ *
+ * The brush tips are imported the way Krita always did (the .abr file is
+ * copied into the resource folder and becomes a storage of brush tips). Then
+ * every brush of the file becomes a preset of the Pixel brush engine with the
+ * settings of the Photoshop brush that Krita can do: tip shape (computed round
+ * tips become auto brushes), size, angle, roundness, hardness, spacing, the
+ * size / angle jitter and their controls (pen pressure, tilt, fade, ...),
+ * scatter, and opacity / flow jitter and controls ("Transfer"). Texture, dual
+ * brush, color dynamics, count, noise and wet edges are left out.
+ *
+ * The presets get a tag named after the file.
+ */
+class KisAbrPresetImporter
+{
+public:
+    /// a Photoshop "brVr" (brush variation): a control and a jitter
+    struct Variation {
+        /// 0 off, 1 fade, 2 pen pressure, 3 pen tilt, 4 stylus wheel,
+        /// 5 rotation, 6 initial direction, 7 direction
+        int control = 0;
+        int fadeSteps = 25;
+        qreal jitter = 0.0; ///< 0..1
+    };
+
+    /// one Photoshop brush preset, as read from the "desc" section
+    struct BrushInfo {
+        QString name;
+        bool computed = true;      ///< a round tip made from settings (else a sampled tip)
+        QString sampleUuid;        ///< for a sampled tip: which sample
+        qreal diameter = 25.0;     ///< pixels
+        qreal angle = 0.0;         ///< degrees, counterclockwise
+        qreal roundness = 1.0;     ///< 0..1
+        qreal hardness = 1.0;      ///< 0..1 (computed tips)
+        qreal spacing = 0.25;      ///< of the diameter
+
+        bool tipDynamics = false;
+        Variation size;
+        qreal minimumDiameter = 0.0; ///< 0..1
+        Variation angleVariation;
+
+        bool scatterOn = false;
+        Variation scatter;         ///< jitter: 0..10 (1000 %)
+        bool scatterBothAxes = false;
+
+        bool paintDynamics = false;
+        Variation opacity;
+        Variation flow;
+    };
+
+    struct ParsedFile {
+        bool ok = false;
+        QString error;
+        int version = 0;
+        QStringList sampleUuids;   ///< in file order (Krita names tip i "<file>_<i+1>")
+        QVector<BrushInfo> brushes; ///< empty: the file has no brush settings
+    };
+
+    struct Result {
+        bool ok = false;
+        QString error;
+        QString tagName;
+        int presets = 0;
+        QStringList skipped;       ///< brushes that could not be made
+    };
+
+    /// reads the samples' ids and the brush settings of an .abr file
+    static ParsedFile parse(const QByteArray &data);
+
+    /**
+     * Imports \p data (the contents of the .abr file called \p fileName).
+     * Must be called from the GUI thread.
+     */
+    static Result importData(const QString &fileName, const QByteArray &data);
+};
+
+#endif // KIS_ABR_PRESET_IMPORTER_H
