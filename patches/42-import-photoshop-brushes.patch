+// ---------------------------------------------------------------------------
+// Reading Photoshop's action descriptors (the "desc" section of an .abr)
+// ---------------------------------------------------------------------------
+
+class Reader
+{
+public:
+    Reader(const QByteArray &data) : m_data(data) {}
+
+    bool failed() const { return m_failed; }
+    int pos() const { return m_pos; }
+    void seek(int pos) { if (pos < 0 || pos > m_data.size()) fail(); else m_pos = pos; }
+    int size() const { return m_data.size(); }
+
+    bool has(int bytes) {
+        if (m_failed || bytes < 0 || m_pos + bytes > m_data.size()) {
+            fail();
+            return false;
+        }
+        return true;
+    }
+
+    quint8 u8() {
+        if (!has(1)) return 0;
+        return quint8(m_data[m_pos++]);
+    }
+    quint16 u16() {
+        if (!has(2)) return 0;
+        const quint16 v = qFromBigEndian<quint16>(m_data.constData() + m_pos);
+        m_pos += 2;
+        return v;
+    }
+    quint32 u32() {
+        if (!has(4)) return 0;
+        const quint32 v = qFromBigEndian<quint32>(m_data.constData() + m_pos);
+        m_pos += 4;
+        return v;
+    }
+    qint64 i64() {
+        if (!has(8)) return 0;
+        const qint64 v = qFromBigEndian<qint64>(m_data.constData() + m_pos);
+        m_pos += 8;
+        return v;
+    }
+    double f64() {
+        if (!has(8)) return 0.0;
+        const quint64 bits = qFromBigEndian<quint64>(m_data.constData() + m_pos);
+        m_pos += 8;
+        double v;
+        memcpy(&v, &bits, sizeof(v));
+        return v;
+    }
+    QByteArray bytes(int n) {
+        if (!has(n)) return QByteArray();
+        const QByteArray v = m_data.mid(m_pos, n);
+        m_pos += n;
+        return v;
+    }
+    QString fixed4() { return QString::fromLatin1(bytes(4)); }
+
+    /// a key / class id: a length, or 0 for a four character id
+    QString id() {
+        quint32 n = u32();
+        if (n == 0) n = 4;
+        if (n > 4096) { fail(); return QString(); }
+        return QString::fromLatin1(bytes(int(n)));
+    }
+
+    QString unicode() {
+        const quint32 n = u32();
+        if (n > (1u << 20) || !has(int(n) * 2)) { fail(); return QString(); }
+        QString s;
+        s.reserve(int(n));
+        for (quint32 i = 0; i < n; i++) {
+            s.append(QChar(u16()));
+        }
+        while (s.endsWith(QChar(0))) s.chop(1);
+        return s;
+    }
+
+    void fail() { m_failed = true; }
+
+private:
+    const QByteArray &m_data;
+    int m_pos = 0;
+    bool m_failed = false;
+};
+
+QVariant readItem(Reader &r, int depth);
+
+QVariantMap readDescriptor(Reader &r, int depth)
+{
+    QVariantMap result;
+    if (depth > 32) { r.fail(); return result; }
+
+    r.unicode(); // name
+    result.insert("_class", r.id());
+    const quint32 count = r.u32();
+    if (count > 100000) { r.fail(); return result; }
+
+    for (quint32 i = 0; i < count && !r.failed(); i++) {
+        const QString key = r.id();
+        result.insert(key, readItem(r, depth + 1));
+    }
+    return result;
+}
+
+/// skips a reference ("obj "), keeps nothing of it
+void skipReference(Reader &r)
+{
+    const quint32 count = r.u32();
+    for (quint32 i = 0; i < count && !r.failed(); i++) {
+        const QString type = r.fixed4();
+        if (type == "prop") {
+            r.unicode(); r.id(); r.id();
+        } else if (type == "Clss") {
+            r.unicode(); r.id();
+        } else if (type == "Enmr") {
+            r.unicode(); r.id(); r.id(); r.id();
+        } else if (type == "rele") {
+            r.unicode(); r.id(); r.u32();
+        } else if (type == "Idnt" || type == "indx") {
+            r.u32();
+        } else if (type == "name") {
+            r.unicode(); r.id(); r.unicode();
+        } else {
+            r.fail();
+        }
+    }
+}
+
+QVariant readItem(Reader &r, int depth)
+{
+    const QString type = r.fixed4();
+
+    if (type == "Objc" || type == "GlbO") {
+        return readDescriptor(r, depth);
+    } else if (type == "VlLs") {
+        const quint32 count = r.u32();
+        if (count > 100000) { r.fail(); return QVariant(); }
+        QVariantList list;
+        for (quint32 i = 0; i < count && !r.failed(); i++) {
+            list.append(readItem(r, depth + 1));
+        }
+        return list;
+    } else if (type == "doub") {
+        return r.f64();
+    } else if (type == "UntF") {
+        r.fixed4(); // unit: #Pxl, #Prc, #Ang, ...
+        return r.f64();
+    } else if (type == "UnFl") {
+        r.fixed4();
+        const quint32 count = r.u32();
+        if (!r.has(int(count) * 8)) return QVariant();
+        QVariantList list;
+        for (quint32 i = 0; i < count; i++) list.append(r.f64());
+        return list;
+    } else if (type == "TEXT") {
+        return r.unicode();
+    } else if (type == "enum") {
+        r.id();          // type
+        return r.id();   // value
+    } else if (type == "long") {
+        return int(qint32(r.u32()));
+    } else if (type == "comp") {
+        return r.i64();
+    } else if (type == "bool") {
+        return bool(r.u8());
+    } else if (type == "type" || type == "GlbC") {
+        r.unicode();
+        return r.id();
+    } else if (type == "tdta" || type == "alis") {
+        const quint32 n = r.u32();
+        r.bytes(int(n));
+        return QVariant();
+    } else if (type == "obj ") {
+        skipReference(r);
+        return QVariant();
+    }
+
+    // an unknown type cannot be skipped: the rest cannot be read
+    r.fail();
+    return QVariant();
+}
+
+qreal number(const QVariantMap &map, const QString &key, qreal defaultValue)
+{
+    const QVariant v = map.value(key);
+    bool ok = false;
+    const qreal result = v.toDouble(&ok);
+    return ok ? result : defaultValue;
+}
+
+bool boolean(const QVariantMap &map, const QString &key, bool defaultValue)
+{
+    return map.contains(key) ? map.value(key).toBool() : defaultValue;
+}
+
+KisAbrPresetImporter::Variation variation(const QVariantMap &brush, const QString &key)
+{
+    KisAbrPresetImporter::Variation result;
+    const QVariantMap v = brush.value(key).toMap();
+    if (v.isEmpty()) return result;
+    result.control = int(number(v, "bVTy", 0));
+    result.fadeSteps = qMax(1, int(number(v, "fStp", 25)));
+    result.jitter = qBound(0.0, number(v, "jitter", 0.0) / 100.0, 1.0);
+    return result;
+}
+
+KisAbrPresetImporter::BrushInfo brushInfo(const QVariantMap &preset)
+{
+    KisAbrPresetImporter::BrushInfo info;
+    info.name = preset.value("Nm  ").toString().trimmed();
+
+    const QVariantMap tip = preset.value("Brsh").toMap();
+    info.computed = tip.value("_class").toString() == "computedBrush";
+    info.sampleUuid = tip.value("sampledData").toString();
+    info.diameter = qMax(1.0, number(tip, "Dmtr", 25.0));
+    info.angle = number(tip, "Angl", 0.0);
+    info.roundness = qBound(0.01, number(tip, "Rndn", 100.0) / 100.0, 1.0);
+    info.hardness = qBound(0.0, number(tip, "Hrdn", 100.0) / 100.0, 1.0);
+    info.spacing = qBound(0.01, number(tip, "Spcn", 25.0) / 100.0, 10.0);
+
+    info.tipDynamics = boolean(preset, "useTipDynamics", false);
+    info.size = variation(preset, "szVr");
+    info.minimumDiameter = qBound(0.0, number(preset, "minimumDiameter", 0.0) / 100.0, 1.0);
+    info.angleVariation = variation(preset, "angleDynamics");
+
+    info.scatterOn = boolean(preset, "useScatter", false);
+    {
+        const QVariantMap v = preset.value("scatterDynamics").toMap();
+        info.scatter.control = int(number(v, "bVTy", 0));
+        info.scatter.fadeSteps = qMax(1, int(number(v, "fStp", 25)));
+        info.scatter.jitter = qBound(0.0, number(v, "jitter", 0.0) / 100.0, 10.0);
+    }
+    info.scatterBothAxes = boolean(preset, "bothAxes", false);
+
+    info.paintDynamics = boolean(preset, "usePaintDynamics", false);
+    info.opacity = variation(preset, "opVr");
+    info.flow = variation(preset, "prVr");
+    return info;
+}
+
+// ---------------------------------------------------------------------------
+// Building Krita's settings
+// ---------------------------------------------------------------------------
+
+QString curveString(qreal y0, qreal y1)
+{
+    return QString("0,%1;1,%2;").arg(qBound(0.0, y0, 1.0)).arg(qBound(0.0, y1, 1.0));
+}
+
+void resetSensors(KisCurveOptionData &data)
+{
+    for (KisSensorData *sensor : data.sensors()) {
+        sensor->isActive = false;
+    }
+    data.useCurve = true;
+    data.useSameCurve = false;
+    data.curveMode = 0; // multiply
+    data.strengthValue = 1.0;
+}
+
+/**
+ * A size-like option (size, opacity, flow): the control scales from
+ * \p minimum (no pressure, start of the fade, ...) to 1, the jitter takes
+ * up to `jitter` off at random
+ */
+void applySizeLike(KisCurveOptionData &data, const KisAbrPresetImporter::Variation &v, qreal minimum)
+{
+    resetSensors(data);
+    KisKritaSensorData &s = data.sensorStruct();
+
+    switch (v.control) {
+    case 1: // fade
+        s.sensorFade.isActive = true;
+        s.sensorFade.length = v.fadeSteps;
+        s.sensorFade.curve = curveString(1.0, minimum);
+        break;
+    case 2: // pen pressure
+        s.sensorPressure.isActive = true;
+        s.sensorPressure.curve = curveString(minimum, 1.0);
+        break;
+    case 3: // pen tilt
+        s.sensorTiltElevation.isActive = true;
+        s.sensorTiltElevation.curve = curveString(minimum, 1.0);
+        break;
+    case 4: // stylus wheel
+        s.sensorTangentialPressure.isActive = true;
+        s.sensorTangentialPressure.curve = curveString(minimum, 1.0);
+        break;
+    default:
+        break;
+    }
+
+    if (v.jitter > 0.0) {
+        s.sensorFuzzyPerDab.isActive = true;
+        s.sensorFuzzyPerDab.curve = curveString(1.0 - v.jitter, 1.0);
+    }
+}
+
+/// rotation: the control turns the tip, the jitter turns it at random by up to +-jitter * 180 degrees
+bool applyRotation(KisCurveOptionData &data, const KisAbrPresetImporter::Variation &v)
+{
+    resetSensors(data);
+    KisKritaSensorData &s = data.sensorStruct();
+    bool any = false;
+
+    switch (v.control) {
+    case 1:
+        s.sensorFade.isActive = true;
+        s.sensorFade.length = v.fadeSteps;
+        any = true;
+        break;
+    case 2:
+        s.sensorPressure.isActive = true;
+        any = true;
+        break;
+    case 3:
+        s.sensorTiltDirection.isActive = true;
+        any = true;
+        break;
+    case 4:
+        s.sensorTangentialPressure.isActive = true;
+        any = true;
+        break;
+    case 5:
+        s.sensorRotation.isActive = true;
+        any = true;
+        break;
+    case 6:
+        s.sensorDrawingAngle.isActive = true;
+        s.sensorDrawingAngle.lockedAngleMode = true;
+        any = true;
+        break;
+    case 7:
+        s.sensorDrawingAngle.isActive = true;
+        any = true;
+        break;
+    default:
+        break;
+    }
+
+    if (v.jitter > 0.0) {
+        // fuzzy is additive: curve value c gives a turn of (2c - 1) * 180 degrees
+        s.sensorFuzzyPerDab.isActive = true;
+        s.sensorFuzzyPerDab.curve = curveString(0.5 - 0.5 * v.jitter, 0.5 + 0.5 * v.jitter);
+        any = true;
+    }
+
+    data.isChecked = any;
+    return any;
+}
+
+QString brushDefinition(KisBrushSP brush)
+{
+    QDomDocument doc;
+    QDomElement element = doc.createElement("Brush");
+    brush->toXML(doc, element);
+    doc.appendChild(element);
+    return doc.toString();
+}
+
+QImage thumbnailFor(KisBrushSP brush)
+{
+    QImage thumbnail(200, 200, QImage::Format_ARGB32);
+    thumbnail.fill(Qt::white);
+
+    QImage tip = brush->image();
+    if (tip.isNull()) tip = brush->brushTipImage();
+    if (tip.isNull()) return thumbnail;
+
+    const QImage scaled = tip.scaled(170, 170, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+    QPainter p(&thumbnail);
+    p.drawImage((thumbnail.width() - scaled.width()) / 2, (thumbnail.height() - scaled.height()) / 2, scaled);
+    return thumbnail;
+}
+
+/// a name for the copy in the resource folder: free, or an earlier copy of the same file
+QString storageNameFor(const QString &fileName, const QByteArray &data, bool *alreadyThere)
+{
+    const QString dir = KoResourcePaths::getAppDataLocation();
+    QString base = QFileInfo(fileName).completeBaseName();
+    if (base.isEmpty()) base = "photoshop-brushes";
+    // Krita names the tips "<base>_<index>": no '_' trouble with the base itself
+    *alreadyThere = false;
+
+    for (int i = 1; i < 1000; i++) {
+        const QString name = i == 1 ? base + ".abr" : QString("%1 (%2).abr").arg(base).arg(i);
+        QFile existing(dir + '/' + name);
+        if (!existing.exists()) return name;
+        if (existing.open(QIODevice::ReadOnly) && existing.size() == data.size() && existing.readAll() == data) {
+            *alreadyThere = true;
+            return name;
+        }
+    }
+    return QString();
+}
+
+KisBrushSP tipByName(KisResourceModel &brushes, const QString &name)
+{
+    const QVector<KoResourceSP> found = brushes.resourcesForName(name);
+    for (const KoResourceSP &resource : found) {
+        KisBrushSP brush = resource.dynamicCast<KisBrush>();
+        if (brush && brush->valid()) {
+            return brush->clone().dynamicCast<KisBrush>();
+        }
+    }
+    return KisBrushSP();
+}
