@@ -0,0 +1,118 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "PhotoshopBrushes.h"
+
+#include <QFile>
+#include <QFileInfo>
+#include <QMessageBox>
+#include <QStandardPaths>
+#include <QUrl>
+
+#include <klocalizedstring.h>
+#include <kpluginfactory.h>
+
+#include <KisViewManager.h>
+#include <KoFileDialog.h>
+#include <kis_action.h>
+#include <KisCursorOverrideLock.h>
+
+#include "KisAbrPresetImporter.h"
+
+K_PLUGIN_FACTORY_WITH_JSON(PhotoshopBrushesFactory, "kritaphotoshopbrushes.json", registerPlugin<PhotoshopBrushes>();)
+
+namespace {
+
+/// the name of the picked file; on Android a content:// URI, the name is its last part
+QString displayFileName(const QString &location)
+{
+    QString name = QFileInfo(location).fileName();
+    if (location.startsWith("content://")) {
+        name = QUrl::fromPercentEncoding(location.toUtf8());
+        name = name.section('/', -1).section(':', -1);
+    }
+    if (!name.endsWith(".abr", Qt::CaseInsensitive)) {
+        name += ".abr";
+    }
+    return name;
+}
+
+} // namespace
+
+PhotoshopBrushes::PhotoshopBrushes(QObject *parent, const QVariantList &)
+    : KisActionPlugin(parent)
+{
+    KisAction *action = createAction("import_photoshop_brushes");
+    connect(action, SIGNAL(triggered()), this, SLOT(slotImport()));
+}
+
+PhotoshopBrushes::~PhotoshopBrushes()
+{
+}
+
+void PhotoshopBrushes::slotImport()
+{
+    QWidget *parent = viewManager()->mainWindowAsQWidget();
+
+    KoFileDialog dialog(parent, KoFileDialog::OpenFiles, "ImportPhotoshopBrushes");
+    dialog.setCaption(i18n("Import Photoshop Brushes"));
+    dialog.setDefaultDir(QStandardPaths::writableLocation(QStandardPaths::DownloadLocation));
+    dialog.setMimeTypeFilters({"image/x-adobe-brushlibrary"});
+
+    const QStringList files = dialog.filenames();
+    if (files.isEmpty()) return;
+
+    QStringList done;
+    QStringList problems;
+
+    for (const QString &location : files) {
+        if (location.isEmpty()) continue;
+        const QString name = displayFileName(location);
+
+        QFile file(location);
+        if (!file.open(QIODevice::ReadOnly)) {
+            problems << i18n("%1: could not open the file.", name);
+            continue;
+        }
+        const QByteArray data = file.readAll();
+        file.close();
+
+        KisAbrPresetImporter::Result result;
+        {
+            KisCursorOverrideLock cursorLock(Qt::BusyCursor);
+            result = KisAbrPresetImporter::importData(name, data);
+        }
+
+        if (result.ok) {
+            done << i18np("%2: 1 brush (tag \"%3\")", "%2: %1 brushes (tag \"%3\")",
+                          result.presets, name, result.tagName);
+        } else {
+            problems << QString("%1: %2").arg(name, result.error);
+        }
+        if (!result.skipped.isEmpty()) {
+            problems << i18n("%1: could not make %2", name, result.skipped.join(", "));
+        }
+    }
+
+    QString message;
+    if (!done.isEmpty()) {
+        message += i18n("Imported:") + "\n" + done.join("\n");
+        message += "\n\n" + i18n("Photoshop's texture, dual brush, color dynamics, count, noise and wet edges "
+                                 "are not part of the imported brushes.");
+    }
+    if (!problems.isEmpty()) {
+        if (!message.isEmpty()) message += "\n\n";
+        message += i18n("Problems:") + "\n" + problems.join("\n");
+    }
+
+    if (problems.isEmpty()) {
+        QMessageBox::information(parent, i18nc("@title:window", "Import Photoshop Brushes"), message);
+    } else {
+        QMessageBox::warning(parent, i18nc("@title:window", "Import Photoshop Brushes"), message);
+    }
+}
+
+#include "PhotoshopBrushes.moc"
