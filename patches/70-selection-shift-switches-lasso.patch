     if(m_dragging && m_closeSnappingActivated) {
         m_points.append(m_points.first());
         endStroke();
+    } else if (m_dragging && m_shiftFreehand) {
+        // Krita Nova: a freehand stretch starts where the pen went down
+        const QPointF p = convertToPixelCoord(event);
+        if (m_points.isEmpty() || KisAlgebra2D::norm(pixelToView(p) - pixelToView(m_points.last())) > 1.0) {
+            m_points.append(p);
+        }
+        m_dragStart = m_dragEnd = p;
+        updateArea();
     } else {
         beginShape();
         m_dragging = true;
     }
 }
 
+void KisToolPolylineBase::continuePrimaryAction(KoPointerEvent *event)
+{
+    CHECK_MODE_SANITY_OR_RETURN(KisTool::PAINT_MODE);
+    if (!m_dragging || !m_shiftFreehand || m_points.isEmpty()) return;
+
+    // Krita Nova: Shift held: dragging draws freehand
+    const QPointF p = convertToPixelCoord(event);
+    if (KisAlgebra2D::norm(pixelToView(p) - pixelToView(m_points.last())) > 1.5) {
+        const QRectF rect = pixelToView(QRectF(m_points.last(), p).normalized());
+        m_points.append(p);
+        m_dragStart = m_dragEnd = p;
+        updateCanvasViewRect(kisGrowRect(rect, PREVIEW_LINE_WIDTH + 2));
+    }
+}
+
+void KisToolPolylineBase::keyPressEvent(QKeyEvent *event)
+{
+    if (m_shiftSwitches && event->key() == Qt::Key_Shift && m_dragging) {
+        m_shiftFreehand = true;
+    }
+    KisToolShape::keyPressEvent(event);
+}
+
+void KisToolPolylineBase::keyReleaseEvent(QKeyEvent *event)
+{
+    if (event->key() == Qt::Key_Shift) {
+        m_shiftFreehand = false;
+    }
+    KisToolShape::keyReleaseEvent(event);
+}
