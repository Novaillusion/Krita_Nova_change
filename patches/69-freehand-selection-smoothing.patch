+void KisToolOutlineBase::setOutlineSmoothing(OutlineSmoothing mode, qreal distance, bool finishLine)
+{
+    m_smoothing = mode;
+    m_smoothingDistance = qMax<qreal>(1.0, distance);
+    m_smoothingFinishLine = finishLine;
+}
+
+void KisToolOutlineBase::resetSmoothing(const QPointF &pixelPos)
+{
+    m_lastRawPixelPos = pixelPos;
+    m_stabilizedViewPos = pixelToView(pixelPos);
+    m_smoothingHistory.clear();
+    m_smoothingHistory.append(m_stabilizedViewPos);
+    m_lastStringRect = QRectF();
+}
+
+QPointF KisToolOutlineBase::smoothedPoint(const QPointF &rawPixelPos)
+{
+    const QPointF raw = pixelToView(rawPixelPos);
+
+    if (m_smoothing == SmoothingStabilizer) {
+        // a string of m_smoothingDistance pulls the line's end behind the cursor
+        const QPointF d = raw - m_stabilizedViewPos;
+        const qreal length = KisAlgebra2D::norm(d);
+        if (length > m_smoothingDistance) {
+            m_stabilizedViewPos += d * ((length - m_smoothingDistance) / length);
+        }
+        return viewToPixel(m_stabilizedViewPos);
+    }
+
+    // weighted: a Gaussian-weighted average of the cursor path within
+    // m_smoothingDistance of the cursor (closer points weigh more)
+    m_smoothingHistory.append(raw);
+    const qreal sigma = qMax<qreal>(1.0, m_smoothingDistance / 3.0);
+    QPointF sum;
+    qreal weights = 0.0;
+    qreal pathLength = 0.0;
+    int oldestUsed = m_smoothingHistory.size() - 1;
+    for (int i = m_smoothingHistory.size() - 1; i >= 0; --i) {
+        if (i < m_smoothingHistory.size() - 1) {
+            pathLength += KisAlgebra2D::norm(m_smoothingHistory[i + 1] - m_smoothingHistory[i]);
+        }
+        if (pathLength > m_smoothingDistance) break;
+        const qreal w = std::exp(-(pathLength * pathLength) / (2.0 * sigma * sigma));
+        sum += m_smoothingHistory[i] * w;
+        weights += w;
+        oldestUsed = i;
+    }
+    if (oldestUsed > 64) {
+        m_smoothingHistory.remove(0, oldestUsed - 1); // keep the history short
+    }
+    return weights > 0.0 ? viewToPixel(sum / weights) : rawPixelPos;
+}
+
+void KisToolOutlineBase::updateStringFeedback()
+{
+    if (m_smoothing != SmoothingStabilizer || m_points.isEmpty()) return;
+    const QRectF rect = kisGrowRect(QRectF(pixelToView(m_points.last()), pixelToView(m_lastRawPixelPos)).normalized(),
+                                    FEEDBACK_LINE_WIDTH + 2);
+    updateCanvasViewRect(m_lastStringRect.isValid() ? rect.united(m_lastStringRect) : rect);
+    m_lastStringRect = rect;
+}
