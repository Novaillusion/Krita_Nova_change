+namespace {
+// Krita Nova: settings of the freehand selection's stroke smoothing
+// (a fixed group: toolId() is not known yet in the constructor)
+KConfigGroup smoothingConfig()
+{
+    return KSharedConfig::openConfig()->group("KisToolSelectOutline");
+}
+}
+
+void KisToolSelectOutline::applySmoothingSettings()
+{
+    const KConfigGroup cfg = smoothingConfig();
+    const int mode = qBound(0, cfg.readEntry("novaSmoothing", 0), 2);
+    setOutlineSmoothing(KisToolOutlineBase::OutlineSmoothing(mode),
+                        cfg.readEntry("novaSmoothingDistance", 50),
+                        cfg.readEntry("novaSmoothingFinishLine", true));
+}
+
+QWidget *KisToolSelectOutline::createOptionWidget()
+{
+    KisToolSelectBase::createOptionWidget();
+    KisSelectionOptions *selectionWidget = selectionOptionWidget();
+
+    // Krita Nova: stroke smoothing, as the freehand brush has
+    const KConfigGroup cfg = smoothingConfig();
+
+    QComboBox *cmbSmoothing = new QComboBox;
+    cmbSmoothing->addItem(i18nc("freehand selection smoothing", "None"));
+    cmbSmoothing->addItem(i18nc("freehand selection smoothing", "Weighted"));
+    cmbSmoothing->addItem(i18nc("freehand selection smoothing", "Stabilizer"));
+    cmbSmoothing->setToolTip(i18n("Smooths the outline while you draw it.\n"
+                                  "Weighted: averages the path of the cursor.\n"
+                                  "Stabilizer: the outline follows the cursor on a string, so wobbles shorter than the string are left out."));
+    cmbSmoothing->setCurrentIndex(qBound(0, cfg.readEntry("novaSmoothing", 0), 2));
+
+    KisSliderSpinBox *sldDistance = new KisSliderSpinBox;
+    sldDistance->setRange(3, 500);
+    sldDistance->setExponentRatio(3.0);
+    KisSpinBoxI18nHelper::setText(sldDistance,
+                                  i18nc("{n} is the number value, px the unit (screen pixels)", "Distance: {n} px"));
+    sldDistance->setToolTip(i18n("How far the smoothing reaches, in screen pixels: the longer, the smoother."));
+    sldDistance->setValue(qBound(3, cfg.readEntry("novaSmoothingDistance", 50), 500));
+
+    QCheckBox *chkFinishLine = new QCheckBox(i18n("Finish line"));
+    chkFinishLine->setToolTip(i18n("When you let go, the outline goes on to where the cursor is."));
+    chkFinishLine->setChecked(cfg.readEntry("novaSmoothingFinishLine", true));
+
+    auto updateEnabled = [sldDistance, chkFinishLine, cmbSmoothing]() {
+        const bool on = cmbSmoothing->currentIndex() != 0;
+        sldDistance->setEnabled(on);
+        chkFinishLine->setEnabled(on);
+    };
+    updateEnabled();
+
+    KisOptionCollectionWidgetWithHeader *section =
+        new KisOptionCollectionWidgetWithHeader(i18nc("section in the freehand selection tool options", "Stroke smoothing"));
+    section->appendWidget("cmbNovaSmoothing", cmbSmoothing);
+    section->appendWidget("sldNovaSmoothingDistance", sldDistance);
+    section->appendWidget("chkNovaSmoothingFinishLine", chkFinishLine);
+    selectionWidget->appendWidget("sectionNovaSmoothing", section);
+
+    connect(cmbSmoothing, QOverload<int>::of(&QComboBox::currentIndexChanged), this, [this, updateEnabled](int index) {
+        smoothingConfig().writeEntry("novaSmoothing", index);
+        updateEnabled();
+        applySmoothingSettings();
+    });
+    connect(sldDistance, QOverload<int>::of(&KisSliderSpinBox::valueChanged), this, [this](int value) {
+        smoothingConfig().writeEntry("novaSmoothingDistance", value);
+        applySmoothingSettings();
+    });
+    connect(chkFinishLine, &QCheckBox::toggled, this, [this](bool on) {
+        smoothingConfig().writeEntry("novaSmoothingFinishLine", on);
+        applySmoothingSettings();
+    });
+
+    return selectionWidget;
+}
 
