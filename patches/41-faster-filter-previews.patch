+
+QRect KisDlgFilter::previewArea() const
+{
+    // Krita Nova: while previewing, filter only what can be seen (plus the
+    // margin of the canvas' region of interest); OK filters everything
+    KisCanvas2 *canvas = d->view->canvasBase();
+    KisImageSP image = d->view->image();
+    if (!canvas || !image) return QRect();
+
+    const QRect roi = canvas->regionOfInterest() & image->bounds();
+    if (roi.isEmpty() || roi == image->bounds()) return QRect();
+
+    // the visible part must be in it (the region of interest is updated late)
+    const QRect visible = canvas->coordinatesConverter()->widgetRectInImagePixels().toAlignedRect() & image->bounds();
+    if (!roi.contains(visible)) return QRect();
+    return roi;
+}
+
+void KisDlgFilter::slotRegionOfInterestChanged()
+{
+    if (!d->uiFilterDialog.checkBoxPreview->isChecked()) return;
+    if (!d->filterManager->isPartialPreview()) return;
+
+    KisCanvas2 *canvas = d->view->canvasBase();
+    KisImageSP image = d->view->image();
+    if (!canvas || !image) return;
+
+    const QRect visible = canvas->coordinatesConverter()->widgetRectInImagePixels().toAlignedRect() & image->bounds();
+    if (!d->previewArea.contains(visible)) {
+        d->updateCompressor.start();
+    }
 }
 
