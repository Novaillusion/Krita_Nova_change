+        const quint8 *src = it.oldRawData();
+        quint8 *dst = it.rawData();
+
+        // works in place too: the pixels at i and after are read before
+        // anything at i or after is written
+        int batchStart = 0;
+        int i = 0;
+        while (i < conseq) {
+            const quint8 *first = src + i * pixelSize;
+            int j = i + 1;
+            while (j < conseq && memcmp(src + j * pixelSize, first, pixelSize) == 0) {
+                ++j;
+            }
+            if (j - i >= minRun) {
+                if (i > batchStart) {
+                    colorTransformation->transform(src + batchStart * pixelSize,
+                                                   dst + batchStart * pixelSize,
+                                                   i - batchStart);
+                }
+                quint8 *firstDst = dst + i * pixelSize;
+                colorTransformation->transform(first, firstDst, 1);
+                for (int k = i + 1; k < j; ++k) {
+                    memcpy(dst + k * pixelSize, firstDst, pixelSize);
+                }
+                batchStart = j;
+            }
+            i = j;
+        }
+        if (conseq > batchStart) {
+            colorTransformation->transform(src + batchStart * pixelSize,
+                                           dst + batchStart * pixelSize,
+                                           conseq - batchStart);
+        }
     }
 
