@@ -0,0 +1,145 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisPresetBundleExporter.h"
+
+#include <QFileInfo>
+#include <QHash>
+#include <QImage>
+#include <QPainter>
+#include <QRegularExpression>
+#include <QSet>
+
+#include <klocalizedstring.h>
+#include <kis_debug.h>
+
+#include <KoResourceBundle.h>
+#include <KoResourceLoadResult.h>
+#include <KisResourceStorage.h>
+#include <KisResourceTypes.h>
+#include <KisGlobalResourcesInterface.h>
+
+namespace {
+
+/// a 3x3 grid of the first presets' thumbnails
+QImage bundleThumbnail(const QVector<KoResourceSP> &presets)
+{
+    QImage thumbnail(256, 256, QImage::Format_ARGB32);
+    thumbnail.fill(Qt::white);
+    QPainter p(&thumbnail);
+    const int cell = 256 / 3;
+    for (int i = 0; i < presets.size() && i < 9; i++) {
+        const QImage image = presets[i]->image();
+        if (image.isNull()) continue;
+        const QImage scaled = image.scaled(cell - 4, cell - 4, Qt::KeepAspectRatio, Qt::SmoothTransformation);
+        const int x = (i % 3) * cell + (cell - scaled.width()) / 2;
+        const int y = (i / 3) * cell + (cell - scaled.height()) / 2;
+        p.drawImage(x, y, scaled);
+    }
+    return thumbnail;
+}
+
+QString safeName(const QString &name)
+{
+    QString result = name.trimmed();
+    result.replace(QRegularExpression("[\\\\/:*?\"<>|]"), "_");
+    return result.isEmpty() ? QStringLiteral("preset") : result;
+}
+
+} // namespace
+
+KisPresetBundleExporter::Result KisPresetBundleExporter::exportBundle(const QVector<KoResourceSP> &presets,
+                                                                       const QString &title,
+                                                                       KisTagSP tag,
+                                                                       const QString &fileName)
+{
+    Result result;
+    if (presets.isEmpty()) {
+        result.error = i18n("There are no brush presets to export.");
+        return result;
+    }
+
+    KoResourceBundle bundle(fileName);
+    bundle.setMetaData(KisResourceStorage::s_meta_title, title);
+    bundle.setMetaData(KisResourceStorage::s_meta_description,
+                       i18np("1 brush preset exported from Nova Krita", "%1 brush presets exported from Nova Krita",
+                             presets.size()));
+    bundle.setMetaData(KisResourceStorage::s_meta_creator, QStringLiteral("Nova Krita"));
+    bundle.setMetaData(KisResourceStorage::s_meta_initial_creator, QStringLiteral("Nova Krita"));
+    bundle.setThumbnail(bundleThumbnail(presets));
+
+    QVector<KisTagSP> presetTags;
+    if (tag && tag->id() >= 0) {
+        presetTags << tag;
+    }
+
+    // file names in the bundle, per resource type
+    QHash<QString, QSet<QString>> usedNames;
+    QSet<int> addedIds;
+
+    // the presets, then what they use (and what that uses)
+    QList<KoResourceSP> queue;
+    Q_FOREACH (const KoResourceSP &preset, presets) queue << preset;
+    const int presetCount = queue.size();
+    int index = 0;
+
+    while (!queue.isEmpty()) {
+        const KoResourceSP resource = queue.takeFirst();
+        const bool isPreset = index++ < presetCount;
+        if (!resource || !resource->valid() || resource->resourceId() < 0) {
+            if (resource && isPreset) result.skipped << resource->name();
+            continue;
+        }
+        if (addedIds.contains(resource->resourceId())) continue;
+
+        const QString type = resource->resourceType().first;
+        QString nameInBundle;
+
+        if (isPreset) {
+            // presets: named after the preset (like Krita's bundle creator does)
+            const QString suffix = QFileInfo(resource->filename()).suffix();
+            const QString stem = safeName(resource->name());
+            nameInBundle = stem + "." + (suffix.isEmpty() ? QStringLiteral("kpp") : suffix);
+            for (int n = 2; usedNames[type].contains(nameInBundle); n++) {
+                nameInBundle = QString("%1 (%2).%3").arg(stem).arg(n).arg(suffix.isEmpty() ? QStringLiteral("kpp") : suffix);
+            }
+        } else {
+            // tips, patterns, ...: their own file name, presets find them by it
+            nameInBundle = resource->filename();
+            if (usedNames[type].contains(nameInBundle)) {
+                warnKrita << "Brush export: two" << type << "resources are called" << nameInBundle << "- only the first goes into the bundle";
+                continue;
+            }
+        }
+
+        usedNames[type].insert(nameInBundle);
+        addedIds.insert(resource->resourceId());
+        bundle.addResource(type, resource->filename(), isPreset ? presetTags : QVector<KisTagSP>(),
+                           resource->md5Sum(), resource->resourceId(), nameInBundle);
+        if (isPreset) result.presets++;
+        else result.otherResources++;
+
+        Q_FOREACH (const KoResourceLoadResult &linked, resource->linkedResources(KisGlobalResourcesInterface::instance())) {
+            const KoResourceSP linkedResource = linked.resource();
+            if (linkedResource && !addedIds.contains(linkedResource->resourceId())) {
+                queue << linkedResource;
+            }
+        }
+    }
+
+    if (result.presets == 0) {
+        result.error = i18n("None of the brush presets could be exported.");
+        return result;
+    }
+
+    if (!bundle.save()) {
+        result.error = i18n("Could not write the bundle.");
+        return result;
+    }
+
+    result.ok = true;
+    return result;
+}
