new file mode 100644
index 0000000..0f366a6
--- /dev/null
+++ b/plugins/extensions/photoshopbrushes/KisPresetBundleExporter.h
@@ -0,0 +1,43 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_PRESET_BUNDLE_EXPORTER_H
+#define KIS_PRESET_BUNDLE_EXPORTER_H
+
+#include <QString>
+#include <QStringList>
+#include <QVector>
+
+#include <KoResource.h>
+#include <KisTag.h>
+
+/**
+ * Krita Nova: saves brush presets as a Krita resource bundle (.bundle), with
+ * everything they use (brush tips, patterns, gradients, ...), so they can be
+ * loaded into any Krita 5+ with Settings > Manage Resource Libraries > Import.
+ * The presets keep the category (tag) they were exported from.
+ */
+class KisPresetBundleExporter
+{
+public:
+    struct Result {
+        bool ok = false;
+        QString error;
+        int presets = 0;
+        int otherResources = 0;
+        QStringList skipped;
+    };
+
+    /**
+     * \p presets: the presets; \p title: the bundle's name; \p tag: the
+     * category to give the presets in the bundle (may be null);
+     * \p fileName: where to write it (a local file)
+     */
+    static Result exportBundle(const QVector<KoResourceSP> &presets, const QString &title,
+                               KisTagSP tag, const QString &fileName);
+};
+
+#endif // KIS_PRESET_BUNDLE_EXPORTER_H
