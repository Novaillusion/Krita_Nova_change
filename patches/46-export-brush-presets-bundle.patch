+void PhotoshopBrushes::slotExport()
+{
+    QWidget *parent = viewManager()->mainWindowAsQWidget();
+    const QString caption = i18nc("@title:window", "Export Brush Presets");
+
+    // the preset chooser whose button was pressed (else a visible one)
+    KisPresetChooser *chooser = qobject_cast<KisPresetChooser *>(m_exportAction->property("_kritanova_chooser").value<QObject *>());
+    m_exportAction->setProperty("_kritanova_chooser", QVariant());
+    if (!chooser) {
+        Q_FOREACH (QWidget *widget, QApplication::allWidgets()) {
+            KisPresetChooser *candidate = qobject_cast<KisPresetChooser *>(widget);
+            if (candidate && candidate->isVisible()) {
+                chooser = candidate;
+                break;
+            }
+        }
+    }
+    if (!chooser || !chooser->itemChooser() || !chooser->itemChooser()->tagFilterModel()) {
+        QMessageBox::warning(parent, caption, i18n("Open the brush presets to choose which brushes to export."));
+        return;
+    }
+
+    // what the chooser shows: the chosen category (and search)
+    KisTagFilterResourceProxyModel *model = chooser->itemChooser()->tagFilterModel();
+    QVector<KoResourceSP> presets;
+    for (int row = 0; row < model->rowCount(); row++) {
+        KoResourceSP resource = model->resourceForIndex(model->index(row, 0));
+        if (resource) presets << resource;
+    }
+
+    KisTagSP tag;
+    QString title;
+    if (KisTagChooserWidget *tags = chooser->findChild<KisTagChooserWidget *>()) {
+        tag = tags->currentlySelectedTag();
+        if (tag) title = tag->name();
+    }
+    if (title.isEmpty()) title = i18n("Brushes");
+
+    if (presets.isEmpty()) {
+        QMessageBox::warning(parent, caption, i18n("The category \"%1\" has no brush presets.", title));
+        return;
+    }
+
+    KoFileDialog dialog(parent, KoFileDialog::SaveFile, "ExportBrushPresets");
+    dialog.setCaption(caption);
+    dialog.setDefaultDir(QStandardPaths::writableLocation(QStandardPaths::DocumentsLocation) + "/" +
+                         QString(title).replace(QRegularExpression("[\\\\/:*?\"<>|]"), "_") + ".bundle");
+    dialog.setMimeTypeFilters({"application/x-krita-bundle"});
+    QString location = dialog.filename();
+    if (location.isEmpty()) return;
+    if (!location.startsWith("content://") && !location.endsWith(".bundle", Qt::CaseInsensitive)) {
+        location += ".bundle";
+    }
+
+    // written to a temporary file first: the destination can be a content://
+    // URI (Android), which the bundle writer cannot open itself
+    QTemporaryDir tempDir;
+    const QString tempFile = tempDir.path() + "/export.bundle";
+
+    KisPresetBundleExporter::Result result;
+    {
+        KisCursorOverrideLock cursorLock(Qt::BusyCursor);
+        result = tempDir.isValid() ? KisPresetBundleExporter::exportBundle(presets, title, tag, tempFile)
+                                   : KisPresetBundleExporter::Result();
+    }
+    if (!tempDir.isValid()) {
+        result.error = i18n("Could not make a temporary file.");
+    }
+
+    if (result.ok) {
+        QFile source(tempFile);
+        QFile target(location);
+        if (!source.open(QIODevice::ReadOnly) || !target.open(QIODevice::WriteOnly | QIODevice::Truncate)
+                || target.write(source.readAll()) != source.size()) {
+            result.ok = false;
+            result.error = i18n("Could not write %1.", location);
+        }
+    }
+
+    if (!result.ok) {
+        QMessageBox::warning(parent, caption, result.error);
+        return;
+    }
+
+    QString message = i18np("Exported 1 brush preset", "Exported %1 brush presets", result.presets);
+    if (result.otherResources > 0) {
+        message += " " + i18np("and 1 brush tip or other resource it uses", "and %1 brush tips and other resources they use",
+                               result.otherResources);
+    }
+    message += ".\n\n" + i18n("Load the bundle into Krita with Settings > Manage Resource Libraries > Import. "
+                                "The brushes then appear in the category \"%1\".", title);
+    if (!result.skipped.isEmpty()) {
+        message += "\n\n" + i18n("Not exported: %1", result.skipped.join(", "));
+    }
+    QMessageBox::information(parent, caption, message);
+}
+
