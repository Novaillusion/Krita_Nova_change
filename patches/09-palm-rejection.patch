@@ -0,0 +1,134 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisPalmRejection.h"
+
+#include <QCoreApplication>
+#include <QGuiApplication>
+#include <QScreen>
+#include <QTouchEvent>
+#include <QWidget>
+#include <QWindow>
+
+#include <kis_config.h>
+#include <kis_config_notifier.h>
+#include <kis_debug.h>
+
+namespace {
+// Even with a proximity flag set, stop rejecting when the pen has been silent
+// this long: some drivers never send "leave proximity".
+constexpr qint64 PROXIMITY_TIMEOUT_MS = 5000;
+}
+
+KisPalmRejection *KisPalmRejection::instance()
+{
+    static KisPalmRejection *s_instance = new KisPalmRejection();
+    return s_instance;
+}
+
+KisPalmRejection::KisPalmRejection()
+    : QObject(qApp)
+{
+    reloadConfig();
+    if (qApp) {
+        qApp->installEventFilter(this);
+    }
+    connect(KisConfigNotifier::instance(), &KisConfigNotifier::configChanged,
+            this, &KisPalmRejection::reloadConfig);
+}
+
+void KisPalmRejection::reloadConfig()
+{
+    KisConfig cfg(true);
+    m_enabled = cfg.readEntry("palmRejectionEnabled", true);
+    m_graceMs = qBound(0, cfg.readEntry("palmRejectionDelay", 500), 5000);
+    m_checkContactSize = cfg.readEntry("palmRejectionLargeContacts", true);
+    m_maxContactMm = qBound(5, cfg.readEntry("palmRejectionMaxContactMm", 18), 100);
+}
+
+bool KisPalmRejection::eventFilter(QObject *watched, QEvent *event)
+{
+    switch (event->type()) {
+    case QEvent::TabletPress:
+        m_penDown = true;
+        m_penInProximity = true;
+        m_lastPenEvent.start();
+        break;
+    case QEvent::TabletRelease:
+        m_penDown = false;
+        m_lastPenEvent.start();
+        break;
+    case QEvent::TabletMove:
+        // includes hover moves on platforms that report them
+        m_penInProximity = true;
+        m_lastPenEvent.start();
+        break;
+    case QEvent::TabletEnterProximity:
+        m_penInProximity = true;
+        m_lastPenEvent.start();
+        break;
+    case QEvent::TabletLeaveProximity:
+        m_penInProximity = false;
+        m_penDown = false;
+        m_lastPenEvent.start();
+        break;
+    default:
+        break;
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+bool KisPalmRejection::isPenActive() const
+{
+    if (!m_lastPenEvent.isValid()) return false;
+
+    const qint64 elapsed = m_lastPenEvent.elapsed();
+    if (m_penDown) return elapsed < PROXIMITY_TIMEOUT_MS * 6; // a long, still press
+    if (m_penInProximity && elapsed < PROXIMITY_TIMEOUT_MS) return true;
+    return elapsed < m_graceMs;
+}
+
+qreal KisPalmRejection::contactSizeMm(qreal diameterPx, qreal physicalDpi)
+{
+    if (diameterPx <= 0.0 || physicalDpi <= 0.0) return 0.0;
+    return diameterPx / physicalDpi * 25.4;
+}
+
+bool KisPalmRejection::hasPalmSizedContact(const QTouchEvent *event, const QWidget *widget) const
+{
+    if (!m_enabled || !m_checkContactSize || !event) return false;
+
+    const QScreen *screen = nullptr;
+    if (widget && widget->window() && widget->window()->windowHandle()) {
+        screen = widget->window()->windowHandle()->screen();
+    }
+    if (!screen) screen = QGuiApplication::primaryScreen();
+    if (!screen) return false;
+
+    const qreal dpi = screen->physicalDotsPerInch();
+
+    Q_FOREACH (const QTouchEvent::TouchPoint &point, event->touchPoints()) {
+        if (point.state() == Qt::TouchPointReleased) continue;
+        const QSizeF d = point.ellipseDiameters();
+        const qreal sizeMm = contactSizeMm(qMax(d.width(), d.height()), dpi);
+        if (sizeMm > m_maxContactMm) {
+            dbgInputMatcher << "Palm rejection: contact of" << sizeMm << "mm";
+            return true;
+        }
+    }
+    return false;
+}
+
+bool KisPalmRejection::shouldRejectTouchBegin(const QTouchEvent *event, const QWidget *widget)
+{
+    if (!m_enabled) return false;
+
+    if (isPenActive()) {
+        dbgInputMatcher << "Palm rejection: touch ignored, the pen is in use";
+        return true;
+    }
+    return hasPalmSizedContact(event, widget);
+}
