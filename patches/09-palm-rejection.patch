+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_PALM_REJECTION_H
+#define KIS_PALM_REJECTION_H
+
+#include <QObject>
+#include <QElapsedTimer>
+
+#include "kritaui_export.h"
+
+class QTouchEvent;
+class QWidget;
+
+/**
+ * Palm rejection for the canvas.
+ *
+ * Watches every tablet (pen) event the application receives, and tells the
+ * canvas input manager to ignore touch input that is most likely a resting
+ * hand:
+ *
+ *  - while the pen is touching the screen, hovering over it (in proximity),
+ *    or was used less than "palmRejectionDelay" ms ago;
+ *  - touches whose contact area is larger than "palmRejectionMaxContactMm"
+ *    millimetres (only on screens that report the contact size).
+ *
+ * A touch sequence is either rejected as a whole or not at all, so the
+ * shortcut matcher always sees balanced begin/end events.
+ *
+ * Settings (kritarc, edited in Configure Krita > General > Tools):
+ *   palmRejectionEnabled       bool, default true
+ *   palmRejectionDelay         int ms, default 500
+ *   palmRejectionLargeContacts bool, default true
+ *   palmRejectionMaxContactMm  int mm, default 18
+ */
+class KRITAUI_EXPORT KisPalmRejection : public QObject
+{
+    Q_OBJECT
+public:
+    static KisPalmRejection *instance();
+
+    /// true when a touch sequence starting with this event must be ignored
+    bool shouldRejectTouchBegin(const QTouchEvent *event, const QWidget *widget);
+
+    /// true when a touch update contains a contact that looks like a palm
+    bool hasPalmSizedContact(const QTouchEvent *event, const QWidget *widget) const;
+
+    /// pen is down, in proximity, or was used within the grace period
+    bool isPenActive() const;
+
+    void reloadConfig();
+
+    bool isEnabled() const { return m_enabled; }
+
+    // exposed for tests
+    static qreal contactSizeMm(qreal diameterPx, qreal physicalDpi);
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    KisPalmRejection();
+
+    bool m_enabled {true};
+    int m_graceMs {500};
+    bool m_checkContactSize {true};
+    int m_maxContactMm {18};
+
+    bool m_penDown {false};
+    bool m_penInProximity {false};
+    QElapsedTimer m_lastPenEvent;
+};
+
+#endif // KIS_PALM_REJECTION_H
