+void GeneralTab::setupPalmRejectionSettings(KisConfig &cfg)
+{
+
+    m_chkPalmRejection = new QCheckBox(i18n("Palm rejection: ignore touch on the canvas while the pen is in use"), this);
+    m_chkPalmRejection->setToolTip(i18n("Touches on the canvas are ignored while the pen is touching or hovering over the screen, and for a short time after it was used, so a resting hand neither paints nor moves the canvas."));
+    m_chkPalmRejection->setChecked(cfg.readEntry("palmRejectionEnabled", true));
+
+    m_spnPalmRejectionDelay = new QSpinBox(this);
+    m_spnPalmRejectionDelay->setRange(0, 5000);
+    m_spnPalmRejectionDelay->setSingleStep(100);
+    m_spnPalmRejectionDelay->setSuffix(i18n(" ms"));
+    m_spnPalmRejectionDelay->setToolTip(i18n("How long touch stays ignored after the pen was last used"));
+    m_spnPalmRejectionDelay->setValue(cfg.readEntry("palmRejectionDelay", 500));
+
+    m_chkPalmLargeContacts = new QCheckBox(i18n("Also ignore touches larger than"), this);
+    m_chkPalmLargeContacts->setToolTip(i18n("Ignore contacts bigger than a fingertip. Works only on screens that report the size of a touch."));
+    m_chkPalmLargeContacts->setChecked(cfg.readEntry("palmRejectionLargeContacts", true));
+
+    m_spnPalmMaxContactMm = new QSpinBox(this);
+    m_spnPalmMaxContactMm->setRange(5, 100);
+    m_spnPalmMaxContactMm->setSuffix(i18n(" mm"));
+    m_spnPalmMaxContactMm->setValue(cfg.readEntry("palmRejectionMaxContactMm", 18));
+
+    QWidget *sizeRow = new QWidget(this);
+    QHBoxLayout *sizeLayout = new QHBoxLayout(sizeRow);
+    sizeLayout->setContentsMargins(0, 0, 0, 0);
+    sizeLayout->addWidget(m_chkPalmLargeContacts);
+    sizeLayout->addWidget(m_spnPalmMaxContactMm);
+    sizeLayout->addStretch();
+
+    QWidget *delayRow = new QWidget(this);
+    QHBoxLayout *delayLayout = new QHBoxLayout(delayRow);
+    delayLayout->setContentsMargins(0, 0, 0, 0);
+    delayLayout->addWidget(new QLabel(i18n("Keep ignoring touch after the pen for"), delayRow));
+    delayLayout->addWidget(m_spnPalmRejectionDelay);
+    delayLayout->addStretch();
+
+    // put the rows right below "Enable Touch Pressure Sensitivity"
+    QFormLayout *form = qobject_cast<QFormLayout *>(chkTouchPressureSensitivity->parentWidget()->layout());
+    int row = -1;
+    QFormLayout::ItemRole role;
+    if (form) {
+        form->getWidgetPosition(chkTouchPressureSensitivity, &row, &role);
+    }
+    if (form && row >= 0) {
+        form->insertRow(row + 1, QString(), m_chkPalmRejection);
+        form->insertRow(row + 2, QString(), delayRow);
+        form->insertRow(row + 3, QString(), sizeRow);
+    } else if (QLayout *layout = chkTouchPressureSensitivity->parentWidget()->layout()) {
+        layout->addWidget(m_chkPalmRejection);
+        layout->addWidget(delayRow);
+        layout->addWidget(sizeRow);
+    }
+
+    connect(m_chkPalmRejection, &QCheckBox::toggled, this, [this]() { updatePalmRejectionEnabled(); });
+    connect(m_chkPalmLargeContacts, &QCheckBox::toggled, this, [this]() { updatePalmRejectionEnabled(); });
+    updatePalmRejectionEnabled();
+}
+
+void GeneralTab::updatePalmRejectionEnabled()
+{
+    const bool on = m_chkPalmRejection->isChecked();
+    m_spnPalmRejectionDelay->setEnabled(on);
+    m_chkPalmLargeContacts->setEnabled(on);
+    m_spnPalmMaxContactMm->setEnabled(on && m_chkPalmLargeContacts->isChecked());
+}
+
+void GeneralTab::savePalmRejectionSettings(KisConfig &cfg)
+{
+    cfg.writeEntry("palmRejectionEnabled", m_chkPalmRejection->isChecked());
+    cfg.writeEntry("palmRejectionDelay", m_spnPalmRejectionDelay->value());
+    cfg.writeEntry("palmRejectionLargeContacts", m_chkPalmLargeContacts->isChecked());
+    cfg.writeEntry("palmRejectionMaxContactMm", m_spnPalmMaxContactMm->value());
+}
