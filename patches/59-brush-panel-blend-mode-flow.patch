+/**
+ * Krita Nova (patch 59): the Brush Panel's blending mode button. The brush
+ * toolbar's own blending mode combo box is moved here (out of the "more"
+ * popup) and covered by a box showing the first two letters of the mode
+ * ("Normal" -> "No"). Touches go through the box to the combo box, so
+ * tapping it opens the same blending mode list as before.
+ */
+class NovaBlendModeButton : public QWidget
+{
+public:
+    NovaBlendModeButton(KisViewManager *viewManager, QWidget *parent)
+        : QWidget(parent), m_viewManager(viewManager)
+    {
+        setObjectName(QStringLiteral("KritaNovaBlendModeButton"));
+        setFixedSize(36, 36);
+        setToolTip(i18n("Blending Mode"));
+        m_cover = new Cover(this);
+        m_cover->setGeometry(rect());
+        m_cover->setAttribute(Qt::WA_TransparentForMouseEvents, true);
+        // the combo box exists once the brush toolbar is made, and it may be
+        // set with signals blocked (preset changes): look for it / follow it
+        m_poll.setInterval(200);
+        connect(&m_poll, &QTimer::timeout, this, [this]() { attach(); updateText(); });
+        m_poll.start();
+        attach();
+    }
+
+private:
+    class Cover : public QWidget
+    {
+    public:
+        explicit Cover(QWidget *parent) : QWidget(parent) {}
+        QString text;
+    protected:
+        void paintEvent(QPaintEvent *) override
+        {
+            QPainter p(this);
+            paintNovaLetterBox(p, this, text, false); // same look as the O / F switch
+        }
+    };
+
+    void attach()
+    {
+        if (m_combo) return;
+        if (!m_viewManager || !m_viewManager->actionCollection()) return;
+        QWidgetAction *action = qobject_cast<QWidgetAction *>(
+            m_viewManager->actionCollection()->action(QStringLiteral("composite_actions")));
+        QWidget *compositeActions = action ? action->defaultWidget() : nullptr;
+        KisCompositeOpComboBox *combo = compositeActions ? compositeActions->findChild<KisCompositeOpComboBox *>() : nullptr;
+        if (!combo) return;
+        m_combo = combo;
+        if (QLayout *oldLayout = compositeActions->layout()) oldLayout->removeWidget(combo);
+        combo->setParent(this);
+        combo->setMinimumSize(0, 0);
+        combo->setMaximumSize(QWIDGETSIZE_MAX, QWIDGETSIZE_MAX);
+        // inside the label box only: at the full size its frame and text
+        // showed around the box's rounded corners
+        combo->setGeometry(rect().adjusted(4, 4, -4, -4));
+        // the list keeps a readable width although the button is small
+        if (combo->view()) combo->view()->setMinimumWidth(qMax(combo->view()->minimumWidth(), 220));
+        combo->show();
+        m_cover->raise();
+        connect(combo, QOverload<int>::of(&QComboBox::currentIndexChanged), this, [this]() { updateText(); });
+        updateText();
+    }
+
+    void updateText()
+    {
+        if (!m_combo) return;
+        const QString name = m_combo->currentText().trimmed();
+        const QString letters = shortName(m_combo->selectedCompositeOp().id(), name);
+        if (letters != m_cover->text) {
+            m_cover->text = letters;
+            m_cover->update();
+        }
+        const QString tip = i18n("Blending Mode: %1", name);
+        if (toolTip() != tip) setToolTip(tip);
+        if (m_cover->isEnabled() != m_combo->isEnabled()) m_cover->setEnabled(m_combo->isEnabled());
+    }
+
+    /// Two letters for the button: the common painting modes have their own
+    /// (so e.g. Color Dodge "CD" and Color "Co" differ), all others show the
+    /// first two letters of their name
+    static QString shortName(const QString &id, const QString &name)
+    {
+        static const QHash<QString, QString> codes = {
+            {COMPOSITE_OVER, QStringLiteral("No")},
+            {COMPOSITE_ERASE, QStringLiteral("Er")},
+            {COMPOSITE_BEHIND, QStringLiteral("Be")},
+            {COMPOSITE_ALPHA_DARKEN, QStringLiteral("AD")},
+            // arithmetic
+            {COMPOSITE_ADD, QStringLiteral("Ad")},
+            {COMPOSITE_SUBTRACT, QStringLiteral("Su")},
+            {COMPOSITE_MULT, QStringLiteral("Mu")},
+            {COMPOSITE_DIVIDE, QStringLiteral("Dv")},
+            // darken
+            {COMPOSITE_DARKEN, QStringLiteral("Da")},
+            {COMPOSITE_DARKER_COLOR, QStringLiteral("DC")},
+            {COMPOSITE_BURN, QStringLiteral("Bu")},
+            {COMPOSITE_LINEAR_BURN, QStringLiteral("LB")},
+            {COMPOSITE_EASY_BURN, QStringLiteral("EB")},
+            // lighten
+            {COMPOSITE_LIGHTEN, QStringLiteral("Li")},
+            {COMPOSITE_LIGHTER_COLOR, QStringLiteral("LC")},
+            {COMPOSITE_SCREEN, QStringLiteral("Sc")},
+            {COMPOSITE_DODGE, QStringLiteral("CD")},
+            {COMPOSITE_LINEAR_DODGE, QStringLiteral("LD")},
+            {COMPOSITE_EASY_DODGE, QStringLiteral("ED")},
+            {COMPOSITE_LINEAR_LIGHT, QStringLiteral("LL")},
+            {COMPOSITE_VIVID_LIGHT, QStringLiteral("VL")},
+            {COMPOSITE_PIN_LIGHT, QStringLiteral("PL")},
+            {COMPOSITE_HARD_LIGHT, QStringLiteral("HL")},
+            {COMPOSITE_SOFT_LIGHT_PHOTOSHOP, QStringLiteral("SL")},
+            {COMPOSITE_SOFT_LIGHT_SVG, QStringLiteral("SS")},
+            {COMPOSITE_LUMINOSITY_SAI, QStringLiteral("LS")},
+            // mix
+            {COMPOSITE_OVERLAY, QStringLiteral("Ov")},
+            {COMPOSITE_HARD_OVERLAY, QStringLiteral("HO")},
+            {COMPOSITE_HARD_MIX, QStringLiteral("HM")},
+            {COMPOSITE_HARD_MIX_PHOTOSHOP, QStringLiteral("HP")},
+            {COMPOSITE_GRAIN_MERGE, QStringLiteral("GM")},
+            {COMPOSITE_GRAIN_EXTRACT, QStringLiteral("GE")},
+            {COMPOSITE_GREATER, QStringLiteral("Gr")},
+            // negative
+            {COMPOSITE_DIFF, QStringLiteral("Di")},
+            {COMPOSITE_EXCLUSION, QStringLiteral("Ex")},
+            // misc
+            {COMPOSITE_DISSOLVE, QStringLiteral("Ds")},
+            {COMPOSITE_COPY, QStringLiteral("Cp")},
+            {COMPOSITE_BUMPMAP, QStringLiteral("Bm")},
+            // HSY (the HSL / HSI / HSV variants keep their first letters)
+            {COMPOSITE_COLOR, QStringLiteral("Co")},
+            {COMPOSITE_HUE, QStringLiteral("Hu")},
+            {COMPOSITE_SATURATION, QStringLiteral("Sa")},
+            {COMPOSITE_LUMINIZE, QStringLiteral("Lu")},
+        };
+        const QString code = codes.value(id);
+        return code.isEmpty() ? name.left(2) : code;
+    }
+
+    QPointer<KisViewManager> m_viewManager;
+    QPointer<KisCompositeOpComboBox> m_combo;
+    Cover *m_cover {nullptr};
+    QTimer m_poll;
+};
