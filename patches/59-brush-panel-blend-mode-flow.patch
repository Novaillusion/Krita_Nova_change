+/// Krita Nova (patch 59): the look shared by the Brush Panel's letter
+/// buttons (blending mode "No", Opacity / Flow "O" / "F"): a rounded box with
+/// a thin outline and bold letters
+void paintNovaLetterBox(QPainter &p, const QWidget *w, const QString &text, bool pressed)
+{
+    p.setRenderHint(QPainter::Antialiasing, true);
+    const QRectF box = QRectF(w->rect()).adjusted(2.5, 2.5, -2.5, -2.5);
+    p.setPen(QPen(w->palette().color(QPalette::WindowText), 1.2));
+    p.setBrush(pressed ? w->palette().color(QPalette::Highlight) : w->palette().color(QPalette::Window));
+    p.drawRoundedRect(box, 4, 4);
+    QFont f = QApplication::font();
+    f.setBold(true);
+    p.setFont(f);
+    p.setPen(!w->isEnabled() ? w->palette().color(QPalette::Mid)
+             : pressed ? w->palette().color(QPalette::HighlightedText)
+                       : w->palette().color(QPalette::WindowText));
+    p.drawText(box, Qt::AlignCenter, text);
+}
+
+/// A Brush Panel letter button (see paintNovaLetterBox)
+class NovaLetterButton : public QAbstractButton
+{
+public:
+    explicit NovaLetterButton(QWidget *parent) : QAbstractButton(parent) { setFixedSize(36, 36); }
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        paintNovaLetterBox(p, this, text(), isDown());
+    }
+};
