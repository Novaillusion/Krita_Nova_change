+/// Image size, canvas rotation and zoom from the status bar (KisStatusBar parks
+/// them in the "KritaNovaStatusItems" widget on Android), at the right end of the
+/// top bar. The widget only exists once the status bar has been set up, which
+/// can be after the toolbars were arranged, so this is tried again whenever the
+/// Brush Panel is placed (patch 33); it does nothing once they are there.
+void ensureStatusItemsInTopBar(QMainWindow *mainWindow)
+{
+    if (!mainWindow) return;
+    QWidget *statusItems = mainWindow->findChild<QWidget *>(QStringLiteral("KritaNovaStatusItems"));
+    KisToolBar *topBar = mainWindow->findChild<KisToolBar *>(QStringLiteral("mainToolBar"));
+    if (!statusItems || !topBar) return;
+    if (statusItems->parentWidget() != topBar) {
+        QWidget *spacer = new QWidget(topBar);
+        spacer->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
+        topBar->addWidget(spacer);
+        topBar->addWidget(statusItems);
+    }
+    if (!statusItems->isVisible()) statusItems->show();
+}
