     if (startStrokeImpl(mode, &pos)) {
         setMode(KisTool::PAINT_MODE);
 
@@ -843,6 +852,30 @@ void KisToolMove::cancelStroke()
     qobject_cast<KisCanvas2*>(canvas())->updateCanvas();
 }
 
+bool KisToolMove::novaSelectLayerUnder(const QPoint &pos)
+{
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(canvas());
+    if (!kisCanvas || !kisCanvas->viewManager() || !kisCanvas->viewManager()->nodeManager()) return false;
+    KisImageSP image = this->image();
+    if (!image) return false;
+
+    // with an active selection the move works on the selected pixels of the
+    // current layer: keep that layer
+    KisSelectionSP selection = kisCanvas->viewManager()->selection();
+    if (selection && !selection->selectedExactRect().isEmpty()) return false;
+
+    const KisNodeList selected = this->selectedNodes();
+    KisNodeSP root = selected.isEmpty() ? KisNodeSP() : KisLayerUtils::findIsolationRoot(selected.first());
+    if (!root) root = image->root();
+
+    KisNodeSP node = KisToolUtils::findNode(root, pos, false);
+    if (!node) return false;
+    if (selected.size() == 1 && selected.first() == node) return false; // already active
+
+    kisCanvas->viewManager()->nodeManager()->slotImageRequestNodeReselection(node, {node});
+    return true;
+}
