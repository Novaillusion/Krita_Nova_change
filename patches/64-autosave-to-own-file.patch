+    m_grpAutoSaveToFile = new QGroupBox(i18n("Save Documents to Their Own Files Automatically"), this);
+    m_grpAutoSaveToFile->setCheckable(true);
+    m_grpAutoSaveToFile->setToolTip(i18n("Every few minutes, open documents with unsaved changes are saved over their own files, "
+                                         "as with File > Save. The backup autosave above is separate and keeps working."));
+    m_spnAutoSaveToFileInterval = new QSpinBox(m_grpAutoSaveToFile);
+    m_spnAutoSaveToFileInterval->setRange(1, 240);
+    m_spnAutoSaveToFileInterval->setSuffix(i18nc("unit of the autosave interval", " min"));
+    QLabel *autoSaveToFileNote = new QLabel(
+        i18n("Only images that already have a file in a format that keeps layers (.kra, .psd, .ora) are saved. "
+             "New, unsaved images and other formats are left to the backup autosave. "
+             "Saving waits until the image is not busy."), m_grpAutoSaveToFile);
+    autoSaveToFileNote->setWordWrap(true);
+    QFormLayout *autoSaveToFileForm = new QFormLayout(m_grpAutoSaveToFile);
+    autoSaveToFileForm->addRow(i18n("Save every:"), m_spnAutoSaveToFileInterval);
+    autoSaveToFileForm->addRow(autoSaveToFileNote);
+    m_grpAutoSaveToFile->setChecked(cfg.readEntry("novaAutoSaveToFile", false));
+    m_spnAutoSaveToFileInterval->setValue(cfg.readEntry("novaAutoSaveToFileInterval", 10));
+
+    QFormLayout *fileForm = qobject_cast<QFormLayout *>(m_autosaveCheckBox->parentWidget()->layout());
+    int fileRow = -1;
+    QFormLayout::ItemRole fileRole;
+    if (fileForm) {
+        fileForm->getWidgetPosition(m_autosaveCheckBox, &fileRow, &fileRole);
+    }
+    if (fileForm && fileRow >= 0) {
+        fileForm->insertRow(fileRow + 1, m_grpAutoSaveToFile);
+    } else if (QBoxLayout *box = qobject_cast<QBoxLayout *>(m_autosaveCheckBox->parentWidget()->layout())) {
+        const int index = box->indexOf(m_autosaveCheckBox);
+        box->insertWidget(index >= 0 ? index + 1 : box->count(), m_grpAutoSaveToFile);
+    } else if (QLayout *layout = m_autosaveCheckBox->parentWidget()->layout()) {
+        layout->addWidget(m_grpAutoSaveToFile);
+    }
 }
 
