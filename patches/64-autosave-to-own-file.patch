+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "KisNovaFileAutoSaver.h"
+
+#include <QByteArray>
+
+#include <klocalizedstring.h>
+
+#include "KisDocument.h"
+#include "KisPart.h"
+#include "KisUsageLogger.h"
+#include "kis_config.h"
+#include "kis_config_notifier.h"
+#include "kis_image.h"
+#include "kis_properties_configuration.h"
+
+namespace {
+constexpr int RETRY_MS = 30 * 1000;
+}
+
+KisNovaFileAutoSaver::KisNovaFileAutoSaver(QObject *parent)
+    : QObject(parent)
+{
+    m_timer.setTimerType(Qt::VeryCoarseTimer);
+    connect(&m_timer, SIGNAL(timeout()), SLOT(slotSaveDocuments()));
+    m_retryTimer.setSingleShot(true);
+    m_retryTimer.setInterval(RETRY_MS);
+    connect(&m_retryTimer, SIGNAL(timeout()), SLOT(slotSaveDocuments()));
+    connect(KisConfigNotifier::instance(), SIGNAL(configChanged()), SLOT(slotConfigChanged()));
+    slotConfigChanged();
+}
+
+void KisNovaFileAutoSaver::slotConfigChanged()
+{
+    KisConfig cfg(true);
+    m_enabled = cfg.readEntry("novaAutoSaveToFile", false);
+    const int minutes = qBound(1, cfg.readEntry("novaAutoSaveToFileInterval", 10), 240);
+    if (!m_enabled) {
+        m_timer.stop();
+        m_retryTimer.stop();
+        return;
+    }
+    const int interval = minutes * 60 * 1000;
+    if (!m_timer.isActive() || m_timer.interval() != interval) {
+        m_timer.start(interval);
+    }
+}
+
+bool KisNovaFileAutoSaver::canSave(KisDocument *document)
+{
+    if (!document || !document->isModified() || !document->isReadWrite()) return false;
+    if (document->path().isEmpty() || document->isRecovered()) return false;
+    const QByteArray mime = document->mimeType();
+    // formats that keep the layers: no silent flattening of the user's file
+    return mime == KisDocument::nativeFormatMimeType()
+        || mime == "image/vnd.adobe.photoshop"
+        || mime == "image/openraster";
+}
+
+void KisNovaFileAutoSaver::slotSaveDocuments()
+{
+    if (!m_enabled) return;
+    bool postponed = false;
+
+    Q_FOREACH (QPointer<KisDocument> document, KisPart::instance()->documents()) {
+        if (!document || !canSave(document)) continue;
+        if (document->isSaving() || !document->image() || !document->image()->isIdle()) {
+            postponed = true; // busy (painting, a filter, a save): a little later
+            continue;
+        }
+
+        KisUsageLogger::log(QString("Krita Nova autosave to the document's own file: %1").arg(document->path()));
+        // no dialogs: the last export settings of the format are used
+        const bool wasBatch = document->fileBatchMode();
+        document->setFileBatchMode(true);
+        const bool started = document->save(false, KisPropertiesConfigurationSP());
+        if (!document->isSaving()) {
+            document->setFileBatchMode(wasBatch);
+        } else {
+            // a background save: give the batch mode back once it is done
+            QPointer<KisDocument> doc = document;
+            QTimer *waiter = new QTimer(this);
+            waiter->setInterval(500);
+            connect(waiter, &QTimer::timeout, this, [doc, wasBatch, waiter]() {
+                if (doc && doc->isSaving()) return;
+                if (doc) doc->setFileBatchMode(wasBatch);
+                waiter->stop();
+                waiter->deleteLater();
+            });
+            waiter->start();
+        }
+        if (!started) postponed = true;
+    }
+
+    if (postponed && !m_retryTimer.isActive()) m_retryTimer.start();
+}
diff --git a/libs/ui/KisNovaFileAutoSaver.h b/libs/ui/KisNovaFileAutoSaver.h
new file mode 100644
index 0000000..f71d10a
--- /dev/null
+++ b/libs/ui/KisNovaFileAutoSaver.h
@@ -0,0 +1,46 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef KIS_NOVA_FILE_AUTO_SAVER_H
+#define KIS_NOVA_FILE_AUTO_SAVER_H
+
+#include <QObject>
+#include <QPointer>
+#include <QTimer>
+
+class KisDocument;
+
+/**
+ * Krita Nova: saves open documents to their own files every few minutes
+ * (Settings > Configure Krita > General > File Handling, "Save Documents to
+ * Their Own Files Automatically"; kritarc novaAutoSaveToFile and
+ * novaAutoSaveToFileInterval, in minutes).
+ *
+ * It is separate from Krita's own autosave, which writes a backup copy for
+ * crash recovery. A document is saved only when it has unsaved changes, has a
+ * file already, in a format that keeps layers (.kra, .psd, .ora), is not
+ * being saved and its image is not busy; a busy document is tried again a
+ * little later. Saving runs without dialogs (the last export settings of the
+ * format are used).
+ */
+class KisNovaFileAutoSaver : public QObject
+{
+    Q_OBJECT
+public:
+    explicit KisNovaFileAutoSaver(QObject *parent = nullptr);
+
+private Q_SLOTS:
+    void slotConfigChanged();
+    void slotSaveDocuments();
+
+private:
+    static bool canSave(KisDocument *document);
+
+    QTimer m_timer;
+    QTimer m_retryTimer; ///< a busy document is tried again soon
+    bool m_enabled {false};
+};
+
+#endif
