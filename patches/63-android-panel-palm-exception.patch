     private final android.util.SparseBooleanArray m_reportedFingers = new android.util.SparseBooleanArray();
     private final int[] m_qtViewOrigin = new int[2];
 
+    // Krita Nova (patch 63): where the Brush Panel is, in the physical pixels
+    // of the Qt view (set by KisMainWindow.cpp; empty while it is hidden).
+    // Fingers that land there are exempt from palm rejection: always
+    // reported, and a quick tap the system cancels (its own palm rejection)
+    // still counts as a tap.
+    private static volatile int s_panelLeft = 0, s_panelTop = 0, s_panelRight = 0, s_panelBottom = 0;
+    private static final long PANEL_TAP_MS = 500;
+    private static final float PANEL_TAP_SLOP = 24.0f;
+    private final android.util.SparseBooleanArray m_panelFingers = new android.util.SparseBooleanArray();
+    private final android.util.SparseLongArray m_fingerDownTime = new android.util.SparseLongArray();
+    private final android.util.SparseArray<float[]> m_fingerDownPos = new android.util.SparseArray<>();
+
+    public static void setBrushPanelRect(int left, int top, int right, int bottom) {
+        s_panelLeft = left;
+        s_panelTop = top;
+        s_panelRight = right;
+        s_panelBottom = bottom;
+    }
+
+    private boolean onBrushPanel(MotionEvent ev, int index) {
+        if (s_panelRight <= s_panelLeft || s_panelBottom <= s_panelTop) return false;
+        final float x = ev.getX(index) - m_qtViewOrigin[0];
+        final float y = ev.getY(index) - m_qtViewOrigin[1];
+        return x >= s_panelLeft && x < s_panelRight && y >= s_panelTop && y < s_panelBottom;
+    }
+
+    /// a finger on the panel that went down a moment ago and hardly moved
+    private boolean isQuickPanelTap(MotionEvent ev, int index) {
+        final int id = ev.getPointerId(index);
+        if (!m_panelFingers.get(id)) return false;
+        final long down = m_fingerDownTime.get(id, -1);
+        final float[] pos = m_fingerDownPos.get(id);
+        if (down < 0 || pos == null) return false;
+        if (android.os.SystemClock.uptimeMillis() - down > PANEL_TAP_MS) return false;
+        return Math.abs(ev.getX(index) - pos[0]) < PANEL_TAP_SLOP
+            && Math.abs(ev.getY(index) - pos[1]) < PANEL_TAP_SLOP;
+    }
