index 0000000..ec8d114
--- /dev/null
+++ b/plugins/extensions/photoshopbrushes/KisProcreateBrushReader.h
@@ -0,0 +1,53 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_PROCREATE_BRUSH_READER_H
+#define KIS_PROCREATE_BRUSH_READER_H
+
+#include <QByteArray>
+#include <QImage>
+#include <QString>
+#include <QVariant>
+#include <QVector>
+
+/**
+ * Krita Nova: reads Procreate brushes. A .brush is a zip archive with
+ * Brush.archive (the settings: an NSKeyedArchiver binary property list),
+ * Shape.png (the tip, white is paint) and Grain.png; a .brushset is a zip
+ * archive of such brush folders, with brushset.plist (the set's name and the
+ * order of the brushes).
+ */
+class KisProcreateBrushReader
+{
+public:
