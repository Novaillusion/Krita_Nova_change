+    }
 
-    result.presets = added.size();
-    result.ok = added.size() > 0;
-    if (!result.ok && result.error.isEmpty()) {
-        result.error = i18n("No brushes could be made from %1.", fileName);
+    const QString location = dir + '/' + storageName;
