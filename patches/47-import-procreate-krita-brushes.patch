+KisAbrPresetImporter::Result KisAbrPresetImporter::importProcreate(const QString &fileName, const QByteArray &data)
+{
+    Result result;
+    const KisProcreateBrushReader::Result read = KisProcreateBrushReader::read(data);
+    if (!read.ok) {
+        result.error = read.error;
+        return result;
+    }
+
+    // the category: the file's name, like for Photoshop brushes
+    const QString base = baseNameOf(fileName, read.setName.isEmpty() ? QStringLiteral("procreate-brushes") : read.setName);
+
+    KisResourceModel brushes(ResourceType::Brushes);
+    QHash<QString, KisBrushSP> tipCache;
+    QVector<PlannedBrush> planned;
+    QStringList skipped;
+
+    for (int i = 0; i < read.brushes.size(); i++) {
+        const KisProcreateBrushReader::Brush &source = read.brushes[i];
+        const QVariantMap &s = source.settings;
+        PlannedBrush plan;
+        BrushInfo &info = plan.info;
+
+        info.name = source.name.isEmpty() ? i18n("%1 %2", base, i + 1) : source.name;
+
+        // Procreate's scales are not published: these follow what is known
+        // of them (size 0..1 of the brush's maximum size, fractions elsewhere)
+        const qreal paintSize = qBound(0.0, settingOr(s, "paintSize", 0.5), 1.0);
+        const qreal maxSize = qMax(0.01, settingOr(s, "maxSize", 1.0));
+        info.diameter = qBound(1.0, paintSize * maxSize * 100.0, 1000.0);
+        info.spacing = qBound(0.02, settingOr(s, "plotSpacing", 0.1), 10.0);
+        info.presetOpacity = qBound(0.01, settingOr(s, "maxOpacity", 1.0), 1.0);
+        info.hardness = 1.0;
+
+        // pen pressure and jitter
+        const qreal pressureSize = qBound(0.0, settingOr(s, "dynamicsPressureSize", 0.0), 1.0);
+        const qreal jitterSize = qBound(0.0, settingOr(s, "dynamicsJitterSize", 0.0), 1.0);
+        const qreal rotationJitter = qBound(0.0, settingOr(s, "shapeScatter", 0.0), 1.0);
+        info.tipDynamics = pressureSize > 0.0 || jitterSize > 0.0 || rotationJitter > 0.0;
+        if (pressureSize > 0.0) {
+            info.size.control = 2;
+            info.minimumDiameter = 1.0 - pressureSize;
+        }
+        info.size.jitter = jitterSize;
+        info.angleVariation.jitter = rotationJitter;
+
+        const qreal pressureOpacity = qBound(0.0, settingOr(s, "dynamicsPressureOpacity", 0.0), 1.0);
+        const qreal jitterOpacity = qBound(0.0, settingOr(s, "dynamicsJitterOpacity", 0.0), 1.0);
+        info.paintDynamics = pressureOpacity > 0.0 || jitterOpacity > 0.0;
+        if (pressureOpacity > 0.0) {
+            info.opacity.control = 2;
+            info.minimumOpacity = 1.0 - pressureOpacity;
+        }
+        info.opacity.jitter = jitterOpacity;
+
+        const qreal positionJitter = qBound(0.0, settingOr(s, "plotJitter", 0.0), 5.0);
+        info.scatterOn = positionJitter > 0.0;
+        info.scatter.jitter = positionJitter;
+        info.scatterBothAxes = true;
+
+        // the tip: white is paint (black when "shapeInverted"); Krita's tips: black is paint
+        if (!source.shape.isNull()) {
