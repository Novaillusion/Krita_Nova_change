+QStringList KisAbrPresetImporter::supportedExtensions()
+{
+    return {"abr", "brush", "brushset", "kpp", "bundle"};
+}
+
+KisAbrPresetImporter::Result KisAbrPresetImporter::importFile(const QString &fileName, const QByteArray &data)
+{
+    QString suffix = QFileInfo(fileName).suffix().toLower();
+    QString name = fileName;
+
+    // no known extension (e.g. an Android document name): by the contents
+    if (!supportedExtensions().contains(suffix)) {
+        if (data.startsWith("\x89PNG")) {
+            suffix = "kpp";
+        } else if (data.startsWith("PK")) {
+            // Krita bundles start with their "mimetype" entry
+            suffix = data.mid(30, 8) == "mimetype" ? "bundle" : "brushset";
+        } else {
+            suffix = "abr";
+        }
+        name = fileName + "." + suffix;
+    }
+
+    if (suffix == "brush" || suffix == "brushset") return importProcreate(name, data);
+    if (suffix == "kpp") return importKritaPreset(name, data, i18n("Imported Brushes"));
+    if (suffix == "bundle") return importBundle(name, data);
+    return importData(name, data);
+}
