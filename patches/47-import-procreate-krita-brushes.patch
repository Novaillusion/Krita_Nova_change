new file mode 100644
index 0000000..f10ec47
--- /dev/null
+++ b/plugins/extensions/photoshopbrushes/KisProcreateBrushReader.cpp
@@ -0,0 +1,431 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisProcreateBrushReader.h"
+
+#include <QBuffer>
+#include <QDomDocument>
+#include <QHash>
+#include <QMap>
+#include <QStringList>
+#include <QtEndian>
+
+#include <klocalizedstring.h>
+#include <kis_debug.h>
+
+#include <quazip.h>
+#include <quazipfile.h>
+
+#include <cstring>
+
+namespace {
+
+const qint64 MaxEntrySize = 64 * 1024 * 1024; // a tip is a few MB; anything bigger is not a brush
+
+// ---------------------------------------------------------------------------
+// binary property lists
+// ---------------------------------------------------------------------------
+
+class BinaryPlist
+{
+public:
+    BinaryPlist(const QByteArray &data) : m_data(data) {}
+
+    QVariant parse(bool *ok)
+    {
+        *ok = false;
+        if (m_data.size() < 40 || !m_data.startsWith("bplist00")) return QVariant();
+
+        const uchar *trailer = reinterpret_cast<const uchar *>(m_data.constData()) + m_data.size() - 32;
+        m_offsetSize = trailer[6];
+        m_refSize = trailer[7];
+        m_count = qFromBigEndian<quint64>(trailer + 8);
+        const quint64 top = qFromBigEndian<quint64>(trailer + 16);
+        const quint64 tableOffset = qFromBigEndian<quint64>(trailer + 24);
+
+        if (m_offsetSize < 1 || m_offsetSize > 8 || m_refSize < 1 || m_refSize > 8) return QVariant();
+        if (m_count == 0 || m_count > 1000000 || top >= m_count) return QVariant();
+        if (tableOffset + m_count * m_offsetSize > quint64(m_data.size()) - 32) return QVariant();
+
+        m_offsets.resize(int(m_count));
+        for (quint64 i = 0; i < m_count; i++) {
+            m_offsets[int(i)] = readUInt(int(tableOffset + i * m_offsetSize), m_offsetSize);
+        }
+        m_cache.resize(int(m_count));
+        m_state.fill(0, int(m_count));
+
+        const QVariant result = object(top, 0);
+        *ok = !m_failed;
+        return result;
+    }
+
+private:
+    quint64 readUInt(int pos, int size)
+    {
+        if (pos < 0 || pos + size > m_data.size()) { m_failed = true; return 0; }
+        quint64 v = 0;
+        for (int i = 0; i < size; i++) v = (v << 8) | quint8(m_data[pos + i]);
+        return v;
+    }
+
+    /// the length that follows a marker with the low nibble 0xF
+    quint64 length(int &pos, int low)
+    {
+        if (low != 0xF) return quint64(low);
+        if (pos >= m_data.size()) { m_failed = true; return 0; }
+        const quint8 marker = quint8(m_data[pos++]);
+        if ((marker & 0xF0) != 0x10) { m_failed = true; return 0; }
+        const int size = 1 << (marker & 0x0F);
+        const quint64 v = readUInt(pos, size);
+        pos += size;
+        return v;
+    }
+
+    QVariant object(quint64 ref, int depth)
+    {
+        if (m_failed || ref >= m_count || depth > 64) { m_failed = true; return QVariant(); }
+        const int index = int(ref);
+        if (m_state[index] == 2) return m_cache[index];
+        if (m_state[index] == 1) { m_failed = true; return QVariant(); } // a cycle
+        m_state[index] = 1;
+
+        int pos = int(m_offsets[index]);
+        if (pos < 8 || pos >= m_data.size() - 32) { m_failed = true; return QVariant(); }
+        const quint8 marker = quint8(m_data[pos++]);
+        const int high = marker >> 4;
+        const int low = marker & 0x0F;
+        QVariant result;
+
+        switch (high) {
+        case 0x0:
+            result = (marker == 0x09) ? QVariant(true) : (marker == 0x08 ? QVariant(false) : QVariant());
+            break;
+        case 0x1: {
+            const int size = 1 << low;
+            if (size > 8) { m_failed = true; break; }
+            const quint64 v = readUInt(pos, size);
+            result = QVariant(qint64(v));
+            break;
+        }
+        case 0x2: {
+            const int size = 1 << low;
+            if (size == 4) {
+                const quint32 bits = quint32(readUInt(pos, 4));
+                float f;
+                memcpy(&f, &bits, 4);
+                result = double(f);
+            } else if (size == 8) {
+                const quint64 bits = readUInt(pos, 8);
+                double d;
+                memcpy(&d, &bits, 8);
+                result = d;
+            } else {
+                m_failed = true;
+            }
+            break;
+        }
+        case 0x3: { // date: seconds since 2001
+            const quint64 bits = readUInt(pos, 8);
+            double d;
+            memcpy(&d, &bits, 8);
+            result = d;
+            break;
+        }
+        case 0x4: {
+            const quint64 n = length(pos, low);
+            if (pos + qint64(n) > m_data.size()) { m_failed = true; break; }
+            result = m_data.mid(pos, int(n));
+            break;
+        }
+        case 0x5: {
+            const quint64 n = length(pos, low);
+            if (pos + qint64(n) > m_data.size()) { m_failed = true; break; }
+            result = QString::fromLatin1(m_data.constData() + pos, int(n));
+            break;
+        }
+        case 0x6: {
+            const quint64 n = length(pos, low);
+            if (pos + qint64(n) * 2 > m_data.size()) { m_failed = true; break; }
+            QString s;
+            s.reserve(int(n));
+            for (quint64 i = 0; i < n; i++) s.append(QChar(ushort(readUInt(pos + int(i) * 2, 2))));
+            result = s;
+            break;
+        }
+        case 0x8: {
+            QVariantMap uid;
+            uid.insert("$uid", qint64(readUInt(pos, low + 1)));
+            result = uid;
+            break;
+        }
+        case 0xA:
+        case 0xC: { // array, set
+            const quint64 n = length(pos, low);
+            if (n > 1000000) { m_failed = true; break; }
+            QVariantList list;
+            for (quint64 i = 0; i < n && !m_failed; i++) {
+                list.append(object(readUInt(pos + int(i) * m_refSize, m_refSize), depth + 1));
+            }
+            result = list;
+            break;
+        }
+        case 0xD: {
+            const quint64 n = length(pos, low);
+            if (n > 1000000) { m_failed = true; break; }
+            QVariantMap map;
+            for (quint64 i = 0; i < n && !m_failed; i++) {
+                const QVariant key = object(readUInt(pos + int(i) * m_refSize, m_refSize), depth + 1);
+                const QVariant value = object(readUInt(pos + int(n + i) * m_refSize, m_refSize), depth + 1);
+                map.insert(key.toString(), value);
+            }
+            result = map;
+            break;
+        }
+        default:
+            m_failed = true;
+        }
+
+        m_cache[index] = result;
+        m_state[index] = 2;
+        return result;
+    }
+
+    const QByteArray &m_data;
+    int m_offsetSize = 0;
+    int m_refSize = 0;
+    quint64 m_count = 0;
+    QVector<quint64> m_offsets;
+    QVector<QVariant> m_cache;
+    QVector<char> m_state;
+    bool m_failed = false;
+};
+
+// ---------------------------------------------------------------------------
+// XML property lists
+// ---------------------------------------------------------------------------
+
+QVariant xmlValue(const QDomElement &e)
+{
+    const QString tag = e.tagName();
+    if (tag == "dict") {
+        QVariantMap map;
+        QString key;
+        for (QDomElement child = e.firstChildElement(); !child.isNull(); child = child.nextSiblingElement()) {
+            if (child.tagName() == "key") key = child.text();
+            else map.insert(key, xmlValue(child));
+        }
+        return map;
+    } else if (tag == "array") {
+        QVariantList list;
+        for (QDomElement child = e.firstChildElement(); !child.isNull(); child = child.nextSiblingElement()) {
+            list.append(xmlValue(child));
+        }
+        return list;
+    } else if (tag == "string") {
+        return e.text();
+    } else if (tag == "integer") {
+        return e.text().toLongLong();
+    } else if (tag == "real") {
+        return e.text().toDouble();
+    } else if (tag == "true") {
+        return true;
+    } else if (tag == "false") {
+        return false;
+    } else if (tag == "data") {
+        return QByteArray::fromBase64(e.text().toLatin1());
+    }
+    return QVariant();
+}
+
+QVariant anyPlist(const QByteArray &data, bool *ok)
+{
+    if (data.startsWith("bplist")) return KisProcreateBrushReader::parseBinaryPlist(data, ok);
+    return KisProcreateBrushReader::parseXmlPlist(data, ok);
+}
+
+// ---------------------------------------------------------------------------
+// NSKeyedArchiver
+// ---------------------------------------------------------------------------
+
+bool isUid(const QVariant &v)
+{
+    return v.userType() == QMetaType::QVariantMap && v.toMap().size() == 1 && v.toMap().contains("$uid");
+}
+
+QVariant resolve(const QVariant &value, const QVariantList &objects, int depth)
+{
+    if (depth > 6) return QVariant();
+
+    if (isUid(value)) {
+        const qint64 index = value.toMap().value("$uid").toLongLong();
+        if (index < 0 || index >= objects.size()) return QVariant();
+        const QVariant object = objects[int(index)];
+        if (object.toString() == "$null") return QVariant();
+        return resolve(object, objects, depth + 1);
+    }
+    if (value.userType() == QMetaType::QVariantMap) {
+        QVariantMap map = value.toMap();
+        // NSString / NSMutableString objects keep their text in NS.string
+        if (map.contains("NS.string")) return resolve(map.value("NS.string"), objects, depth + 1);
+        // NSArray: NS.objects
+        if (map.contains("NS.objects") && !map.contains("NS.keys")) {
+            return resolve(map.value("NS.objects"), objects, depth + 1);
+        }
+        for (auto it = map.begin(); it != map.end(); ++it) {
+            if (it.key() == "$class") continue;
+            it.value() = resolve(it.value(), objects, depth + 1);
+        }
+        return map;
+    }
+    if (value.userType() == QMetaType::QVariantList) {
+        QVariantList list = value.toList();
+        for (QVariant &item : list) item = resolve(item, objects, depth + 1);
+        return list;
+    }
+    return value;
+}
+
+// ---------------------------------------------------------------------------
+// zip
+// ---------------------------------------------------------------------------
+
+QMap<QString, QByteArray> unzip(const QByteArray &zipData, bool *ok)
+{
+    QMap<QString, QByteArray> entries;
+    *ok = false;
+
+    QByteArray copy = zipData;
+    QBuffer buffer(&copy);
+    QuaZip zip(&buffer);
+    if (!zip.open(QuaZip::mdUnzip)) return entries;
+
+    for (bool more = zip.goToFirstFile(); more; more = zip.goToNextFile()) {
+        const QString name = zip.getCurrentFileName();
+        if (name.endsWith('/')) continue;
+        const QString base = name.section('/', -1);
+        // only what a brush needs
+        if (base != "Brush.archive" && base != "Shape.png" && base != "Grain.png" && base != "brushset.plist") continue;
+
+        QuaZipFile file(&zip);
+        if (!file.open(QIODevice::ReadOnly)) continue;
+        QByteArray content;
+        char chunk[65536];
+        qint64 n;
+        while ((n = file.read(chunk, sizeof(chunk))) > 0) {
+            content.append(chunk, int(n));
+            if (content.size() > MaxEntrySize) break;
+        }
+        file.close();
+        if (content.size() > MaxEntrySize) continue;
+        entries.insert(name, content);
+    }
+    zip.close();
+    *ok = true;
+    return entries;
+}
+
+} // namespace
+
+QVariant KisProcreateBrushReader::parseBinaryPlist(const QByteArray &data, bool *ok)
+{
+    BinaryPlist plist(data);
+    return plist.parse(ok);
+}
+
+QVariant KisProcreateBrushReader::parseXmlPlist(const QByteArray &data, bool *ok)
+{
+    *ok = false;
+    QDomDocument doc;
+    if (!doc.setContent(data)) return QVariant();
+    const QDomElement root = doc.documentElement();
+    const QDomElement value = root.tagName() == "plist" ? root.firstChildElement() : root;
+    if (value.isNull()) return QVariant();
+    *ok = true;
+    return xmlValue(value);
+}
+
+QVariantMap KisProcreateBrushReader::keyedArchiveRoot(const QVariant &archive)
+{
+    const QVariantMap map = archive.toMap();
+    const QVariantList objects = map.value("$objects").toList();
+    const QVariantMap top = map.value("$top").toMap();
+    QVariant root = top.value("root");
+    if (!root.isValid() && !top.isEmpty()) root = top.first();
+    if (!isUid(root)) return QVariantMap();
+    return resolve(root, objects, 0).toMap();
+}
+
+KisProcreateBrushReader::Result KisProcreateBrushReader::read(const QByteArray &zipData)
+{
+    Result result;
+
+    bool ok = false;
+    const QMap<QString, QByteArray> entries = unzip(zipData, &ok);
+    if (!ok) {
+        result.error = i18n("The file is not a Procreate brush (it is not a zip archive).");
+        return result;
+    }
+
+    // the brush folders: where the Brush.archive files are ("" for a .brush)
+    QStringList folders;
+    for (auto it = entries.begin(); it != entries.end(); ++it) {
+        if (it.key().section('/', -1) == "Brush.archive") {
+            const QString folder = it.key().contains('/') ? it.key().section('/', 0, -2) : QString();
+            folders << folder;
+        }
+    }
+    if (folders.isEmpty()) {
+        result.error = i18n("The file has no Procreate brushes in it.");
+        return result;
+    }
+
+    // a set: its name and the artist's order of the brushes
+    for (auto it = entries.begin(); it != entries.end(); ++it) {
+        if (it.key().section('/', -1) != "brushset.plist") continue;
+        bool plistOk = false;
+        const QVariantMap set = anyPlist(it.value(), &plistOk).toMap();
+        if (!plistOk) continue;
+        result.setName = set.value("name").toString();
+        QStringList ordered;
+        Q_FOREACH (const QVariant &item, set.value("brushes").toList()) {
+            const QString folder = item.toString();
+            if (folders.contains(folder)) ordered << folder;
+        }
+        Q_FOREACH (const QString &folder, folders) {
+            if (!ordered.contains(folder)) ordered << folder;
+        }
+        folders = ordered;
+        break;
+    }
+
+    Q_FOREACH (const QString &folder, folders) {
+        const QString prefix = folder.isEmpty() ? QString() : folder + '/';
+
+        bool plistOk = false;
+        const QVariant archive = parseBinaryPlist(entries.value(prefix + "Brush.archive"), &plistOk);
+        if (!plistOk) {
+            warnKrita << "Procreate brushes: could not read" << prefix + "Brush.archive";
+            continue;
+        }
+
+        Brush brush;
+        brush.settings = keyedArchiveRoot(archive);
+        brush.name = brush.settings.value("name").toString().trimmed();
+
+        const QByteArray shape = entries.value(prefix + "Shape.png");
+        if (!shape.isEmpty()) brush.shape.loadFromData(shape);
+        brush.hasGrain = entries.contains(prefix + "Grain.png");
+
+        result.brushes.append(brush);
+    }
+
+    if (result.brushes.isEmpty()) {
+        result.error = i18n("The Procreate brushes could not be read.");
+        return result;
+    }
+    result.ok = true;
+    return result;
+}
