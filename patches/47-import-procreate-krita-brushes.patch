+        if (!ids.isEmpty()) break;
+    }
+
+    KisResourceModel presets(ResourceType::PaintOpPresets);
+    QVector<KoResourceSP> resources;
+    Q_FOREACH (int id, ids) {
+        KoResourceSP resource = presets.resourceForId(id);
+        if (resource) resources << resource;
