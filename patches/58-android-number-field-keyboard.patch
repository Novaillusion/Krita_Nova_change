diff --git a/qmlmodules/widgets/KisQQuickWidget.cpp b/qmlmodules/widgets/KisQQuickWidget.cpp
index f16372b..96c82c9 100644
--- a/qmlmodules/widgets/KisQQuickWidget.cpp
