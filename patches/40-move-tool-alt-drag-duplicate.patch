+KisNodeList KisToolMove::duplicateNodesForMove(const KisNodeList &nodes)
+{
+    KisImageSP image = this->image();
+    KisNodeList copies;
+    if (!image) return copies;
+
+    // only the topmost of nested layers: a group's copy has its children
+    KisNodeList roots;
+    Q_FOREACH (KisNodeSP node, nodes) {
+        bool nested = false;
+        for (KisNodeSP parent = node->parent(); parent; parent = parent->parent()) {
+            if (nodes.contains(parent)) {
+                nested = true;
+                break;
+            }
+        }
+        if (!nested && node->parent() && node != image->root()) roots << node;
+    }
+    if (roots.isEmpty()) return copies;
+
+    // the move of the previous drag may still be finishing
+    image->waitForDone();
+
+    KUndo2Command *command = new KUndo2Command(kundo2_i18n("Duplicate"));
+    KisCommandUtils::CompositeCommand *composite = new KisCommandUtils::CompositeCommand(command);
+    Q_FOREACH (KisNodeSP node, roots) {
+        KisNodeSP copy = node->clone();
+        copy->setName(i18nc("Name of a layer duplicated with Alt+drag", "%1 copy", node->name()));
+        composite->addCommand(new KisImageLayerAddCommand(image, copy, node->parent(), node, true, true));
+        copies << copy;
+    }
+    image->undoAdapter()->addCommand(command);
+
+    // the copies are the selected layers now, like in Photoshop
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(canvas());
+    if (kisCanvas && kisCanvas->viewManager() && kisCanvas->viewManager()->nodeManager()) {
+        kisCanvas->viewManager()->nodeManager()->slotImageRequestNodeReselection(copies.last(), copies);
+    }
+    return copies;
+}
+
+void KisToolMove::startDuplicateAction(KoPointerEvent *event, MoveToolMode mode)
+{
+    QPoint pos = convertToPixelCoordAndSnap(event).toPoint();
+    m_dragStart = pos;
+    m_dragPos = pos;
+
+    if (m_strokeId) {
+        endStroke(); // the previous moves are done: duplicate what they made
+    }
+
+    if (startStrokeImpl(mode, &pos, true)) {
+        setMode(KisTool::PAINT_MODE);
+        if (m_currentlyUsingSelection) {
+            KisImageSP image = currentImage();
+            image->addJob(m_strokeId,
+                          new MoveSelectionStrokeStrategy::ShowSelectionData(false));
+        }
+    } else {
+        event->ignore();
+        m_dragPos = QPoint();
+        m_dragStart = QPoint();
+    }
+    qobject_cast<KisCanvas2*>(canvas())->updateCanvas();
+}
