diff --git a/libs/ui/KisTouchFriendlyStyle.cpp b/libs/ui/KisTouchFriendlyStyle.cpp
new file mode 100644
index 0000000..11986c7
--- /dev/null
+++ b/libs/ui/KisTouchFriendlyStyle.cpp
@@ -0,0 +1,58 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova contributors
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisTouchFriendlyStyle.h"
+
+#include <QApplication>
+#include <QStyleFactory>
+
+KisTouchFriendlyStyle::KisTouchFriendlyStyle(const QString &baseStyleName)
+    : QProxyStyle(baseStyleName)
+{
+    // Report the wrapped style's name ("fusion", "breeze"...): several places
+    // recreate the current style with QStyleFactory::create(style()->objectName()).
+    if (baseStyle()) {
+        setObjectName(baseStyle()->objectName());
+    }
+}
+
+int KisTouchFriendlyStyle::pixelMetric(PixelMetric metric, const QStyleOption *option, const QWidget *widget) const
+{
+    const int value = QProxyStyle::pixelMetric(metric, option, widget);
+
+    switch (metric) {
+    case PM_DockWidgetSeparatorExtent:
+    case PM_SplitterWidth:
+        return qMax(value, TOUCH_HANDLE_EXTENT);
+    default:
+        return value;
+    }
+}
+
+bool KisTouchFriendlyStyle::isEnabled()
+{
+#ifdef Q_OS_ANDROID
+    return true;
+#else
+    return false;
+#endif
+}
+
+void KisTouchFriendlyStyle::applyStyle(const QString &styleName)
+{
+    if (!isEnabled()) {
+        qApp->setStyle(styleName);
+        return;
+    }
+
+    if (!QStyleFactory::keys().contains(styleName, Qt::CaseInsensitive)) {
+        // Unknown style: let Qt handle it exactly as before (it keeps the current one).
+        qApp->setStyle(styleName);
+        return;
+    }
+
+    qApp->setStyle(new KisTouchFriendlyStyle(styleName));
+}
diff --git a/libs/ui/KisTouchFriendlyStyle.h b/libs/ui/KisTouchFriendlyStyle.h
new file mode 100644
index 0000000..180e99b
--- /dev/null
+++ b/libs/ui/KisTouchFriendlyStyle.h
@@ -0,0 +1,45 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova contributors
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_TOUCH_FRIENDLY_STYLE_H
+#define KIS_TOUCH_FRIENDLY_STYLE_H
+
+#include <QProxyStyle>
+
+#include "kritaui_export.h"
+
+/**
+ * Proxy style used on touch devices (Android).
+ *
+ * The separators between dockers (QMainWindow) and splitter handles are only a
+ * few pixels wide in Fusion, far too thin to grab with a finger or a stylus.
+ * This style widens their hit area; everything else is forwarded unchanged to
+ * the real style, whose objectName() it also reports so that code doing
+ * QStyleFactory::create(style()->objectName()) keeps working.
+ */
+class KRITAUI_EXPORT KisTouchFriendlyStyle : public QProxyStyle
+{
+    Q_OBJECT
+public:
+    explicit KisTouchFriendlyStyle(const QString &baseStyleName);
+
+    int pixelMetric(PixelMetric metric, const QStyleOption *option = nullptr,
+                    const QWidget *widget = nullptr) const override;
+
+    /// Whether the touch-friendly style should wrap the application style.
+    static bool isEnabled();
+
+    /**
+     * Sets \p styleName as the application style, wrapped in
+     * KisTouchFriendlyStyle when isEnabled(). Use instead of qApp->setStyle(name).
+     */
+    static void applyStyle(const QString &styleName);
+
+    /// Width (in device-independent pixels) of docker separators and splitter handles.
+    static constexpr int TOUCH_HANDLE_EXTENT = 14;
+};
+
+#endif // KIS_TOUCH_FRIENDLY_STYLE_H
