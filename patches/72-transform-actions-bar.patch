+#ifndef KIS_TRANSFORM_ACTIONS_BAR_H
+#define KIS_TRANSFORM_ACTIONS_BAR_H
+
+#include <QPointer>
+#include <QWidget>
+
+class KisToolTransform;
+class QAbstractButton;
+
+/**
+ * Krita Nova: a small floating bar over the canvas while the Transform tool
+ * is active, in the manner of the selection actions bar: flip horizontally
+ * and vertically, rotate 90 degrees either way, reset, the transform mode,
+ * cancel and apply. It sits at the bottom middle of the canvas; its grip
+ * (the dots at its right end) moves it, and the place is remembered.
+ */
+class KisTransformActionsBar : public QWidget
+{
+public:
+    KisTransformActionsBar(KisToolTransform *tool, QWidget *canvasWidget);
+
+    /// show the current mode, enable what suits it
+    void updateState();
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void place();
+    void dragBy(const QPoint &globalPos, bool start, bool end);
+    void showModeMenu();
+
+    QPointer<KisToolTransform> m_tool;
+    QPointer<QWidget> m_canvasWidget;
+    QList<QAbstractButton *> m_freeOnlyButtons; ///< flip / rotate: free transform only
+    QAbstractButton *m_modeButton {nullptr};
+    QWidget *m_grip {nullptr};
+    QPoint m_offset;          ///< from the bottom-middle place, remembered
+    QPoint m_dragStartGlobal;
+    QPoint m_dragStartOffset;
+    bool m_dragging {false};
+    int m_shownMode {-1};
+};
+
+#endif
