+QRectF KisToolTransform::novaTransformZoneInWidget() const
+{
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(canvas());
+    if (!m_strokeId || !kisCanvas || m_transaction.rootNodes().isEmpty()) return QRectF();
+    const QRectF original = m_transaction.originalRect();
+    if (original.isEmpty()) return QRectF();
+
+    QPolygonF zone(original);
+    const ToolTransformArgs::TransformMode mode = m_currentArgs.mode();
+    if (mode == ToolTransformArgs::FREE_TRANSFORM || mode == ToolTransformArgs::PERSPECTIVE_4POINT) {
+        zone = KisTransformUtils::MatricesPack(m_currentArgs).finalTransform().map(zone);
+    }
+    return kisCanvas->coordinatesConverter()->imageToWidget(zone).boundingRect();
+}
