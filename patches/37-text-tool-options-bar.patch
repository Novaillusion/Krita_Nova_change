diff --git a/plugins/dockers/textproperties/qml/NovaTextOptionsBar.qml b/plugins/dockers/textproperties/qml/NovaTextOptionsBar.qml
new file mode 100644
index 0000000..9935203
--- /dev/null
+++ b/plugins/dockers/textproperties/qml/NovaTextOptionsBar.qml
@@ -0,0 +1,196 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+import QtQuick 2.15
+import QtQuick.Controls 2.15
+import QtQuick.Layouts 1.12
+import org.krita.flake.text 1.0
+import org.krita.components 1.0 as Kis
+
+/**
+ * Krita Nova (patch 37): the text tool's options bar, like Photoshop's:
+ * font family, style, size, alignment, color, and buttons for the Character
+ * and Paragraph panels. Shown at the top of the text tool's Tool Options
+ * (SvgTextToolOptions.qml loads it), with the Character panel's canvas
+ * observer, so it edits the same text the panels do. It flows into rows, so
+ * it fits both the Tool Options docker and the tool options toolbar.
+ */
+Flow {
+    id: root;
+    spacing: 4;
+
+    property TextPropertiesCanvasObserver canvasObserver: null;
+    /// NovaTextPanelDock of the Character panel: text color, panels
+    property QtObject panel: null;
+
+    property KoSvgTextPropertiesModel props: canvasObserver
+                                             ? ((canvasObserver.characterProperties.enabled
+                                                 && canvasObserver.characterProperties.spanSelection)
+                                                ? canvasObserver.characterProperties
+                                                : canvasObserver.textProperties)
+                                             : null;
+    property KoSvgTextPropertiesModel paragraphProps: canvasObserver ? canvasObserver.textProperties : null;
+    property double dpi: canvasObserver ? canvasObserver.dpi : 72.0;
+    property bool blockSignals: false;
+
+    Kis.FontFunctions {
+        id: fontFunctions;
+    }
+
+    FontStyleModel {
+        id: stylesModel;
+    }
+
+    function refreshFamilyAndStyle() {
+        if (!props) return;
+        blockSignals = true;
+        let families = props.fontFamilies;
+        if (families.length > 0) {
+            let name = fontFunctions.wwsFontFamilyName(families[0]);
+            if (name !== familyCmb.modelWrapper.resourceFilename) {
+                familyCmb.modelWrapper.currentTag = 0;
+                familyCmb.modelWrapper.currentIndex = -1;
+            }
+            familyCmb.resourceName = name;
+        }
+        stylesModel.setFromTextPropertiesModel(props);
+        styleCmb.currentIndex = stylesModel.rowForStyle(props.fontWeight, props.fontWidth,
+                                                        props.fontStyle.style, props.fontStyle.value);
+        blockSignals = false;
+    }
+
+    onPropsChanged: refreshFamilyAndStyle();
+    Component.onCompleted: refreshFamilyAndStyle();
+
+    Connections {
+        target: root.props;
+        ignoreUnknownSignals: true;
+        function onFontFamiliesChanged() { root.refreshFamilyAndStyle(); }
+        function onFontWeightChanged() { root.refreshFamilyAndStyle(); }
+        function onFontWidthChanged() { root.refreshFamilyAndStyle(); }
+        function onFontStyleChanged() { root.refreshFamilyAndStyle(); }
+    }
+
+    function anchorIs(anchor) {
+        return paragraphProps ? paragraphProps.textAnchor === anchor : false;
+    }
+    function setAnchor(anchor, align) {
+        if (!paragraphProps) return;
+        paragraphProps.textAnchor = anchor;
+        // keep justified text justified, otherwise align like the anchor
+        if (paragraphProps.textAlignAll !== KoSvgText.AlignJustify) {
+            paragraphProps.textAlignAll = align;
+        }
+    }
+
+    FontResourceDropdown {
+        id: familyCmb;
+        width: 170;
+        locales: canvasObserver ? canvasObserver.locales : [];
+        enabled: root.props !== null;
+        onActivated: {
+            if (root.blockSignals || !root.props) return;
+            let families = root.props.fontFamilies.slice();
+            if (families.length > 0) {
+                families[0] = resourceName;
+            } else {
+                families = [resourceName];
+            }
+            root.props.fontFamilies = families;
+        }
+    }
+
+    SqueezedComboBox {
+        id: styleCmb;
+        width: 110;
+        model: stylesModel;
+        textRole: "display";
+        enabled: root.props !== null;
+        onActivated: {
+            if (root.blockSignals || !root.props) return;
+            var weight = stylesModel.weightValue(currentIndex);
+            var width = stylesModel.widthValue(currentIndex);
+            var styleMode = stylesModel.styleModeValue(currentIndex);
+            var styleVal = stylesModel.slantValue(currentIndex);
+            var axesValues = stylesModel.axesValues(currentIndex);
+            root.props.fontWeight = weight;
+            root.props.fontWidth = width;
+            root.props.fontStyle.style = styleMode;
+            if (styleMode === CssFontStyleModel.StyleOblique) {
+                root.props.fontStyle.value = styleVal;
+            }
+            root.props.axisValues = axesValues;
+        }
+    }
+
+    NovaLengthField {
+        width: 150;
+        symbol: "tT";
+        toolTipText: i18nc("@info:tooltip", "Font size");
+        textProperties: root.props;
+        lengthModel: root.props ? root.props.fontSize : null;
+        dpi: root.dpi;
+        isFontSize: true;
+        allowPercentage: true;
+    }
+
+    Row {
+        spacing: 1;
+        NovaToggle {
+            icon.source: "qrc:///16_light_format-justify-left.svg";
+            icon.color: palette.text;
+            tip: i18nc("@info:tooltip", "Align left");
+            active: root.anchorIs(KoSvgText.AnchorStart);
+            onActivated: root.setAnchor(KoSvgText.AnchorStart, KoSvgText.AlignStart);
+        }
+        NovaToggle {
+            icon.source: "qrc:///16_light_format-justify-center.svg";
+            icon.color: palette.text;
+            tip: i18nc("@info:tooltip", "Center");
+            active: root.anchorIs(KoSvgText.AnchorMiddle);
+            onActivated: root.setAnchor(KoSvgText.AnchorMiddle, KoSvgText.AlignCenter);
+        }
+        NovaToggle {
+            icon.source: "qrc:///16_light_format-justify-right.svg";
+            icon.color: palette.text;
+            tip: i18nc("@info:tooltip", "Align right");
+            active: root.anchorIs(KoSvgText.AnchorEnd);
+            onActivated: root.setAnchor(KoSvgText.AnchorEnd, KoSvgText.AlignEnd);
+        }
+    }
+
+    Rectangle {
+        width: 34;
+        height: 22;
+        radius: 3;
+        color: root.panel ? root.panel.textColor : "black";
+        border.color: palette.mid;
+        border.width: 1;
+        MouseArea {
+            anchors.fill: parent;
+            cursorShape: Qt.PointingHandCursor;
+            onClicked: if (root.panel) root.panel.pickTextColor();
+        }
+        ToolTip.text: i18nc("@info:tooltip", "Text color");
+        ToolTip.visible: colorHover.hovered;
+        HoverHandler {
+            id: colorHover;
+        }
+    }
+
+    Row {
+        spacing: 1;
+        NovaToggle {
+            text: "A";
+            tip: i18nc("@info:tooltip", "Show the Character panel");
+            onActivated: if (root.panel) root.panel.showPanel("NovaTextCharacter");
+        }
+        NovaToggle {
+            text: "¶";
+            tip: i18nc("@info:tooltip", "Show the Paragraph panel");
+            onActivated: if (root.panel) root.panel.showPanel("NovaTextParagraph");
+        }
+    }
+}
