+QRectF DefaultTool::novaPixelRectInDocument() const
+{
+    KisCanvas2 *kiscanvas = static_cast<KisCanvas2 *>(canvas());
+    if (!kiscanvas || !kiscanvas->image()) return QRectF();
+    const QRectF px = QRectF(m_novaPixelStart, m_novaPixelEnd).normalized();
+    return kiscanvas->image()->pixelToDocument(px);
+}
+
+void DefaultTool::novaFinishPixelSelection(Qt::KeyboardModifiers modifiers)
+{
+    KisCanvas2 *kiscanvas = static_cast<KisCanvas2 *>(canvas());
+    if (!kiscanvas || !kiscanvas->image() || !kiscanvas->viewManager()) return;
+
+    // the selection tools' default modifiers
+    SelectionAction action = SELECTION_REPLACE;
+    const bool shift = modifiers & Qt::ShiftModifier;
+    const bool alt = modifiers & Qt::AltModifier;
+    if (shift && alt) action = SELECTION_INTERSECT;
+    else if (shift) action = SELECTION_ADD;
+    else if (alt) action = SELECTION_SUBTRACT;
+
+    KisSelectionToolHelper helper(kiscanvas, kundo2_i18n("Select Rectangle"));
+    const QRect rc = QRectF(m_novaPixelStart, m_novaPixelEnd).normalized().toAlignedRect()
+            .intersected(kiscanvas->image()->bounds());
+
+    // a click without a drag deselects, as with the rectangle selection tool
+    const QRectF viewRect = kiscanvas->viewConverter()->documentToView(novaPixelRectInDocument());
+    if (helper.tryDeselectCurrentSelection(viewRect, action)) return;
+    if (helper.canShortcutToNoop(rc, action)) return;
+    if (rc.isEmpty()) return;
+
+    KisPixelSelectionSP tmpSel = new KisPixelSelection(new KisDefaultBounds(kiscanvas->image()));
+    tmpSel->select(rc);
+    helper.selectPixelSelection(tmpSel, action);
+}
+
