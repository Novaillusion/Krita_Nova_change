+namespace {
+
+/// Krita Nova: the button's tooltip with the action's shortcut(s), e.g.
+/// "Duplicate layer or mask (Ctrl+J)"
+void updateShortcutToolTip(QAbstractButton *button, QAction *action)
+{
+    if (!button || !action) return;
+
+    QString base = button->property("_kritanova_tooltip").toString();
+    if (base.isEmpty()) {
+        base = button->toolTip();
+        if (base.isEmpty()) base = action->toolTip();
+        button->setProperty("_kritanova_tooltip", base);
+    }
+
+    QStringList keys;
+    Q_FOREACH (const QKeySequence &shortcut, action->shortcuts()) {
+        const QString text = shortcut.toString(QKeySequence::NativeText);
+        if (!text.isEmpty() && !keys.contains(text)) keys << text;
+    }
+    button->setToolTip(keys.isEmpty() ? base
+                                      : i18nc("tooltip: %1 what the button does, %2 keyboard shortcut", "%1 (%2)",
+                                              base, keys.join(i18nc("separator between keyboard shortcuts", ", "))));
+}
+
+/// Krita Nova: keeps the tooltip up to date when the shortcut is changed
+void showShortcutInToolTip(QAbstractButton *button, QAction *action)
+{
+    if (!button || !action) return;
+    updateShortcutToolTip(button, action);
+    QPointer<QAbstractButton> buttonPointer(button);
+    QObject::connect(action, &QAction::changed, button, [buttonPointer, action]() {
+        updateShortcutToolTip(buttonPointer, action);
+    });
+}
+
+} // namespace
