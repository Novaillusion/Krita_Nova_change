+#ifdef Q_OS_ANDROID
+namespace {
+
+/**
+ * Krita Nova: on Android the "Edit" (undo/redo) and "Brushes and Stuff"
+ * toolbars live in a floating vertical panel instead of the top bar, which
+ * keeps only New/Open/Save.
+ *
+ * The toolbars are still the XMLGUI-managed KisToolBar objects (so toolbar
+ * configuration keeps working); they are just reparented into the panel and
+ * turned vertical. QMainWindow::restoreState() (window settings, workspaces)
+ * puts toolbars it knows back into the toolbar areas; a ParentChange filter
+ * moves them into the panel again.
+ */
+/**
+ * Tall vertical slider bound to one of the brush toolbar's slider spin boxes
+ * (size or opacity). Drag up/down to change the value (relative to where the
+ * drag started, so touching it doesn't make the value jump); the fill grows
+ * from the bottom. The value is shown while dragging.
+ */
+class NovaVerticalSlider : public QWidget
+{
+public:
+    NovaVerticalSlider(KisDoubleSliderSpinBox *spin, const QString &name, qreal exponent, QWidget *parent)
+        : QWidget(parent), m_spin(spin), m_name(name), m_exponent(exponent)
+    {
+        setToolTip(name);
+        setMinimumSize(45, 110);
+        setSizePolicy(QSizePolicy::Fixed, QSizePolicy::Expanding);
+        connect(spin, QOverload<double>::of(&QDoubleSpinBox::valueChanged), this, [this]() { update(); });
+        // the brush toolbar updates its sliders with signals blocked on preset
+        // changes: also repaint when the value changed behind our back
+        m_poll.setInterval(250);
+        connect(&m_poll, &QTimer::timeout, this, [this]() {
+            if (m_spin && isVisible() && !qFuzzyCompare(m_spin->value() + 1.0, m_painted + 1.0)) update();
+        });
+        m_poll.start();
+    }
+
+    QSize sizeHint() const override { return QSize(45, 200); }
+
+protected:
+    qreal toPos(qreal v) const
+    {
+        const qreal lo = m_spin->minimum(), hi = m_spin->maximum();
+        if (hi <= lo) return 0.0;
+        return std::pow(qBound(0.0, (v - lo) / (hi - lo), 1.0), 1.0 / m_exponent);
+    }
+    qreal fromPos(qreal pos) const
+    {
+        const qreal lo = m_spin->minimum(), hi = m_spin->maximum();
+        return lo + std::pow(qBound(0.0, pos, 1.0), m_exponent) * (hi - lo);
+    }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        if (!m_spin) return;
+        m_painted = m_spin->value();
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const QRectF track = QRectF(rect()).adjusted(3, 2, -3, -2);
+        const qreal radius = 4.0;
+        QPainterPath clip;
+        clip.addRoundedRect(track, radius, radius);
+        p.fillPath(clip, palette().color(QPalette::Base).darker(115));
+        const qreal pos = toPos(m_painted);
+        QRectF fill = track;
+        fill.setTop(track.bottom() - track.height() * pos);
+        p.save();
+        p.setClipPath(clip);
+        p.fillRect(fill, isEnabled() ? palette().color(QPalette::WindowText).darker(120)
+                                     : palette().color(QPalette::Mid));
+        p.restore();
+        if (m_dragging) {
+            const QString text = QString(m_spin->prefix() + QLocale().toString(m_painted, 'f', m_spin->decimals())
+                                         + m_spin->suffix()).trimmed();
+            QFont f = font();
+            f.setPointSizeF(qMax(6.0, f.pointSizeF() * 0.8));
+            p.setFont(f);
+            const QRectF label(track.left(), track.top() + 4, track.width(), QFontMetricsF(f).height() * 2.2);
+            p.setPen(pos > 0.85 ? palette().color(QPalette::Window) : palette().color(QPalette::WindowText));
+            p.drawText(label, Qt::AlignHCenter | Qt::AlignTop | Qt::TextWrapAnywhere, text);
+        }
+    }
+
+    void mousePressEvent(QMouseEvent *e) override
+    {
+        if (e->button() != Qt::LeftButton || !m_spin) return;
+        m_dragging = true;
+        m_pressY = e->pos().y();
+        m_pressPos = toPos(m_spin->value());
+        update();
+    }
+    void mouseMoveEvent(QMouseEvent *e) override
+    {
+        if (!m_dragging || !m_spin) return;
+        const qreal span = qMax(40.0, height() - 6.0);
+        const qreal pos = m_pressPos + (m_pressY - e->pos().y()) / span;
+        m_spin->setValue(fromPos(pos)); // the brush toolbar applies it
+        update();
+    }
+    void mouseReleaseEvent(QMouseEvent *) override
+    {
+        m_dragging = false;
+        update();
+    }
+
+private:
+    QPointer<KisDoubleSliderSpinBox> m_spin;
+    QString m_name;
+    qreal m_exponent {1.0};
+    QTimer m_poll;
+    qreal m_painted {0.0};
+    bool m_dragging {false};
+    int m_pressY {0};
+    qreal m_pressPos {0.0};
+};
+
+/// Turn the brush toolbar's horizontal groups into a narrow column with
+/// vertical size and opacity sliders (done once per toolbar).
+void adaptBrushToolBarForPanel(KisToolBar *toolBar, QMainWindow *mainWindow)
+{
+    if (toolBar->property("_kritanova_panel").toBool()) return;
+    toolBar->setProperty("_kritanova_panel", true);
+
+    // Mirror/wrap, layouts and workspaces go to the top bar, next to New/Open/Save;
+    // the spacer that pushed layouts/workspaces to the far end goes away.
+    if (KisToolBar *topBar = mainWindow->findChild<KisToolBar *>(QStringLiteral("mainToolBar"))) {
+        bool separatorAdded = false;
+        Q_FOREACH (QAction *action, toolBar->actions()) {
+            const QString name = action->objectName();
+            if (name == QLatin1String("mirror_actions") || name == QLatin1String("select_layout")
+                || name == QLatin1String("workspaces")) {
+                toolBar->removeAction(action);
+                if (!separatorAdded) {
+                    topBar->addSeparator();
+                    separatorAdded = true;
+                }
+                topBar->addAction(action);
+            } else if (name.startsWith(QLatin1String("expanding_spacer"))) {
+                action->setVisible(false);
+            }
+        }
+
+        // Image size, canvas rotation and zoom from the status bar (KisStatusBar
+        // parks them in this widget on Android), at the right end of the top bar
+        if (QWidget *statusItems = mainWindow->findChild<QWidget *>(QStringLiteral("KritaNovaStatusItems"))) {
+            QWidget *spacer = new QWidget(topBar);
+            spacer->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
+            topBar->addWidget(spacer);
+            topBar->addWidget(statusItems);
+            statusItems->show();
+        }
+    }
+
+    // Size and opacity are the panel's own vertical sliders
+    Q_FOREACH (QAction *action, toolBar->actions()) {
+        if (action->objectName() == QLatin1String("brushslider1") ||
+            action->objectName() == QLatin1String("brushslider2")) {
+            action->setVisible(false);
+        }
+    }
+}
+
+/// Size (top) and opacity (bottom) as tall vertical sliders, bound to the
+/// brush toolbar's first slider chooser
+QWidget *createBrushSliders(QMainWindow *mainWindow, QWidget *parent)
+{
+    KisWidgetChooser *sliderChooser = nullptr;
+    if (KisToolBar *toolBar = mainWindow->findChild<KisToolBar *>(QStringLiteral("BrushesAndStuff"))) {
+        Q_FOREACH (QAction *action, toolBar->actions()) {
+            if (action->objectName() == QLatin1String("brushslider1")) {
+                if (QWidgetAction *widgetAction = qobject_cast<QWidgetAction *>(action)) {
+                    sliderChooser = qobject_cast<KisWidgetChooser *>(widgetAction->defaultWidget());
+                }
+            }
+        }
+    }
+
+    QWidget *sliders = new QWidget(parent);
+    sliders->setObjectName(QStringLiteral("KritaNovaVerticalSliders"));
+    QVBoxLayout *layout = new QVBoxLayout(sliders);
+    layout->setContentsMargins(0, 2, 0, 2);
+    layout->setSpacing(8);
+    if (sliderChooser) {
+        KisDoubleSliderSpinBox *size = sliderChooser->getWidget<KisDoubleSliderSpinBox>("size");
+        KisDoubleSliderSpinBox *opacity = sliderChooser->getWidget<KisDoubleSliderSpinBox>("opacity");
+        if (size) layout->addWidget(new NovaVerticalSlider(size, i18n("Size"), 3.0, sliders), 1, Qt::AlignHCenter);
+        if (opacity) layout->addWidget(new NovaVerticalSlider(opacity, i18n("Opacity"), 1.0, sliders), 1, Qt::AlignHCenter);
+    }
+    sliders->setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Expanding);
+    return sliders;
+}
+
+/**
+ * Small round button at the bottom of the Brush Panel: shows the foreground
+ * colour; tapping it switches to the Color Sampler tool, and after one sample
+ * on the canvas Krita switches back to the tool that was active before.
+ * Tapping it again while armed cancels.
+ */
+class NovaColorSamplerButton : public QAbstractButton
+{
+public:
+    NovaColorSamplerButton(KisViewManager *viewManager, QWidget *parent)
+        : QAbstractButton(parent), m_viewManager(viewManager)
+    {
+        setToolTip(i18n("Sample a color, then return to the previous tool"));
+        setFixedSize(34, 34);
+        setCursor(Qt::PointingHandCursor);
+        connect(this, &QAbstractButton::clicked, this, [this]() { toggleArmed(); });
+        if (KisCanvasResourceProvider *resources = m_viewManager->canvasResourceProvider()) {
+            connect(resources, &KisCanvasResourceProvider::sigFGColorChanged, this, [this]() { update(); });
+        }
+        if (toolManager()) connect(toolManager(), &KoToolManager::changedTool, this, [this]() {
+            // the user picked another tool by hand: nothing to switch back from
+            if (m_armed && toolManager() && toolManager()->activeToolId() != samplerId()) {
+                disarm(false);
+            }
+        });
+    }
+
+    QSize sizeHint() const override { return QSize(34, 34); }
+
+protected:
+    KoToolManager *toolManager() const
+    {
+        return m_viewManager ? m_viewManager->toolManager() : nullptr;
+    }
+
+    static QString samplerId() { return QStringLiteral("KritaSelected/KisToolColorSampler"); }
+
+    void toggleArmed()
+    {
+        if (m_armed) {
+            disarm(true);
+            return;
+        }
+        KoToolManager *tools = toolManager();
+        if (!tools) return;
+        m_previousTool = tools->activeToolId();
+        if (m_previousTool == samplerId()) m_previousTool.clear();
+        m_armed = true;
+        qApp->installEventFilter(this);
+        tools->switchToolRequested(samplerId());
+        update();
+    }
+
+    void disarm(bool switchBack)
+    {
+        if (!m_armed) return;
+        m_armed = false;
+        qApp->removeEventFilter(this);
+        if (switchBack && !m_previousTool.isEmpty() && toolManager()
+            && toolManager()->activeToolId() == samplerId()) {
+            toolManager()->switchToolRequested(m_previousTool);
+        }
+        update();
+    }
+
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (m_armed && (event->type() == QEvent::TabletRelease || event->type() == QEvent::MouseButtonRelease
+                        || event->type() == QEvent::TouchEnd)) {
+            KisCanvas2 *canvas = m_viewManager ? m_viewManager->canvasBase() : nullptr;
+            QWidget *canvasWidget = canvas ? canvas->canvasWidget() : nullptr;
+            QWidget *target = qobject_cast<QWidget *>(watched);
+            if (canvasWidget && target && (target == canvasWidget || canvasWidget->isAncestorOf(target))) {
+                // let the sampler finish handling this release first
+                QTimer::singleShot(0, this, [this]() { disarm(true); });
+            }
+        }
+        return QAbstractButton::eventFilter(watched, event);
+    }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        QColor color = palette().color(QPalette::WindowText);
+        if (m_viewManager && m_viewManager->canvasResourceProvider()) {
+            color = m_viewManager->canvasResourceProvider()->fgColor().toQColor();
+        }
+        const QRectF r = QRectF(rect()).adjusted(4, 4, -4, -4);
+        p.setBrush(color);
+        p.setPen(QPen(m_armed ? palette().color(QPalette::Highlight) : palette().color(QPalette::WindowText),
+                      m_armed ? 3.0 : 1.5));
+        p.drawEllipse(r);
+    }
+
+private:
+    QPointer<KisViewManager> m_viewManager;
+    QString m_previousTool;
+    bool m_armed {false};
+};
+
+class BrushPanelToolBarKeeper : public QObject
+{
+public:
+    BrushPanelToolBarKeeper(QMainWindow *mainWindow, QWidget *container)
+        : QObject(container), m_mainWindow(mainWindow), m_container(container)
+    {
+    }
+
+    std::function<void()> onToolBarShown;
+
+    void relocate()
+    {
+        if (!m_mainWindow || !m_container) return;
+        m_busy = true;
+        // undo/redo: top of the panel column; the rest of the brush toolbar:
+        // the "more" (3 dots) popup, as a normal horizontal toolbar
+        // and the main toolbar: the top bar dock (so the Toolbox docker can share its row)
+        struct Target { const char *name; QWidget *parent; Qt::Orientation orientation; bool stretch; };
+        const Target targets[] = {
+            {"editToolBar", m_container, Qt::Vertical, false},
+            {"BrushesAndStuff", m_moreContainer ? m_moreContainer.data() : m_container.data(), Qt::Horizontal, false},
+            {"mainToolBar", m_topBarContainer, Qt::Horizontal, true},
+        };
+        for (const Target &target : targets) {
+            KisToolBar *toolBar = m_mainWindow->findChild<KisToolBar *>(QLatin1String(target.name));
+            if (!toolBar || !target.parent) continue;
+            if (!m_watched.contains(toolBar)) {
+                toolBar->installEventFilter(this);
+                m_watched.append(toolBar);
+            }
+            // QMainWindow::restoreState() (startup, workspaces) puts toolbars it
+            // knows back into its toolbar layout WITHOUT reparenting them: the
+            // toolbar then sits in our panel but is positioned by the main
+            // window (invisible here, and a ghost entry that keeps the top bar
+            // from stretching). Take it out of the main window's layout again.
+            if (m_mainWindow->toolBarArea(toolBar) != Qt::NoToolBarArea) {
+                m_mainWindow->removeToolBar(toolBar);
+            }
+            QBoxLayout *layout = static_cast<QBoxLayout *>(target.parent->layout());
+            if (toolBar->parentWidget() != target.parent) {
+                toolBar->setParent(target.parent);
+            }
+            if (layout->indexOf(toolBar) < 0) {
+                if (target.stretch) {
+                    layout->insertWidget(0, toolBar, 1);
+                } else {
+                    layout->insertWidget(0, toolBar, 0, Qt::AlignCenter);
+                }
+            }
+            toolBar->setOrientation(target.orientation);
+            toolBar->setMovable(false);
+            toolBar->setFloatable(false);
+            if (toolBar->objectName() == QLatin1String("BrushesAndStuff")) {
+                adaptBrushToolBarForPanel(toolBar, m_mainWindow);
+                moveColorsToPanel(toolBar);
+            }
+            toolBar->show();
+        }
+        m_busy = false;
+    }
+
+    /// the foreground/background color squares ("dual") go to the panel itself
+    void moveColorsToPanel(KisToolBar *toolBar)
+    {
+        if (!m_colorSlot) return;
+        Q_FOREACH (QAction *action, toolBar->actions()) {
+            if (action->objectName() != QLatin1String("dual")) continue;
+            QWidgetAction *widgetAction = qobject_cast<QWidgetAction *>(action);
+            QWidget *colors = widgetAction ? widgetAction->defaultWidget() : nullptr;
+            toolBar->removeAction(action); // releases the widget
+            if (colors) {
+                m_colorSlot->layout()->addWidget(colors);
+                m_colorSlot->layout()->setAlignment(colors, Qt::AlignHCenter);
+                colors->show();
+            }
+        }
+        // the separators that framed it in the toolbar are no longer needed
+        QAction *previous = nullptr;
+        Q_FOREACH (QAction *action, toolBar->actions()) {
+            if (action->isSeparator() && previous && previous->isSeparator()) {
+                toolBar->removeAction(action);
+                continue;
+            }
+            previous = action;
+        }
+    }
+
+    void setMoreContainer(QWidget *container) { m_moreContainer = container; }
+    void setColorSlot(QWidget *slot) { m_colorSlot = slot; }
+    void setTopBarContainer(QWidget *container) { m_topBarContainer = container; }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        const QEvent::Type type = event->type();
+        if (type == QEvent::ShowToParent && !m_busy && onToolBarShown
+            && watched->objectName() != QLatin1String("mainToolBar")) {
+            // "Show ... Toolbar" for a toolbar of a hidden panel: show the panel
+            QWidget *dock = m_container ? m_container->parentWidget() : nullptr;
+            if (dock && dock->isHidden()) {
+                QTimer::singleShot(0, this, [this]() { if (onToolBarShown) onToolBarShown(); });
+            }
+        }
+        const bool suspicious = type == QEvent::ParentChange || type == QEvent::Move
+            || (type == QEvent::Hide && static_cast<QWidget *>(watched)->isHidden());
+        if (suspicious && !m_busy && !m_pending) {
+            m_pending = true;
+            QTimer::singleShot(0, this, [this]() {
+                m_pending = false;
+                relocate();
+            });
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+private:
+    QPointer<QMainWindow> m_mainWindow;
+    QPointer<QWidget> m_container;
+    QPointer<QWidget> m_moreContainer;
+    QPointer<QWidget> m_colorSlot;
+    QPointer<QWidget> m_topBarContainer;
+    QList<QPointer<KisToolBar>> m_watched;
+    bool m_busy {false};
+    bool m_pending {false};
+};
+
+/**
+ * Puts the Brush Panel on screen after the main window has been shown (and
+ * startup has restored the window state): floating, at the left edge, tall,
+ * the first time or whenever it ended up off screen; afterwards just shown
+ * where it was. Closing it with its title bar button hides it for the
+ * session; Settings > Toolbars Shown brings it back.
+ */
+class BrushPanelShower : public QObject
+{
+public:
+    BrushPanelShower(QMainWindow *mainWindow, QDockWidget *dock, BrushPanelToolBarKeeper *keeper,
+                     QStackedWidget *mainStack)
+        : QObject(dock), m_mainWindow(mainWindow), m_dock(dock), m_keeper(keeper), m_stack(mainStack)
+    {
+        // Like the dockers: hidden on the welcome page (stack index 0), shown
+        // once an image is open.
+        if (mainStack) {
+            connect(mainStack, &QStackedWidget::currentChanged, this, [this](int index) {
+                m_stackChanged.start();
+                if (index == 0) {
+                    if (m_dock) m_dock->hide();
+                } else {
+                    // after Krita has restored the window layout for the canvas
+                    for (int delay : {0, 500}) {
+                        QTimer::singleShot(delay, this, [this]() { place(false); });
+                    }
+                }
+            });
+        }
+        mainWindow->installEventFilter(this);
+        if (mainWindow->isVisible()) schedule();
+        // The panel is always floating: restoreState() may dock it again.
+        connect(dock, &QDockWidget::topLevelChanged, this, [this](bool floating) {
+            if (!floating) QTimer::singleShot(0, this, [this]() { place(true); });
+        });
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (watched == m_mainWindow && event->type() == QEvent::Show) {
+            schedule();
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+public:
+    /// Closed with its × or unticked in Settings: stays hidden until asked for
+    void hideByUser()
+    {
+        m_userHidden = true;
+        if (m_dock) m_dock->hide();
+    }
+
+    /// One of the panel's toolbars was switched on while the panel is hidden.
+    /// Krita itself re-shows toolbars when it leaves the welcome page; that is
+    /// not a request from the user, so ignore it.
+    void toolBarShown()
+    {
+        if (m_stackChanged.isValid() && m_stackChanged.elapsed() < 1500) return;
+        showPanel();
+    }
+
+    /// Bring the panel back: floating, on screen, in front
+    void showPanel()
+    {
+        m_userHidden = false;
+        if (!m_dock || !m_mainWindow) return;
+        if (m_keeper) m_keeper->relocate();
+        place(false);
+        m_dock->activateWindow();
+    }
+
+private:
+    void schedule()
+    {
+        if (m_done || !m_mainWindow) return;
+        m_done = true;
+        m_mainWindow->removeEventFilter(this);
+        // after the rest of startup (workspace restore, first view) has run;
+        // checked again a little later in case something restores the layout late
+        for (int delay : {400, 2000, 6000}) {
+            QTimer::singleShot(delay, this, [this]() { place(false); });
+        }
+    }
+
+    bool onWelcomePage() const
+    {
+        return m_stack && m_stack->currentIndex() == 0;
+    }
+
+    void place(bool force)
+    {
+        if (!m_dock || !m_mainWindow) return;
+        if (m_userHidden || onWelcomePage()) {
+            m_dock->hide();
+            return;
+        }
+        if (m_keeper) m_keeper->relocate();
+        const QRect area = m_mainWindow->geometry();
+        QScreen *screen = m_mainWindow->screen();
+        const QRect available = screen ? screen->availableGeometry() : area;
+
+        KisConfig cfg(true);
+        const bool placedBefore = cfg.readEntry("androidBrushPanelPlaced4", false);
+        const bool onScreen = m_dock->isFloating() && m_dock->width() > 20 && m_dock->height() > 100
+                              && available.intersects(m_dock->frameGeometry());
+
+        if (force || !placedBefore || !onScreen) {
+            m_dock->setFloating(true);
+            m_dock->adjustSize();
+            // as narrow as the sliders allow; a bit taller so the color squares
+            // and the sampler button have room at the bottom
+            const int width = qMax(m_dock->sizeHint().width(), 52);
+            const int height = qMax(320, int(area.height() * 0.66));
+            const int top = area.top() + (area.height() - height) / 2;
+            m_dock->setGeometry(area.left() + 8, top, width, height);
+            KisConfig(false).writeEntry("androidBrushPanelPlaced4", true);
+        }
+        m_dock->show();
+        m_dock->raise();
+    }
+
+    QPointer<QMainWindow> m_mainWindow;
+    QPointer<QDockWidget> m_dock;
+    QPointer<BrushPanelToolBarKeeper> m_keeper;
+    QPointer<QStackedWidget> m_stack;
+    bool m_userHidden {false};
+    bool m_done {false};
+    QElapsedTimer m_stackChanged;
+};
+
+/**
+ * Rounded corners and a grey outline for a floating window (the Brush Panel
+ * and its "more" popup). The window gets a translucent background and this
+ * filter paints the rounded panel instead of the widget's own background and
+ * frame; the children paint on top of it as usual.
+ */
+class RoundedPanelPainter : public QObject
+{
+public:
+    static void install(QWidget *window, qreal radius = 8.0)
+    {
+        window->setAttribute(Qt::WA_TranslucentBackground, true);
+        window->setAutoFillBackground(false);
+        window->installEventFilter(new RoundedPanelPainter(window, radius));
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (event->type() != QEvent::Paint) return false;
+        QWidget *widget = static_cast<QWidget *>(watched);
+        QPainter p(widget);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        p.setCompositionMode(QPainter::CompositionMode_Source);
+        p.fillRect(widget->rect(), Qt::transparent);
+        p.setCompositionMode(QPainter::CompositionMode_SourceOver);
+
+        QColor outline = widget->palette().color(QPalette::WindowText);
+        outline.setAlpha(110); // grey on dark and on light themes
+        const qreal pen = 1.5;
+        const QRectF r = QRectF(widget->rect()).adjusted(pen / 2, pen / 2, -pen / 2, -pen / 2);
+        p.setPen(QPen(outline, pen));
+        p.setBrush(widget->palette().color(QPalette::Window));
+        p.drawRoundedRect(r, m_radius, m_radius);
+        return true; // no square background or frame from the widget itself
+    }
+
+private:
+    RoundedPanelPainter(QObject *parent, qreal radius) : QObject(parent), m_radius(radius) {}
+    qreal m_radius {8.0};
+};
+
+/**
+ * Closes the "more" popup on any press outside it. Qt closes popups on mouse
+ * presses only; on the canvas (which takes touch and tablet events itself)
+ * a tap with a finger or the pen did not close it. Also clears the 3-dot
+ * button's pressed/hover highlight when the popup goes away (touch input
+ * never sends the "leave" event that would clear it).
+ */
+class MorePopupCloser : public QObject
+{
+public:
+    MorePopupCloser(QWidget *popup, KisPopupButton *button)
+        : QObject(popup), m_popup(popup), m_button(button)
+    {
+        popup->installEventFilter(this);
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (watched == m_popup) {
+            if (event->type() == QEvent::Show) {
+                qApp->installEventFilter(this);
+            } else if (event->type() == QEvent::Hide) {
+                qApp->removeEventFilter(this);
+                QTimer::singleShot(0, this, [this]() { clearButtonHighlight(); });
+            }
+            return false;
+        }
+
+        const QEvent::Type type = event->type();
+        if (type != QEvent::MouseButtonPress && type != QEvent::TabletPress
+            && type != QEvent::TouchBegin) {
+            return false;
+        }
+        QWidget *target = qobject_cast<QWidget *>(watched);
+        if (!target || !m_popup || !m_popup->isVisible()) return false;
+
+        // inside the popup, or one of its own popups (blending mode list,
+        // brush editor, presets...): keep it open
+        if (target->window() == m_popup || m_popup->isAncestorOf(target)) return false;
+        for (QWidget *w = target->window()->parentWidget(); w; w = w->parentWidget()) {
+            if (w == m_popup) return false;
+        }
+        // the 3-dot button toggles the popup itself
+        if (m_button && (target == m_button || m_button->isAncestorOf(target))) return false;
+
+        m_popup->hide();
+        return false; // the press still reaches what was tapped
+    }
+
+private:
+    void clearButtonHighlight()
+    {
+        if (!m_button) return;
+        m_button->setDown(false);
+        QEvent leave(QEvent::Leave);
+        QApplication::sendEvent(m_button, &leave);
+        m_button->setAttribute(Qt::WA_UnderMouse, false);
+        m_button->update();
+    }
+
+    QPointer<QWidget> m_popup;
+    QPointer<KisPopupButton> m_button;
+};
+
+/// Title bar of the Brush Panel: an empty strip with a small grip mark.
+/// Mouse events are not accepted, so QDockWidget moves the panel.
+class NovaPanelGrip : public QWidget
+{
+public:
+    explicit NovaPanelGrip(QWidget *parent) : QWidget(parent)
+    {
+        setFixedHeight(20);
+        setToolTip(i18n("Drag to move"));
+    }
+    QSize sizeHint() const override { return QSize(40, 20); }
+
+protected:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        QColor c = palette().color(QPalette::WindowText);
+        c.setAlpha(110);
+        p.setPen(Qt::NoPen);
+        p.setBrush(c);
+        const QRectF grip(width() / 2.0 - 12, height() / 2.0 - 1.5, 24, 3);
+        p.drawRoundedRect(grip, 1.5, 1.5);
+    }
+};
+
+/**
+ * The main toolbar (New/Open/Save, mirror/wrap, layouts, workspaces, image
+ * size/rotation/zoom) lives in a fixed, title-less dock in the top dock area
+ * instead of the toolbar area. Dock widgets can share a row, toolbar areas and
+ * dock areas can't: this lets the Toolbox docker sit on the same line.
+ */
+QDockWidget *createAndroidTopBarDock(QMainWindow *mainWindow)
+{
+    QDockWidget *dock = new QDockWidget(i18nc("@title:window", "Top Bar"), mainWindow);
+    dock->setObjectName(QStringLiteral("KritaNovaTopBar"));
+    KAcceleratorManager::setNoAccel(dock);
+    dock->setFeatures(QDockWidget::NoDockWidgetFeatures);
+    dock->setAllowedAreas(Qt::TopDockWidgetArea);
+    dock->setTitleBarWidget(new QWidget(dock)); // no title bar
+    QWidget *container = new QWidget(dock);
+    QHBoxLayout *layout = new QHBoxLayout(container);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(0);
+    dock->setWidget(container);
+    mainWindow->addDockWidget(Qt::TopDockWidgetArea, dock);
+    dock->show();
+    return dock;
+}
+
+/**
+ * Once after startup: if the Toolbox docker is docked at the top, put it on
+ * the top bar's row (to its right). Later the user can move the Toolbox
+ * anywhere; dropping it on the left/right part of the top bar puts it on the
+ * same row again.
+ */
+class TopRowArranger : public QObject
+{
+public:
+    TopRowArranger(QMainWindow *mainWindow, QDockWidget *topBar)
+        : QObject(topBar), m_mainWindow(mainWindow), m_topBar(topBar)
+    {
+        mainWindow->installEventFilter(this);
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (watched == m_mainWindow && event->type() == QEvent::Show && m_mainWindow) {
+            m_mainWindow->removeEventFilter(this);
+            QTimer::singleShot(600, this, [this]() { arrange(); });
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+private:
+    void arrange()
+    {
+        if (!m_mainWindow || !m_topBar) return;
+        m_topBar->show();
+        if (KisConfig(true).readEntry("androidToolboxRowArranged", false)) return;
+        QDockWidget *toolbox = m_mainWindow->findChild<QDockWidget *>(QStringLiteral("ToolBox"));
+        if (!toolbox || toolbox->isFloating()
+            || m_mainWindow->dockWidgetArea(toolbox) != Qt::TopDockWidgetArea) {
+            return;
+        }
+        m_mainWindow->splitDockWidget(m_topBar, toolbox, Qt::Horizontal);
+        KisConfig(false).writeEntry("androidToolboxRowArranged", true);
+    }
+
+    QPointer<QMainWindow> m_mainWindow;
+    QPointer<QDockWidget> m_topBar;
+};
+
+QDockWidget *createAndroidBrushPanel(QMainWindow *mainWindow, KisViewManager *viewManager, QStackedWidget *mainStack)
+{
+    QDockWidget *topBar = createAndroidTopBarDock(mainWindow);
+    new TopRowArranger(mainWindow, topBar);
+
+    QDockWidget *dock = new QDockWidget(i18nc("@title:window", "Brush Panel"), mainWindow);
+    dock->setObjectName(QStringLiteral("KritaNovaBrushPanel"));
+    KAcceleratorManager::setNoAccel(dock); // no "&" in the title
+    dock->setAllowedAreas(Qt::NoDockWidgetArea); // floating only
+    dock->setFeatures(QDockWidget::DockWidgetMovable | QDockWidget::DockWidgetFloatable
+                      | QDockWidget::DockWidgetClosable);
+    // Title + close button only: Krita's docker title bar adds float/dock and
+    // lock buttons, which on this always-floating panel could dock or lock it
+    // with no way back. Dragging the title bar still moves the panel.
+    // No title and no close button, just a grip to drag the panel by (hide it
+    // with Settings > Toolbars Shown > Brush Panel). The top few pixels of a
+    // floating panel resize it (patch 14), so the grip is tall enough to have
+    // room to move it below that.
+    QWidget *titleBar = new NovaPanelGrip(dock);
+    RoundedPanelPainter::install(dock);
+    dock->setTitleBarWidget(titleBar);
+
+    // Column, everything centered: undo, redo | more (3 dots) | size | opacity | color sampler
+    QWidget *container = new QWidget(dock);
+    QVBoxLayout *layout = new QVBoxLayout(container);
+    layout->setContentsMargins(3, 2, 3, 8); // thin sides, room at the bottom
+    layout->setSpacing(4);
+    dock->setWidget(container);
+
+    // "More": everything else of the brush toolbar (gradient, pattern, colors,
+    // brush editor, presets, blending mode, alpha lock, reload) in a popup
+    QWidget *moreContent = new QWidget();
+    QHBoxLayout *moreLayout = new QHBoxLayout(moreContent);
+    moreLayout->setContentsMargins(6, 4, 4, 4);
+    moreLayout->setSpacing(6);
+    KisPopupButton *moreButton = new KisPopupButton(container);
+    moreButton->setObjectName(QStringLiteral("KritaNovaBrushPanelMore"));
+    moreButton->setIcon(KisIconUtils::loadIcon("hamburger_menu_dots"));
+    moreButton->setToolTip(i18n("More brush options"));
+    moreButton->setAutoRaise(true);
+    moreButton->setArrowVisible(false);
+    moreButton->setFixedSize(36, 36);
+    moreButton->setIconSize(QSize(22, 22));
+    moreButton->setPopupWidget(moreContent);
+    // no title bar and no box border (drawn white on dark themes): the popup
+    // is one row, "brush toolbar | x"
+    if (QFrame *frame = qobject_cast<QFrame *>(moreContent->parentWidget())) {
+        frame->setFrameStyle(QFrame::NoFrame);
+        // no white platform frame around it either (Krita's Android Qt adds one
+        // to decorated windows)
+        frame->setWindowFlag(Qt::FramelessWindowHint, true);
+        RoundedPanelPainter::install(frame);
+        new MorePopupCloser(frame, moreButton);
+    }
+    {
+        QFrame *separator = new QFrame(moreContent);
+        separator->setFrameShape(QFrame::VLine);
+        separator->setFrameShadow(QFrame::Plain);
+        separator->setFixedHeight(24);
+        QToolButton *closeMore = new QToolButton(moreContent);
+        closeMore->setAutoRaise(true);
+        closeMore->setIcon(KisIconUtils::loadIcon("window-close"));
+        closeMore->setToolTip(i18nc("@info:tooltip", "Close"));
+        closeMore->setFixedSize(30, 30);
+        QObject::connect(closeMore, &QToolButton::clicked, moreButton, &KisPopupButton::hidePopupWidget);
+        moreLayout->addWidget(separator, 0, Qt::AlignVCenter);
+        moreLayout->addWidget(closeMore, 0, Qt::AlignVCenter);
+    }
+    // the popup is sized from its content: lay the toolbar out before it is placed
+    QObject::connect(moreButton, &KisPopupButton::sigPopupWidgetShown, moreContent, [moreContent]() {
+        moreContent->adjustSize();
+    });
+    layout->addWidget(moreButton, 0, Qt::AlignHCenter);
+
+    mainWindow->addDockWidget(Qt::LeftDockWidgetArea, dock);
+
+    BrushPanelToolBarKeeper *keeper = new BrushPanelToolBarKeeper(mainWindow, container);
+    keeper->setMoreContainer(moreContent);
+    keeper->setTopBarContainer(topBar->widget());
+    keeper->relocate(); // undo/redo land above the "more" button
+
+    layout->addWidget(createBrushSliders(mainWindow, container), 1, Qt::AlignHCenter);
+
+    // foreground/background colors, taken out of the brush toolbar
+    QWidget *colorSlot = new QWidget(container);
+    colorSlot->setObjectName(QStringLiteral("KritaNovaBrushPanelColors"));
+    QVBoxLayout *colorLayout = new QVBoxLayout(colorSlot);
+    colorLayout->setContentsMargins(0, 8, 0, 4);
+    layout->addWidget(colorSlot, 0, Qt::AlignHCenter);
+    keeper->setColorSlot(colorSlot);
+    keeper->relocate();
+
+    // colour sampler button at the bottom of the panel
+    layout->addWidget(new NovaColorSamplerButton(viewManager, container), 0, Qt::AlignHCenter);
+
+    // Show it once the main window is on screen: a floating dock is a window
+    // of its own and is not shown along with the main window, and the saved
+    // window state / workspace restored during startup may hide or re-dock it.
+    BrushPanelShower *shower = new BrushPanelShower(mainWindow, dock, keeper, mainStack);
+    keeper->onToolBarShown = [shower]() { shower->toolBarShown(); };
+
+
+    // Settings > Toolbars Shown > Brush Panel: also put it back on screen
+    QAction *toggle = dock->toggleViewAction();
+    toggle->setText(i18n("Brush Panel"));
+    QObject::connect(toggle, &QAction::triggered, shower, [shower](bool checked) {
+        if (checked) {
+            QTimer::singleShot(0, shower, [shower]() { shower->showPanel(); });
+        } else {
+            shower->hideByUser();
+        }
+    });
+    return dock;
+}
