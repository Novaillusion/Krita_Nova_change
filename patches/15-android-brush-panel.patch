+/**
+ * Krita Nova: on Android the "Edit" (undo/redo) and "Brushes and Stuff"
+ * toolbars live in a floating vertical panel instead of the top bar, which
+ * keeps only New/Open/Save.
+ *
+ * The toolbars are still the XMLGUI-managed KisToolBar objects (so toolbar
+ * configuration keeps working); they are just reparented into the panel and
+ * turned vertical. QMainWindow::restoreState() (window settings, workspaces)
+ * puts toolbars it knows back into the toolbar areas; a ParentChange filter
+ * moves them into the panel again.
+ */
+/**
+ * Tall vertical slider bound to one of the brush toolbar's slider spin boxes
+ * (size or opacity). Drag up/down to change the value (relative to where the
+ * drag started, so touching it doesn't make the value jump); the fill grows
+ * from the bottom. The value is shown while dragging.
+ */
+class NovaVerticalSlider : public QWidget
+{
+public:
+    NovaVerticalSlider(KisDoubleSliderSpinBox *spin, const QString &name, qreal exponent, QWidget *parent)
+        : QWidget(parent), m_spin(spin), m_name(name), m_exponent(exponent)
+    {
+        setToolTip(name);
+        setMinimumSize(30, 160);
+        setSizePolicy(QSizePolicy::Fixed, QSizePolicy::Expanding);
+        connect(spin, QOverload<double>::of(&QDoubleSpinBox::valueChanged), this, [this]() { update(); });
+        // the brush toolbar updates its sliders with signals blocked on preset
+        // changes: also repaint when the value changed behind our back
+        m_poll.setInterval(250);
+        connect(&m_poll, &QTimer::timeout, this, [this]() {
+            if (m_spin && isVisible() && !qFuzzyCompare(m_spin->value() + 1.0, m_painted + 1.0)) update();
+        });
+        m_poll.start();
+    }
+
+    QSize sizeHint() const override { return QSize(32, 260); }
+
+protected:
+    qreal toPos(qreal v) const
+    {
+        const qreal lo = m_spin->minimum(), hi = m_spin->maximum();
+        if (hi <= lo) return 0.0;
+        return std::pow(qBound(0.0, (v - lo) / (hi - lo), 1.0), 1.0 / m_exponent);
+    }
+    qreal fromPos(qreal pos) const
+    {
+        const qreal lo = m_spin->minimum(), hi = m_spin->maximum();
+        return lo + std::pow(qBound(0.0, pos, 1.0), m_exponent) * (hi - lo);
+    }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        if (!m_spin) return;
+        m_painted = m_spin->value();
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const QRectF track = QRectF(rect()).adjusted(3, 2, -3, -2);
+        const qreal radius = 4.0;
+        QPainterPath clip;
+        clip.addRoundedRect(track, radius, radius);
+        p.fillPath(clip, palette().color(QPalette::Base).darker(115));
+        const qreal pos = toPos(m_painted);
+        QRectF fill = track;
+        fill.setTop(track.bottom() - track.height() * pos);
+        p.save();
+        p.setClipPath(clip);
+        p.fillRect(fill, isEnabled() ? palette().color(QPalette::WindowText).darker(120)
+                                     : palette().color(QPalette::Mid));
+        p.restore();
+        if (m_dragging) {
+            const QString text = QString(m_spin->prefix() + QLocale().toString(m_painted, 'f', m_spin->decimals())
+                                         + m_spin->suffix()).trimmed();
+            QFont f = font();
+            f.setPointSizeF(qMax(6.0, f.pointSizeF() * 0.8));
+            p.setFont(f);
+            const QRectF label(track.left(), track.top() + 4, track.width(), QFontMetricsF(f).height() * 2.2);
+            p.setPen(pos > 0.85 ? palette().color(QPalette::Window) : palette().color(QPalette::WindowText));
+            p.drawText(label, Qt::AlignHCenter | Qt::AlignTop | Qt::TextWrapAnywhere, text);
+        }
+    }
+
+    void mousePressEvent(QMouseEvent *e) override
+    {
+        if (e->button() != Qt::LeftButton || !m_spin) return;
+        m_dragging = true;
+        m_pressY = e->pos().y();
+        m_pressPos = toPos(m_spin->value());
+        update();
+    }
+    void mouseMoveEvent(QMouseEvent *e) override
+    {
+        if (!m_dragging || !m_spin) return;
+        const qreal span = qMax(40.0, height() - 6.0);
+        const qreal pos = m_pressPos + (m_pressY - e->pos().y()) / span;
+        m_spin->setValue(fromPos(pos)); // the brush toolbar applies it
+        update();
+    }
+    void mouseReleaseEvent(QMouseEvent *) override
+    {
+        m_dragging = false;
+        update();
+    }
+
+private:
+    QPointer<KisDoubleSliderSpinBox> m_spin;
+    QString m_name;
+    qreal m_exponent {1.0};
+    QTimer m_poll;
+    qreal m_painted {0.0};
+    bool m_dragging {false};
+    int m_pressY {0};
+    qreal m_pressPos {0.0};
+};
+
+/// Turn the brush toolbar's horizontal groups into a narrow column with
+/// vertical size and opacity sliders (done once per toolbar).
+void adaptBrushToolBarToColumn(KisToolBar *toolBar, QMainWindow *mainWindow)
+{
+    Q_UNUSED(mainWindow);
+    if (toolBar->property("_kritanova_column").toBool()) return;
+    toolBar->setProperty("_kritanova_column", true);
+
+    const int column = qMax(36, toolBar->iconSize().width() + 12);
+
+    KisWidgetChooser *sliderChooser = nullptr;
+    QAction *insertBefore = nullptr;
+
+    // Mirror/wrap, layouts and workspaces go to the top bar, next to New/Open/Save;
+    // the spacer that pushed layouts/workspaces to the far end goes away.
+    if (KisToolBar *topBar = mainWindow->findChild<KisToolBar *>(QStringLiteral("mainToolBar"))) {
+        bool separatorAdded = false;
+        Q_FOREACH (QAction *action, toolBar->actions()) {
+            const QString name = action->objectName();
+            if (name == QLatin1String("mirror_actions") || name == QLatin1String("select_layout")
+                || name == QLatin1String("workspaces")) {
+                toolBar->removeAction(action);
+                if (!separatorAdded) {
+                    topBar->addSeparator();
+                    separatorAdded = true;
+                }
+                topBar->addAction(action);
+            } else if (name.startsWith(QLatin1String("expanding_spacer"))) {
+                action->setVisible(false);
+            }
+        }
+    }
+
+    Q_FOREACH (QAction *action, toolBar->actions()) {
+        QWidgetAction *widgetAction = qobject_cast<QWidgetAction *>(action);
+        QWidget *widget = widgetAction ? widgetAction->defaultWidget() : nullptr;
+        if (!widget) continue;
+
+        if (action->objectName() == QLatin1String("brushslider1") ||
+            action->objectName() == QLatin1String("brushslider2")) {
+            if (!sliderChooser) sliderChooser = qobject_cast<KisWidgetChooser *>(widget);
+            action->setVisible(false);
+            continue;
+        }
+
+        // horizontal button groups -> vertical
+        QList<QBoxLayout *> layouts = widget->findChildren<QBoxLayout *>();
+        if (QBoxLayout *own = qobject_cast<QBoxLayout *>(widget->layout())) layouts << own;
+        Q_FOREACH (QBoxLayout *layout, layouts) {
+            if (layout->direction() == QBoxLayout::LeftToRight) {
+                layout->setDirection(QBoxLayout::TopToBottom);
+                layout->setAlignment(Qt::AlignHCenter);
+            }
+        }
+        // the blending mode box: as wide as the column; its list keeps a readable width
+        Q_FOREACH (KisCompositeOpComboBox *combo, widget->findChildren<KisCompositeOpComboBox *>()) {
+            combo->setFixedWidth(column);
+            combo->view()->setMinimumWidth(240);
+        }
+    }
+
+    if (!sliderChooser) return;
+
+    KisDoubleSliderSpinBox *size = sliderChooser->getWidget<KisDoubleSliderSpinBox>("size");
+    KisDoubleSliderSpinBox *opacity = sliderChooser->getWidget<KisDoubleSliderSpinBox>("opacity");
+
+    QWidget *sliders = new QWidget(toolBar);
+    sliders->setObjectName(QStringLiteral("KritaNovaVerticalSliders"));
+    QVBoxLayout *layout = new QVBoxLayout(sliders);
+    layout->setContentsMargins(0, 4, 0, 4);
+    layout->setSpacing(10);
+    if (size) layout->addWidget(new NovaVerticalSlider(size, i18n("Size"), 3.0, sliders), 1, Qt::AlignHCenter);
+    if (opacity) layout->addWidget(new NovaVerticalSlider(opacity, i18n("Opacity"), 1.0, sliders), 1, Qt::AlignHCenter);
+    sliders->setMinimumHeight(340);
+    // a vertical QToolBar hands spare height to vertically expanding widgets
+    sliders->setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Expanding);
+
+    if (insertBefore) {
+        toolBar->insertWidget(insertBefore, sliders);
+    } else {
+        toolBar->addWidget(sliders);
+    }
+}
