+void SvgTextTool::commitText()
+{
+    // done with this text: deselect it; the tool stays for the next one
+    if (koSelection()) {
+        koSelection()->deselectAll();
+    }
+    repaintDecorations();
+}
+
+void SvgTextTool::removeIfEmpty(KoSvgTextShape *shape)
+{
+    // Krita Nova (patch 38): like Photoshop, a text that was created but never
+    // typed into goes away when editing it ends
+    if (!shape || !canvas() || !canvas()->shapeManager()) return;
+    if (!canvas()->shapeManager()->shapes().contains(shape)) return;
+    if (!shape->plainText().isEmpty()) return;
+    if (koSelection() && koSelection()->isSelected(shape)) return;
+    if (!shape->shapesInside().isEmpty()) return; // text in a shape: leave its frame alone
+    KUndo2Command *command = canvas()->shapeController()->removeShape(shape);
+    if (command) {
+        command->setText(kundo2_i18n("Remove Empty Text"));
+        canvas()->addCommand(command);
+    }
+}
