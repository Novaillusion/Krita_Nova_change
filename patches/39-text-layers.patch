+void SvgTextTool::updateTextLayerName(KoSvgTextShape *shape)
+{
+    if (!shape || !canvas() || !canvas()->shapeManager()) return;
+    if (!canvas()->shapeManager()->shapes().contains(shape)) return;
+    KisShapeLayer *layer = dynamic_cast<KisShapeLayer *>(shape->parent());
+    if (!layer || layer->shapes().size() != 1) return;
+    if (!layer->nodeProperties().contains(autoLayerNameProperty())) return;
+    // renamed by the user: leave it
+    const QString layerName = static_cast<KisBaseNode *>(layer)->name();
+    if (layerName != layer->nodeProperties().stringProperty(autoLayerNameProperty())) return;
+
+    QString text = shape->plainText().simplified();
+    if (text.isEmpty()) return;
+    if (text.size() > 40) text = text.left(40) + QChar(0x2026);
+    if (text == layerName) return;
+
+    layer->setNodeProperty(autoLayerNameProperty(), text);
+    KUndo2Command *command = new KisNodeRenameCommand(KisNodeSP(layer), layerName, text);
+    canvas()->addCommand(command);
+}
