+KoShapeContainer *SvgCreateTextStrategy::createTextLayer(SvgTextTool *tool, KUndo2Command *parentCommand)
+{
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(tool->canvas());
+    if (!kisCanvas || !kisCanvas->imageView() || !kisCanvas->image()) return nullptr;
+
+    KisNodeSP current = kisCanvas->imageView()->currentNode();
+    // text in a vector selection: Krita's own way
+    if (current && qobject_cast<KisSelectionMask *>(current.data())) return nullptr;
+
+    KisImageSP image = kisCanvas->image();
+    KoShapeControllerBase *controllerBase = tool->canvas()->shapeController()->documentBase();
+    if (!controllerBase) return nullptr;
+
+    const QString name = i18nc("Name of a new text layer, until its text is typed", "Text");
+    KisShapeLayerSP layer = new KisShapeLayer(controllerBase, image, name, OPACITY_OPAQUE_U8);
+    // the layer is named after its text until the user renames it (SvgTextTool)
+    layer->setNodeProperty(SvgTextTool::autoLayerNameProperty(), name);
+
+    KisNodeSP parentNode = image->rootLayer();
+    KisNodeSP above;
+    if (current) {
+        // above the current layer (a mask: above its layer), in the same group
+        KisNodeSP layerNode = current;
+        if (!layerNode->inherits("KisLayer") && layerNode->parent()) layerNode = layerNode->parent();
+        if (layerNode.data() != image->rootLayer().data() && layerNode->parent()) {
+            parentNode = layerNode->parent();
+            above = layerNode;
+        }
+    }
+
+    KisCommandUtils::CompositeCommand *layerCommand = new KisCommandUtils::CompositeCommand(parentCommand);
+    if (above) {
+        layerCommand->addCommand(new KisImageLayerAddCommand(image, layer, parentNode, above));
+    } else {
+        layerCommand->addCommand(new KisImageLayerAddCommand(image, layer, parentNode, parentNode->childCount()));
+    }
+
+    // make it the current layer once it is there, like Photoshop
+    QPointer<KisViewManager> viewManager = kisCanvas->viewManager();
+    QTimer::singleShot(0, [viewManager, layer]() {
+        if (viewManager && viewManager->nodeManager() && layer->graphListener()) {
+            viewManager->nodeManager()->slotNonUiActivatedNode(layer);
+        }
+    });
+
+    return layer.data();
+}
