+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "NovaTextPanelDock.h"
+
+#include <QColorDialog>
+#include <QMainWindow>
+#include <QQmlContext>
+#include <QQmlEngine>
+#include <QQuickItem>
+
+#include <KisQQuickWidget.h>
+#include <KisMainWindow.h>
+#include <KisViewManager.h>
+#include <KoCanvasResourcesIds.h>
+#include <KoCanvasResourceProvider.h>
+#include <KoColor.h>
+#include <KoColorSpaceRegistry.h>
+#include <klocalizedstring.h>
+#include <kis_debug.h>
+
+#include "TextPropertiesCanvasObserver.h"
+
+NovaTextPanelDock::NovaTextPanelDock(const QString &title, const QString &qmlSource, const QString &observerName)
+    : QDockWidget(title)
+    , m_observer(new TextPropertiesCanvasObserver(this))
+    , m_observerName(observerName)
+{
+    m_quickWidget = new KisQQuickWidget(this);
+    setWidget(m_quickWidget);
+    setEnabled(true);
+    m_quickWidget->setMinimumHeight(100);
+    m_quickWidget->setSource(QUrl(qmlSource));
+
+    if (!m_quickWidget->errors().empty()) {
+        qWarning() << "Errors in " << windowTitle() << ":" << m_quickWidget->errors();
+    } else {
+        m_quickWidget->rootObject()->setProperty("canvasObserver", QVariant::fromValue(m_observer));
+        m_quickWidget->rootObject()->setProperty("panel", QVariant::fromValue(static_cast<QObject *>(this)));
+    }
+    m_quickWidget->setPalette(this->palette());
+}
+
+NovaTextPanelDock::~NovaTextPanelDock()
+{
+    delete m_quickWidget;
+}
+
+QString NovaTextPanelDock::observerName()
+{
+    return m_observerName;
+}
+
+void NovaTextPanelDock::setViewManager(KisViewManager *kisview)
+{
+    m_viewManager = kisview;
+    m_observer->setViewManager(kisview);
+}
+
+void NovaTextPanelDock::setCanvas(KoCanvasBase *canvas)
+{
+    if (m_canvas) {
+        m_canvas->resourceManager()->disconnect(this);
+    }
+    m_observer->setCanvas(canvas);
+    m_canvas = dynamic_cast<KisCanvas2 *>(canvas);
+    if (m_canvas) {
+        connect(m_canvas->resourceManager(), SIGNAL(canvasResourceChanged(int,QVariant)),
+                this, SLOT(slotCanvasResourceChanged(int,QVariant)));
+    }
+    Q_EMIT textColorChanged();
+}
+
+void NovaTextPanelDock::unsetCanvas()
+{
+    if (m_canvas) {
+        m_canvas->resourceManager()->disconnect(this);
+    }
+    m_canvas = nullptr;
+    m_observer->unsetCanvas();
+}
+
+QColor NovaTextPanelDock::textColor() const
+{
+    if (!m_canvas) return Qt::black;
+    return m_canvas->resourceManager()->foregroundColor().toQColor();
+}
+
+void NovaTextPanelDock::pickTextColor()
+{
+    if (!m_canvas) return;
+    const QColor color = QColorDialog::getColor(textColor(), this, i18nc("@title:window", "Text Color"));
+    if (!color.isValid()) return;
+    // the text tool applies a new foreground color to the selected text
+    m_canvas->resourceManager()->setForegroundColor(KoColor(color, KoColorSpaceRegistry::instance()->rgb8()));
+}
+
+void NovaTextPanelDock::showMoreOptions()
+{
+    QMainWindow *mainWindow = m_viewManager ? static_cast<QMainWindow *>(m_viewManager->mainWindow()) : nullptr;
+    if (!mainWindow) return;
+    if (QDockWidget *dock = mainWindow->findChild<QDockWidget *>(QStringLiteral("TextProperties"))) {
+        dock->show();
+        dock->raise();
+    }
+}
+
+void NovaTextPanelDock::slotCanvasResourceChanged(int key, const QVariant &value)
+{
+    Q_UNUSED(value);
+    if (key == KoCanvasResource::ForegroundColor) {
+        Q_EMIT textColorChanged();
+    }
+}
