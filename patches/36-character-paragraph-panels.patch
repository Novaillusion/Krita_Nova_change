+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef NOVATEXTPANELDOCK_H
+#define NOVATEXTPANELDOCK_H
+
+#include <QColor>
+#include <QDockWidget>
+#include <QPointer>
+
+#include <kis_mainwindow_observer.h>
+#include <kis_canvas2.h>
+
+class KisQQuickWidget;
+class KisViewManager;
+class TextPropertiesCanvasObserver;
+
+/**
+ * Krita Nova (patch 36): the compact, Photoshop-style "Character" and
+ * "Paragraph" panels of the text tool. Both show the text properties of the
+ * text being edited (Character: the selected characters, or the whole text;
+ * Paragraph: the whole text) with the same models as the Text Properties
+ * docker, which stays available for everything else ("More options").
+ */
+class NovaTextPanelDock : public QDockWidget, public KisMainwindowObserver
+{
+    Q_OBJECT
+    /// the text color: the foreground color, which the text tool uses for text
+    Q_PROPERTY(QColor textColor READ textColor NOTIFY textColorChanged)
+
+public:
+    NovaTextPanelDock(const QString &title, const QString &qmlSource, const QString &observerName);
+    ~NovaTextPanelDock() override;
+
+    QString observerName() override;
+    void setViewManager(KisViewManager *kisview) override;
+    void setCanvas(KoCanvasBase *canvas) override;
+    void unsetCanvas() override;
+
+    QColor textColor() const;
+
+    /// choose the text color (sets the foreground color)
+    Q_INVOKABLE void pickTextColor();
+    /// show the Text Properties docker, with all of Krita's text options
+    Q_INVOKABLE void showMoreOptions();
+
+Q_SIGNALS:
+    void textColorChanged();
+
+private Q_SLOTS:
+    void slotCanvasResourceChanged(int key, const QVariant &value);
+
+private:
+    KisQQuickWidget *m_quickWidget {nullptr};
+    TextPropertiesCanvasObserver *m_observer {nullptr};
+    QPointer<KisCanvas2> m_canvas;
+    QPointer<KisViewManager> m_viewManager;
+    QString m_observerName;
+};
+
+#endif // NOVATEXTPANELDOCK_H
