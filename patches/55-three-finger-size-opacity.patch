new file mode 100644
index 0000000..d1ef555
--- /dev/null
+++ b/libs/ui/input/KisBrushSizeOpacityGestureAction.cpp
@@ -0,0 +1,197 @@
+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisBrushSizeOpacityGestureAction.h"
+
+#include <QTouchEvent>
+#include <QTimer>
+#include <QtMath>
+
+#include <klocalizedstring.h>
+
+#include <KoCanvasResourceProvider.h>
+#include <KoCanvasResourcesIds.h>
+#include <kis_icon_utils.h>
+
+#include "kis_input_manager.h"
+#include "kis_canvas2.h"
+#include "KisViewManager.h"
+#include "kis_floating_message.h"
+
+namespace {
+/// movement (screen pixels) before the direction is decided
+const qreal DecideDistance = 12.0;
+/// dragging this far up doubles the size (and down halves it)
+const qreal DoubleSizeDistance = 150.0;
+/// dragging this far right adds 100 % opacity
+const qreal FullOpacityDistance = 400.0;
+/**
+ * Every new size / opacity updates the brush preset, the toolbar sliders, the
+ * brush outline...: a touch screen sends far more events than that can keep
+ * up with, so the value is applied at most every UpdateInterval ms (the last
+ * one always)
+ */
+const int UpdateInterval = 30;
+}
+
+KisBrushSizeOpacityGestureAction::KisBrushSizeOpacityGestureAction()
+    : KisAbstractInputAction("Brush Size and Opacity")
+{
+    setName(i18n("Brush Size and Opacity"));
+    setDescription(i18n("Dragging up or down changes the brush size, left or right the opacity"));
+
+    QHash<QString, int> shortcuts;
+    shortcuts.insert(i18n("Change Brush Size and Opacity"), SizeAndOpacityShortcut);
+    setShortcutIndexes(shortcuts);
+
+    m_applyTimer.reset(new QTimer());
+    m_applyTimer->setSingleShot(true);
+    QObject::connect(m_applyTimer.data(), &QTimer::timeout, [this]() { applyPending(); });
+}
+
+KisBrushSizeOpacityGestureAction::~KisBrushSizeOpacityGestureAction()
+{
+}
+
+int KisBrushSizeOpacityGestureAction::priority() const
+{
+    return 5;
+}
+
+bool KisBrushSizeOpacityGestureAction::supportsHiResInputEvents(int shortcut) const
+{
+    Q_UNUSED(shortcut);
+    return true;
+}
+
+KisInputActionGroup KisBrushSizeOpacityGestureAction::inputActionGroup(int shortcut) const
+{
+    Q_UNUSED(shortcut);
+    return ModifyingActionGroup;
+}
+
+QPointF KisBrushSizeOpacityGestureAction::centerOf(const QEvent *event)
+{
+    if (event && (event->type() == QEvent::TouchBegin || event->type() == QEvent::TouchUpdate
+                  || event->type() == QEvent::TouchEnd)) {
+        const QTouchEvent *touch = static_cast<const QTouchEvent *>(event);
+        QPointF sum;
+        int count = 0;
+        Q_FOREACH (const QTouchEvent::TouchPoint &point, touch->touchPoints()) {
+            if (point.state() == Qt::TouchPointReleased) continue;
+            sum += point.pos();
+            count++;
+        }
+        if (count > 0) return sum / count;
+    }
+    return eventPosF(event);
+}
+
+void KisBrushSizeOpacityGestureAction::begin(int shortcut, QEvent *event)
+{
+    KisAbstractInputAction::begin(shortcut, event);
+
+    m_active = false;
+    m_axis = Undecided;
+    m_pendingValue = -1.0;
+    m_lastMessage.clear();
+    m_sinceApply.invalidate();
+
+    KisCanvas2 *canvas = inputManager() ? inputManager()->canvas() : nullptr;
+    if (!canvas || !canvas->resourceManager()) return;
+
+    m_start = centerOf(event);
+    m_startSize = canvas->resourceManager()->resource(KoCanvasResource::Size).toDouble();
+    m_startOpacity = canvas->resourceManager()->resource(KoCanvasResource::Opacity).toDouble();
+    m_active = true;
+}
+
+void KisBrushSizeOpacityGestureAction::inputEvent(QEvent *event)
+{
+    if (!m_active || !event) {
+        KisAbstractInputAction::inputEvent(event);
+        return;
+    }
+    if (event->type() != QEvent::TouchUpdate && event->type() != QEvent::MouseMove
+            && event->type() != QEvent::TabletMove) {
+        return;
+    }
+
+    KisCanvas2 *canvas = inputManager() ? inputManager()->canvas() : nullptr;
+    if (!canvas || !canvas->resourceManager()) return;
+
+    const QPointF delta = centerOf(event) - m_start;
+
+    if (m_axis == Undecided) {
+        if (qAbs(delta.x()) < DecideDistance && qAbs(delta.y()) < DecideDistance) return;
+        m_axis = qAbs(delta.y()) >= qAbs(delta.x()) ? Vertical : Horizontal;
+    }
+
+    if (m_axis == Vertical) {
+        // up (negative y) makes the brush bigger, on a log scale so it is
+        // as easy for 3 px as for 300 px
+        m_pendingValue = qBound(1.0, m_startSize * qPow(2.0, -delta.y() / DoubleSizeDistance), 10000.0);
+    } else {
+        m_pendingValue = qBound(0.01, m_startOpacity + delta.x() / FullOpacityDistance, 1.0);
+    }
+
+    if (!m_sinceApply.isValid() || m_sinceApply.elapsed() >= UpdateInterval) {
+        applyPending();
+    } else if (!m_applyTimer->isActive()) {
+        m_applyTimer->start(UpdateInterval - int(m_sinceApply.elapsed()));
+    }
+}
+
+void KisBrushSizeOpacityGestureAction::applyPending()
+{
+    m_applyTimer->stop();
+    if (m_pendingValue < 0.0 || m_axis == Undecided) return;
+
+    KisCanvas2 *canvas = inputManager() ? inputManager()->canvas() : nullptr;
+    if (!canvas || !canvas->resourceManager()) return;
+
+    const KoCanvasResource::CanvasResourceId id =
+        m_axis == Vertical ? KoCanvasResource::Size : KoCanvasResource::Opacity;
+    // only real changes (the sliders show whole pixels / percent)
+    const qreal current = canvas->resourceManager()->resource(id).toDouble();
+    const qreal step = m_axis == Vertical ? (m_pendingValue < 10.0 ? 0.05 : 0.5) : 0.005;
+    if (qAbs(current - m_pendingValue) >= step) {
+        canvas->resourceManager()->setResource(id, m_pendingValue);
+        showValue();
+    }
+    m_pendingValue = -1.0;
+    m_sinceApply.restart();
+}
+
+void KisBrushSizeOpacityGestureAction::showValue()
+{
+    KisCanvas2 *canvas = inputManager() ? inputManager()->canvas() : nullptr;
+    if (!canvas || !canvas->viewManager() || !canvas->resourceManager()) return;
+
+    QString text;
+    if (m_axis == Vertical) {
+        const qreal size = canvas->resourceManager()->resource(KoCanvasResource::Size).toDouble();
+        text = i18n("Brush size: %1 px", QString::number(size, 'f', size < 10 ? 1 : 0));
+    } else if (m_axis == Horizontal) {
+        const qreal opacity = canvas->resourceManager()->resource(KoCanvasResource::Opacity).toDouble();
+        text = i18n("Opacity: %1%", qRound(opacity * 100));
+    } else {
+        return;
+    }
+    if (text == m_lastMessage) return; // the same text: no new message widget
+    m_lastMessage = text;
+    canvas->viewManager()->showFloatingMessage(text, QIcon(), 1000, KisFloatingMessage::High);
+}
+
+void KisBrushSizeOpacityGestureAction::end(QEvent *event)
+{
+    applyPending(); // the last value
+    m_sinceApply.invalidate();
+    m_lastMessage.clear();
+    m_active = false;
+    m_axis = Undecided;
+    KisAbstractInputAction::end(event);
+}
