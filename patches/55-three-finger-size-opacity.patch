+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_BRUSH_SIZE_OPACITY_GESTURE_ACTION_H
+#define KIS_BRUSH_SIZE_OPACITY_GESTURE_ACTION_H
+
+#include "kis_abstract_input_action.h"
+
+#include <QPointF>
+#include <QElapsedTimer>
+#include <QScopedPointer>
+
+class QTimer;
+
+/**
+ * Krita Nova: a drag (by default with three fingers) changes the brush: up /
+ * down its size, left / right its opacity. The direction of the first
+ * movement decides which one, for the rest of the drag.
+ */
+class KisBrushSizeOpacityGestureAction : public KisAbstractInputAction
+{
+public:
+    enum Shortcut {
+        SizeAndOpacityShortcut
+    };
+
+    KisBrushSizeOpacityGestureAction();
+    ~KisBrushSizeOpacityGestureAction() override;
+
+    void begin(int shortcut, QEvent *event) override;
+    void end(QEvent *event) override;
+    void inputEvent(QEvent *event) override;
+
+    bool supportsHiResInputEvents(int shortcut) const override;
+    KisInputActionGroup inputActionGroup(int shortcut) const override;
+    int priority() const override;
+
+private:
+    enum Axis { Undecided, Vertical, Horizontal };
+
+    /// the centre of the touch points (or the event's position)
+    QPointF centerOf(const QEvent *event);
+    void showValue();
+    /// sets the pending size / opacity on the canvas (at most every UpdateInterval ms)
+    void applyPending();
+
+    QScopedPointer<QTimer> m_applyTimer;
+    QElapsedTimer m_sinceApply;
+    qreal m_pendingValue {-1.0};
+    QString m_lastMessage;
+
+    QPointF m_start;
+    qreal m_startSize {0.0};
+    qreal m_startOpacity {1.0};
+    Axis m_axis {Undecided};
+    bool m_active {false};
+};
+
+#endif // KIS_BRUSH_SIZE_OPACITY_GESTURE_ACTION_H
