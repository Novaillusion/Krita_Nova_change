+
+void KisPaintopBox::adoptPresetForEraserTool()
+{
+    KisPaintOpPresetSP preset = m_resourceProvider->currentPreset();
+    if (!preset) return;
+
+    m_eraserToolPreset = preset;
+    m_eraserToolPresetOriginalEraserMode = preset->settings()->eraserMode();
+
+    // Every preset erases while it is used by the Eraser tool
+    if (!m_resourceProvider->eraserMode()) {
+        m_resourceProvider->setEraserMode(true);
+    }
+    applyEraserSizeAndOpacityMemory(true);
+}
+
+void KisPaintopBox::releasePresetFromEraserTool()
+{
+    KisPaintOpPresetSP preset = m_eraserToolPreset;
+    if (!preset) return;
+
+    // Give the preset its own eraser-mode flag back, so it paints
+    // normally again when used by the Brush tool
+    if (preset == m_resourceProvider->currentPreset()) {
+        applyEraserSizeAndOpacityMemory(false);
+        if (m_resourceProvider->eraserMode() != m_eraserToolPresetOriginalEraserMode) {
+            m_resourceProvider->setEraserMode(m_eraserToolPresetOriginalEraserMode);
+        }
+    } else {
+        preset->settings()->setEraserMode(m_eraserToolPresetOriginalEraserMode);
+    }
+}
