+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova contributors
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef KIS_TOOL_ERASER_H_
+#define KIS_TOOL_ERASER_H_
+
+#include "kis_tool_brush.h"
+
+/**
+ * A dedicated freehand Eraser tool.
+ *
+ * It behaves exactly like the Freehand Brush tool (same smoothing,
+ * stabilizer and assistant options), but it is a tool of its own instead
+ * of a brush mode:
+ *
+ *  - it keeps its own brush preset, separate from the Brush tool's
+ *    (defaults to "a) Eraser Circle");
+ *  - every preset used with it erases, whatever its blending mode;
+ *  - switching back to another tool restores that tool's preset.
+ *
+ * The preset/eraser-mode bookkeeping lives in KisPaintopBox, which
+ * watches tool changes (see KisPaintopBox::setEraserToolActive()), so
+ * the tool itself only needs to exist and identify itself.
+ */
+class KisToolEraser : public KisToolBrush
+{
+    Q_OBJECT
+public:
+    KisToolEraser(KoCanvasBase *canvas);
+    ~KisToolEraser() override;
+
+    static const QString toolId;
+};
+
+
+class KisToolEraserFactory : public KisToolBrushFactory
+{
+public:
+    KisToolEraserFactory()
+        : KisToolBrushFactory(KisToolEraser::toolId)
+    {
+        setToolTip(i18n("Eraser Tool"));
+
+        setSection(ToolBoxSection::Shape);
+        setIconName(koIconNameCStr("draw-eraser"));
+        // No default shortcut here: "E" stays bound to "erase_action",
+        // which now toggles between this tool and the previous one.
+        setPriority(1);
+        setActivationShapeId(KRITA_TOOL_ACTIVATION_ID);
+    }
+
+    ~KisToolEraserFactory() override {}
+
+    KoToolBase *createTool(KoCanvasBase *canvas) override
+    {
+        return new KisToolEraser(canvas);
+    }
+};
+
+#endif // KIS_TOOL_ERASER_H_
