+QWidget *overlayParent(KisViewManager *view)
+{
+    return view ? static_cast<QWidget *>(view->mainWindow()) : nullptr;
+}
+
+/// angle of \p v, in degrees clockwise from straight up, in [0, 360)
+qreal clockAngle(const QPointF &v)
+{
+    qreal a = qRadiansToDegrees(qAtan2(v.x(), -v.y()));
+    if (a < 0) a += 360.0;
+    return a;
+}
+
+qreal normalized180(qreal a)
+{
+    while (a > 180.0) a -= 360.0;
+    while (a <= -180.0) a += 360.0;
+    return a;
+}
