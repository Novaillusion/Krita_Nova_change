+/*
+ *  SPDX-FileCopyrightText: 2026 Krita Nova
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "KisNovaComposerAction.h"
+
+#include <QCursor>
+#include <QTouchEvent>
+#include <QWidget>
+
+#include <klocalizedstring.h>
+
+#include "kis_input_manager.h"
+#include "kis_canvas2.h"
+#include "KisViewManager.h"
+#include "nova/KisNovaComposer.h"
+
+KisNovaComposerAction::KisNovaComposerAction()
+    : KisAbstractInputAction("Krita Nova Composer")
+{
+    setName(i18n("Krita Nova Composer"));
+    setDescription(i18n("Pie menus, cursor trackers, temporary switches and the rotation selector: "
+                        "hold and move, then release; a tap opens pie menus to be tapped"));
+
+    QHash<QString, int> shortcuts;
+    Q_FOREACH (KisNovaComposer::Feature f, KisNovaComposer::features()) {
+        shortcuts.insert(KisNovaComposer::featureName(f), int(f));
+    }
+    setShortcutIndexes(shortcuts);
+}
+
+KisNovaComposerAction::~KisNovaComposerAction()
+{
+}
+
+int KisNovaComposerAction::priority() const
+{
+    return 5;
+}
+
+bool KisNovaComposerAction::supportsHiResInputEvents(int shortcut) const
+{
+    Q_UNUSED(shortcut);
+    return true;
+}
+
+KisInputActionGroup KisNovaComposerAction::inputActionGroup(int shortcut) const
+{
+    Q_UNUSED(shortcut);
+    return ModifyingActionGroup;
+}
+
+QPoint KisNovaComposerAction::globalPosOf(const QEvent *event, bool *known)
+{
+    if (known) *known = false;
+    KisCanvas2 *canvas = inputManager() ? inputManager()->canvas() : nullptr;
+    QWidget *widget = canvas ? canvas->canvasWidget() : nullptr;
+    if (!event || !widget) return QCursor::pos();
+
+    switch (event->type()) {
+    case QEvent::TouchBegin:
+    case QEvent::TouchUpdate:
+    case QEvent::TouchEnd: {
+        const QTouchEvent *touch = static_cast<const QTouchEvent *>(event);
+        QPointF sum;
+        int count = 0;
+        Q_FOREACH (const QTouchEvent::TouchPoint &point, touch->touchPoints()) {
+            sum += point.pos();
+            count++;
+        }
+        if (count == 0) return m_lastGlobal;
+        if (known) *known = true;
+        return widget->mapToGlobal((sum / count).toPoint());
+    }
+    case QEvent::MouseMove:
+    case QEvent::MouseButtonPress:
+    case QEvent::MouseButtonRelease:
+    case QEvent::MouseButtonDblClick:
+    case QEvent::TabletMove:
+    case QEvent::TabletPress:
+    case QEvent::TabletRelease:
+        if (known) *known = true;
+        return widget->mapToGlobal(eventPosF(event).toPoint());
+    default:
+        return QCursor::pos(); // key shortcuts
+    }
+}
+
+void KisNovaComposerAction::begin(int shortcut, QEvent *event)
+{
+    KisAbstractInputAction::begin(shortcut, event);
+    m_active = false;
+
+    KisCanvas2 *canvas = inputManager() ? inputManager()->canvas() : nullptr;
+    KisViewManager *view = canvas ? canvas->viewManager() : nullptr;
+    if (!view) return;
+
+    bool known = false;
+    QPoint pos = globalPosOf(event, &known);
+    QWidget *widget = canvas->canvasWidget();
+    if (!known && widget && !widget->rect().contains(widget->mapFromGlobal(pos))) {
+        pos = KisNovaComposer::canvasCenter(view);
+    }
+    m_lastGlobal = pos;
+    KisNovaComposer::instance()->begin(KisNovaComposer::Feature(shortcut), view, pos);
+    m_active = KisNovaComposer::instance()->isActive();
+}
+
+void KisNovaComposerAction::inputEvent(QEvent *event)
+{
+    if (!m_active || !event) {
+        KisAbstractInputAction::inputEvent(event);
+        return;
+    }
+    if (event->type() != QEvent::TouchUpdate && event->type() != QEvent::MouseMove
+            && event->type() != QEvent::TabletMove) {
+        return;
+    }
+    m_lastGlobal = globalPosOf(event);
+    KisNovaComposer::instance()->move(m_lastGlobal);
+}
+
+void KisNovaComposerAction::end(QEvent *event)
+{
+    if (m_active) {
+        bool known = false;
+        const QPoint pos = globalPosOf(event, &known);
+        // the release of a touch has no points left: use the last position
+        KisNovaComposer::instance()->end(known ? pos : m_lastGlobal);
+    }
+    m_active = false;
+    KisAbstractInputAction::end(event);
+}
