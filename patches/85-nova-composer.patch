+/**
+ * Krita Nova (patch 85): the Brush Panel's Composer button (under the pop-up
+ * palette button): opens the Composer menu - the pie menus (tools, brushes,
+ * blending modes, opacity, brush tag), the rotation selector, eraser and
+ * alpha lock - in the middle of the canvas, to be tapped.
+ */
+class NovaComposerButton : public QAbstractButton
+{
+public:
+    NovaComposerButton(KisViewManager *viewManager, QWidget *parent)
+        : QAbstractButton(parent), m_viewManager(viewManager)
+    {
+        setObjectName(QStringLiteral("KritaNovaBrushPanelComposer"));
+        setToolTip(i18n("Composer: pie menus, rotation, eraser and alpha lock"));
+        setFixedSize(36, 36);
+        connect(this, &QAbstractButton::clicked, this, [this]() {
+            if (!m_viewManager || !m_viewManager->canvasBase()) return;
+            KisNovaComposer::instance()->tap(KisNovaComposer::PieLauncher, m_viewManager,
+                                             KisNovaComposer::canvasCenter(m_viewManager));
+        });
+    }
+
+private:
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        if (isDown()) {
+            p.setPen(Qt::NoPen);
+            p.setBrush(palette().color(QPalette::Highlight));
+            p.drawRoundedRect(QRectF(rect()).adjusted(1, 1, -1, -1), 6, 6);
+        }
+        const QColor ink = isDown() ? palette().color(QPalette::HighlightedText)
+                                    : palette().color(QPalette::WindowText);
+        // the icon: a ring cut into four slices around a small hole
+        const QPointF c = QRectF(rect()).center();
+        const qreal outer = 11.5, inner = 4.0, gap = 1.2;
+        QPainterPath ring;
+        ring.addEllipse(c, outer, outer);
+        QPainterPath hole;
+        hole.addEllipse(c, inner, inner);
+        ring = ring.subtracted(hole);
+        QPainterPath cuts;
+        cuts.addRect(QRectF(c.x() - gap, c.y() - outer - 1, 2 * gap, 2 * outer + 2));
+        cuts.addRect(QRectF(c.x() - outer - 1, c.y() - gap, 2 * outer + 2, 2 * gap));
+        ring = ring.subtracted(cuts);
+        p.setPen(Qt::NoPen);
+        p.setBrush(ink);
+        p.drawPath(ring);
+    }
+
+    QPointer<KisViewManager> m_viewManager;
+};
