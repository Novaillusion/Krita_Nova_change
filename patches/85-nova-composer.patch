+// ---------------------------------------------------------------------------
+// pie menu
+
+struct NovaPieItem {
+    QString label;
+    QIcon icon;
+    QString text;       ///< shown in the slice when there is no icon
+    bool current {false};
+    std::function<void()> activate;
+};
+
+/**
+ * A ring of choices around a center, drawn over the main window. While a
+ * key / button / finger is held it follows the pointer (transparent for
+ * input); after a tap it is interactive: click a slice, or outside / the
+ * middle / Esc to close.
+ */
+class NovaPieWidget : public QWidget
+{
+public:
+    NovaPieWidget(QWidget *parent, const QString &title, const QVector<NovaPieItem> &items)
+        : QWidget(parent), m_title(title), m_items(items)
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents, true);
+        setAttribute(Qt::WA_NoSystemBackground, true);
+        setFocusPolicy(Qt::StrongFocus);
+        const int n = qMax(1, m_items.size());
+        m_outer = n <= 8 ? 118.0 : (n <= 12 ? 140.0 : 160.0);
+        m_inner = 44.0;
+    }
+
+    void openAt(const QPoint &globalCenter)
+    {
+        QWidget *p = parentWidget();
+        if (!p) return;
+        setGeometry(p->rect());
+        QPointF c = mapFromGlobal(globalCenter);
+        const qreal margin = m_outer + 6;
+        c.setX(qBound(margin, c.x(), qMax(margin, width() - margin)));
+        c.setY(qBound(margin, c.y(), qMax(margin, height() - margin)));
+        m_center = c;
+        show();
+        raise();
+    }
+
+    QPoint globalCenter() const { return mapToGlobal(m_center.toPoint()); }
+
+    void pointerAt(const QPoint &globalPos)
+    {
+        const int h = indexAt(mapFromGlobal(globalPos), false);
+        if (h != m_hovered) { m_hovered = h; update(); }
+    }
+
+    void setInteractive()
+    {
+        m_interactive = true;
+        m_hovered = -1;
+        setAttribute(Qt::WA_TransparentForMouseEvents, false);
+        setMouseTracking(true);
+        setFocus(Qt::OtherFocusReason);
+        update();
+    }
+
+    /// activates the item under the pointer; false (and closes) if none
+    bool activateHovered()
+    {
+        if (m_hovered < 0 || m_hovered >= m_items.size()) { closePie(); return false; }
+        activateIndex(m_hovered);
+        return true;
+    }
+
+    void closePie()
+    {
+        hide();
+        deleteLater();
+    }
+
+protected:
+    int indexAt(const QPointF &pos, bool limitOuter) const
+    {
+        const QPointF v = pos - m_center;
+        const qreal dist = qSqrt(v.x() * v.x() + v.y() * v.y());
+        if (dist < m_inner) return -1;
+        if (limitOuter && dist > m_outer * 1.3) return -2;
+        const int n = m_items.size();
+        if (n == 0) return -1;
+        const qreal step = 360.0 / n;
+        return int((clockAngle(v) + step / 2.0) / step) % n;
+    }
+
+    void activateIndex(int i)
+    {
+        std::function<void()> fn = m_items[i].activate;
+        closePie();
+        if (fn) QTimer::singleShot(0, qApp, fn);
+    }
+
+    void mouseMoveEvent(QMouseEvent *e) override
+    {
+        if (!m_interactive) return;
+        const int h = qMax(-1, indexAt(e->pos(), true));
+        if (h != m_hovered) { m_hovered = h; update(); }
+    }
+
+    void mousePressEvent(QMouseEvent *e) override { e->accept(); }
+
+    void mouseReleaseEvent(QMouseEvent *e) override
+    {
+        if (!m_interactive) return;
+        const int i = indexAt(e->pos(), true);
+        if (i >= 0) activateIndex(i);
+        else closePie(); // the middle or outside
+    }
+
+    void keyPressEvent(QKeyEvent *e) override
+    {
+        if (e->key() == Qt::Key_Escape) { closePie(); return; }
+        QWidget::keyPressEvent(e);
+    }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const QPalette pal = palette();
+        const QPointF c = m_center;
+        const qreal R = m_outer, r = m_inner;
+        const QRectF outerRect(c.x() - R, c.y() - R, 2 * R, 2 * R);
+        const QRectF innerRect(c.x() - r, c.y() - r, 2 * r, 2 * r);
+        const int n = m_items.size();
+
+        QColor bg = pal.color(QPalette::Window);
+        bg.setAlpha(240);
+        QColor line = pal.color(QPalette::WindowText);
+        line.setAlpha(70);
+
+        QPainterPath ring;
+        ring.addEllipse(outerRect);
+        QPainterPath hole;
+        hole.addEllipse(innerRect);
+        p.fillPath(ring.subtracted(hole), bg);
+
+        const qreal step = n > 0 ? 360.0 / n : 360.0;
+        for (int i = 0; i < n; i++) {
+            const qreal a = i * step; // clockwise from the top
+            const qreal qtStart = 90.0 - a + step / 2.0;
+            QPainterPath slice;
+            slice.arcMoveTo(outerRect, qtStart);
+            slice.arcTo(outerRect, qtStart, -step);
+            slice.arcTo(innerRect, qtStart - step, step);
+            slice.closeSubpath();
+
+            if (i == m_hovered) {
+                p.fillPath(slice, pal.color(QPalette::Highlight));
+            } else if (m_items[i].current) {
+                QColor cur = pal.color(QPalette::Highlight);
+                cur.setAlpha(80);
+                p.fillPath(slice, cur);
+            }
+            if (n > 1) {
+                p.setPen(QPen(line, 1.0));
+                p.setBrush(Qt::NoBrush);
+                p.drawPath(slice);
+            }
+
+            const qreal rad = (R + r) / 2.0;
+            const QPointF at(c.x() + rad * qSin(qDegreesToRadians(a)), c.y() - rad * qCos(qDegreesToRadians(a)));
+            const QColor ink = i == m_hovered ? pal.color(QPalette::HighlightedText) : pal.color(QPalette::WindowText);
+            if (!m_items[i].icon.isNull()) {
+                const int s = 30;
+                m_items[i].icon.paint(&p, QRect(int(at.x() - s / 2), int(at.y() - s / 2), s, s));
+            } else {
+                QFont f = font();
+                f.setPointSizeF(f.pointSizeF() * 0.85);
+                f.setBold(m_items[i].current);
+                p.setFont(f);
+                p.setPen(ink);
+                const qreal w = qMax(40.0, qMin(90.0, 2 * M_PI * rad / qMax(1, n) - 6));
+                const QRectF box(at.x() - w / 2, at.y() - 16, w, 32);
+                const QString t = QFontMetrics(f).elidedText(m_items[i].text, Qt::ElideRight, int(w));
+                p.drawText(box, Qt::AlignCenter, t);
+            }
+        }
+
+        p.setPen(QPen(line, 1.0));
+        p.setBrush(Qt::NoBrush);
+        p.drawEllipse(outerRect);
+
+        // the middle: the hovered item's name, or the menu's title
+        QFont f = font();
+        f.setPointSizeF(f.pointSizeF() * 0.85);
+        p.setFont(f);
+        p.setPen(pal.color(QPalette::WindowText));
+        const QString middle = (m_hovered >= 0 && m_hovered < n) ? m_items[m_hovered].label : m_title;
+        p.drawText(innerRect.adjusted(4, 4, -4, -4), Qt::AlignCenter | Qt::TextWordWrap, middle);
+    }
+
+private:
+    QString m_title;
+    QVector<NovaPieItem> m_items;
+    QPointF m_center;
+    qreal m_outer {118.0};
+    qreal m_inner {44.0};
+    int m_hovered {-1};
+    bool m_interactive {false};
+};
+
+// ---------------------------------------------------------------------------
+// rotation dial
+
+/**
+ * The canvas rotation as a dial: the angle of the pointer around the middle
+ * is the rotation (snapping to every 15 degrees within 4); in the middle the
+ * rotation stays as it was. After a tap it is interactive: drag on it, tap
+ * the middle to reset the rotation, Esc or a tap outside to close.
+ */
+class NovaDialWidget : public QWidget
+{
+public:
+    NovaDialWidget(QWidget *parent, qreal startRotation,
+                   std::function<void(qreal)> apply, std::function<void()> reset)
+        : QWidget(parent), m_start(startRotation), m_current(startRotation),
+          m_apply(apply), m_reset(reset)
+    {
+        setAttribute(Qt::WA_TransparentForMouseEvents, true);
+        setAttribute(Qt::WA_NoSystemBackground, true);
+        setFocusPolicy(Qt::StrongFocus);
+    }
+
+    void openAt(const QPoint &globalCenter)
+    {
+        QWidget *p = parentWidget();
+        if (!p) return;
+        setGeometry(p->rect());
+        QPointF c = mapFromGlobal(globalCenter);
+        const qreal margin = R + 6;
+        c.setX(qBound(margin, c.x(), qMax(margin, width() - margin)));
+        c.setY(qBound(margin, c.y(), qMax(margin, height() - margin)));
+        m_center = c;
+        show();
+        raise();
+    }
+
+    void pointerAt(const QPoint &globalPos) { pointerAtLocal(mapFromGlobal(globalPos)); }
+
+    void setInteractive()
+    {
+        m_interactive = true;
+        setAttribute(Qt::WA_TransparentForMouseEvents, false);
+        setFocus(Qt::OtherFocusReason);
+    }
+
+    void closeDial()
+    {
+        hide();
+        deleteLater();
+    }
+
+protected:
+    void pointerAtLocal(const QPointF &pos)
+    {
+        const QPointF v = pos - m_center;
+        const qreal dist = qSqrt(v.x() * v.x() + v.y() * v.y());
+        qreal target = m_start;
+        if (dist >= r) {
+            target = clockAngle(v);
+            const qreal snapped = qRound(target / 15.0) * 15.0;
+            if (qAbs(target - snapped) <= 4.0) target = snapped;
+        }
+        if (qAbs(normalized180(target - m_current)) < 0.05) return;
+        m_current = target;
+        if (m_apply) m_apply(target);
+        update();
+    }
+
+    qreal distanceFromCenter(const QPointF &pos) const
+    {
+        const QPointF v = pos - m_center;
+        return qSqrt(v.x() * v.x() + v.y() * v.y());
+    }
+
+    void mousePressEvent(QMouseEvent *e) override
+    {
+        if (!m_interactive) return;
+        m_pressDist = distanceFromCenter(e->pos());
+        m_dragging = m_pressDist >= r && m_pressDist <= R * 1.3;
+        if (m_dragging) pointerAtLocal(e->pos());
+    }
+
+    void mouseMoveEvent(QMouseEvent *e) override
+    {
+        if (m_interactive && m_dragging) pointerAtLocal(e->pos());
+    }
+
+    void mouseReleaseEvent(QMouseEvent *e) override
+    {
+        if (!m_interactive) return;
+        if (m_dragging) { m_dragging = false; return; } // keep it open for more
+        const qreal d = distanceFromCenter(e->pos());
+        if (m_pressDist < r && d < r) {
+            if (m_reset) m_reset();
+            m_current = 0.0;
+            m_start = 0.0;
+            update();
+            QTimer::singleShot(150, this, [this]() { closeDial(); });
+            return;
+        }
+        closeDial(); // a tap outside
+    }
+
+    void keyPressEvent(QKeyEvent *e) override
+    {
+        if (e->key() == Qt::Key_Escape || e->key() == Qt::Key_Return || e->key() == Qt::Key_Enter) {
+            closeDial();
+            return;
+        }
+        QWidget::keyPressEvent(e);
+    }
+
+    void paintEvent(QPaintEvent *) override
+    {
+        QPainter p(this);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        const QPalette pal = palette();
+        const QPointF c = m_center;
+
+        QColor bg = pal.color(QPalette::Window);
+        bg.setAlpha(240);
+        QPainterPath ring;
+        ring.addEllipse(c, R, R);
+        QPainterPath hole;
+        hole.addEllipse(c, r, r);
+        p.fillPath(ring.subtracted(hole), bg);
+
+        QColor ink = pal.color(QPalette::WindowText);
+        for (int deg = 0; deg < 360; deg += 15) {
+            const bool major = deg % 90 == 0;
+            const qreal len = major ? 14.0 : 7.0;
+            const qreal s = qSin(qDegreesToRadians(qreal(deg))), co = qCos(qDegreesToRadians(qreal(deg)));
+            QColor tick = ink;
+            tick.setAlpha(major ? 200 : 110);
+            p.setPen(QPen(tick, major ? 2.0 : 1.0));
+            p.drawLine(QPointF(c.x() + (R - 3) * s, c.y() - (R - 3) * co),
+                       QPointF(c.x() + (R - 3 - len) * s, c.y() - (R - 3 - len) * co));
+        }
+
+        // the needle
+        const qreal a = qDegreesToRadians(m_current);
+        p.setPen(QPen(pal.color(QPalette::Highlight), 4.0, Qt::SolidLine, Qt::RoundCap));
+        p.drawLine(QPointF(c.x() + r * qSin(a), c.y() - r * qCos(a)),
+                   QPointF(c.x() + (R - 6) * qSin(a), c.y() - (R - 6) * qCos(a)));
+
+        p.setPen(ink);
+        QFont f = font();
+        f.setBold(true);
+        p.setFont(f);
+        qreal shown = normalized180(m_current);
+        p.drawText(QRectF(c.x() - r, c.y() - r, 2 * r, 2 * r), Qt::AlignCenter,
+                   i18nc("canvas rotation in degrees", "%1°", qRound(shown)));
+    }
+
+private:
+    const qreal R {120.0};
+    const qreal r {40.0};
+    QPointF m_center;
+    qreal m_start {0.0};
+    qreal m_current {0.0};
+    qreal m_pressDist {0.0};
+    bool m_dragging {false};
+    bool m_interactive {false};
+    std::function<void(qreal)> m_apply;
+    std::function<void()> m_reset;
+};
