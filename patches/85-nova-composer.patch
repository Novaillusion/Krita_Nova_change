+QPoint KisNovaComposer::canvasCenter(KisViewManager *view)
+{
+    KisCanvas2 *canvas = view ? view->canvasBase() : nullptr;
+    QWidget *w = canvas ? canvas->canvasWidget() : nullptr;
+    if (w) return w->mapToGlobal(w->rect().center());
+    QWidget *p = overlayParent(view);
+    return p ? p->mapToGlobal(p->rect().center()) : QCursor::pos();
+}
