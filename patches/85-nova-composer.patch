+void KisNovaComposer::createActions(KisViewManager *view)
+{
+    if (!view || !view->actionManager()) return;
+    QPointer<KisViewManager> v = view;
+    Q_FOREACH (Feature f, features()) {
+        KisAction *action = view->actionManager()->createAction(actionName(f));
+        if (!action) continue;
+        connect(action, &QAction::triggered, this, [this, f, v]() {
+            if (m_active || !v) return; // key auto-repeat
+            startKeyboardSession(f, v);
+        });
+    }
+}
+
+void KisNovaComposer::startKeyboardSession(Feature feature, KisViewManager *view)
+{
+    // the key to wait for: the last key of the action's shortcut
+    m_key = 0;
+    KisAction *action = view->actionManager() ? view->actionManager()->actionByName(actionName(feature)) : nullptr;
+    if (action && !action->shortcut().isEmpty()) {
+        const QKeySequence seq = action->shortcut();
+        m_key = int(seq[seq.count() - 1]) & ~int(Qt::KeyboardModifierMask);
+    }
+
+    QPoint pos = QCursor::pos();
+    KisCanvas2 *canvas = view->canvasBase();
+    QWidget *w = canvas ? canvas->canvasWidget() : nullptr;
+    if (!w || !w->rect().contains(w->mapFromGlobal(pos))) pos = canvasCenter(view);
+
+    begin(feature, view, pos);
+    if (!m_active) return;
+    if (m_key == 0) { // started from a menu: like a tap
+        end(pos);
+        return;
+    }
+    m_keyboard = true;
+    qApp->installEventFilter(this);
+}
+
+void KisNovaComposer::stopKeyboardSession()
+{
+    if (!m_keyboard) return;
+    m_keyboard = false;
+    m_key = 0;
+    qApp->removeEventFilter(this);
+}
+
+bool KisNovaComposer::eventFilter(QObject *watched, QEvent *event)
+{
+    if (m_keyboard && m_active) {
+        switch (event->type()) {
+        case QEvent::MouseMove:
+        case QEvent::TabletMove:
+        case QEvent::HoverMove:
+            move(QCursor::pos());
+            break;
+        case QEvent::KeyRelease: {
+            QKeyEvent *ke = static_cast<QKeyEvent *>(event);
+            if (!ke->isAutoRepeat() && ke->key() == m_key) {
+                // not eaten: the canvas input manager tracks the keys too
+                end(QCursor::pos());
+            }
+            break;
+        }
+        case QEvent::ApplicationDeactivate:
+            cancel();
+            break;
+        default:
+            break;
+        }
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void KisNovaComposer::begin(Feature feature, KisViewManager *view, const QPoint &globalPos)
+{
+    if (m_active) cancel();
+    if (m_pie) m_pie->closePie();
+    if (m_dial) m_dial->closeDial();
+    if (!view || !view->canvasBase() || !overlayParent(view)) return;
+
+    m_view = view;
+    m_feature = feature;
+    m_active = true;
+    m_start = m_last = globalPos;
+    m_travel = 0.0;
+    m_since.start();
+
+    if (isPie(feature)) {
+        beginPie(globalPos);
+    } else if (feature >= TrackSize && feature <= TrackUndo) {
+        beginTracker(globalPos);
+    } else if (feature >= TempEraser && feature <= TempColorSampler) {
+        beginTemporary();
+    } else if (feature == RotationDial) {
+        beginDial(globalPos);
+    }
+}
+
+void KisNovaComposer::move(const QPoint &globalPos)
+{
+    if (!m_active) return;
+    m_travel += (globalPos - m_last).manhattanLength();
+    m_last = globalPos;
+
+    if (isPie(m_feature)) {
+        if (m_pie) m_pie->pointerAt(globalPos);
+    } else if (m_feature >= TrackSize && m_feature <= TrackUndo) {
+        moveTracker(globalPos);
+    } else if (m_feature == RotationDial) {
+        if (m_dial) m_dial->pointerAt(globalPos);
+    }
+}
+
+void KisNovaComposer::end(const QPoint &globalPos)
+{
+    if (!m_active) return;
+    move(globalPos);
+    const bool tap = m_since.elapsed() < TapTime && m_travel < TapTravel;
+    m_active = false;
+    stopKeyboardSession();
+
+    if (isPie(m_feature)) {
+        if (!m_pie) return;
+        if (tap) m_pie->setInteractive();
+        else m_pie->activateHovered();
+    } else if (m_feature >= TrackSize && m_feature <= TrackUndo) {
+        applyTracker();
+        m_applyTimer->stop();
+        m_lastMessage.clear();
+    } else if (m_feature >= TempEraser && m_feature <= TempColorSampler) {
+        endTemporary(!tap);
+    } else if (m_feature == RotationDial) {
+        if (!m_dial) return;
+        if (tap) m_dial->setInteractive();
+        else m_dial->closeDial();
+    }
+}
+
+void KisNovaComposer::cancel()
+{
+    if (!m_active) return;
+    m_active = false;
+    stopKeyboardSession();
+    if (m_pie) m_pie->closePie();
+    if (m_dial) m_dial->closeDial();
+    m_applyTimer->stop();
+    m_pendingValue = -1.0;
+    if (m_feature >= TempEraser && m_feature <= TempColorSampler) endTemporary(true);
+}
+
+void KisNovaComposer::tap(Feature feature, KisViewManager *view, const QPoint &globalPos)
+{
+    begin(feature, view, globalPos);
+    end(globalPos);
+}
+
+// ---------------------------------------------------------------------------
+// pies
+
+void KisNovaComposer::beginPie(const QPoint &globalPos)
+{
+    KisViewManager *view = m_view;
+    KisCanvas2 *canvas = view->canvasBase();
+    KoCanvasResourceProvider *resources = canvas ? canvas->resourceManager() : nullptr;
+    if (!resources) { m_active = false; return; }
+
+    QPointer<KisViewManager> v = view;
+    QVector<NovaPieItem> items;
+    QString title;
+
+    // sub-menus open where this one was
+    auto openSub = [this, v](Feature f) {
+        return [this, v, f]() {
+            if (!v) return;
+            const QPoint at = m_lastPieCenter.isNull() ? canvasCenter(v) : m_lastPieCenter;
+            tap(f, v, at);
+        };
+    };
+
+    switch (m_feature) {
+    case PieLauncher: {
+        title = i18n("Composer");
+        auto add = [&](const QString &label, const QString &icon, std::function<void()> fn) {
+            NovaPieItem it;
+            it.label = label;
+            it.text = label;
+            it.icon = icon.isEmpty() ? QIcon() : KisIconUtils::loadIcon(icon);
+            it.activate = fn;
+            items.append(it);
+        };
+        add(i18n("Tools"), QString(), openSub(PieTools));
+        add(i18n("Brushes"), QString(), openSub(PiePresets));
+        add(i18n("Blending"), QString(), openSub(PieBlendModes));
+        add(i18n("Opacity"), QString(), openSub(PieOpacity));
+        add(i18n("Rotate"), QString(), openSub(RotationDial));
+        add(i18n("Eraser"), QStringLiteral("draw-eraser"), [v]() {
+            if (v && v->actionManager())
+                if (KisAction *a = v->actionManager()->actionByName("erase_action")) a->trigger();
+        });
+        add(i18n("Alpha Lock"), QStringLiteral("transparency-locked"), [v]() {
+            if (v && v->actionManager())
+                if (KisAction *a = v->actionManager()->actionByName("preserve_alpha")) a->trigger();
+        });
+        add(i18n("Brush Tag"), QString(), openSub(PieTags));
+        break;
+    }
+    case PieTools: {
+        title = i18n("Tools");
+        static const QStringList ids = {
+            "KritaShape/KisToolBrush", "KritaShape/KisToolLine", "KritaTransform/KisToolMove",
+            "KisToolTransform", "KisToolSelectRectangular", "KisToolSelectOutline",
+            "KisToolSelectContiguous", "KritaFill/KisToolFill", "KritaFill/KisToolGradient",
+            "KritaSelected/KisToolColorSampler", "SvgTextTool", "KisToolCrop"};
+        const QString active = view->toolManager() ? view->toolManager()->activeToolId() : QString();
+        Q_FOREACH (const QString &id, ids) {
+            KoToolFactoryBase *factory = KoToolRegistry::instance()->value(id);
+            if (!factory) continue;
+            NovaPieItem it;
+            it.label = factory->toolTip();
+            it.text = it.label;
+            it.icon = KisIconUtils::loadIcon(factory->iconName());
+            it.current = id == active;
+            it.activate = [v, id]() {
+                if (v && v->toolManager()) v->toolManager()->switchToolRequested(id);
+            };
+            items.append(it);
+        }
+        break;
+    }
+    case PieBlendModes: {
+        title = i18n("Blending Mode");
+        static const QStringList ids = {
+            COMPOSITE_OVER, COMPOSITE_MULT, COMPOSITE_SCREEN, COMPOSITE_OVERLAY,
+            COMPOSITE_SOFT_LIGHT_PHOTOSHOP, COMPOSITE_HARD_LIGHT, COMPOSITE_DODGE,
+            COMPOSITE_BURN, COMPOSITE_DARKEN, COMPOSITE_LIGHTEN, COMPOSITE_ADD, COMPOSITE_COLOR};
+        const QString current = resources->resource(KoCanvasResource::CurrentCompositeOp).toString();
+        Q_FOREACH (const QString &id, ids) {
+            NovaPieItem it;
+            it.label = KoCompositeOpRegistry::instance().getKoID(id).name();
+            it.text = it.label;
+            it.current = id == current;
+            it.activate = [v, id]() {
+                KisCanvas2 *c = v ? v->canvasBase() : nullptr;
+                if (c && c->resourceManager()) c->resourceManager()->setResource(KoCanvasResource::CurrentCompositeOp, id);
+            };
+            items.append(it);
+        }
+        break;
+    }
+    case PieOpacity: {
+        title = i18n("Opacity");
+        const qreal current = resources->resource(KoCanvasResource::Opacity).toDouble();
+        static const QList<int> values = {100, 90, 75, 60, 50, 40, 25, 10};
+        Q_FOREACH (int percent, values) {
+            NovaPieItem it;
+            it.label = i18n("Opacity %1%", percent);
+            it.text = QStringLiteral("%1%").arg(percent);
+            it.current = qAbs(current - percent / 100.0) < 0.005;
+            it.activate = [v, percent]() {
+                KisCanvas2 *c = v ? v->canvasBase() : nullptr;
+                if (c && c->resourceManager()) c->resourceManager()->setResource(KoCanvasResource::Opacity, percent / 100.0);
+            };
+            items.append(it);
+        }
+        break;
+    }
+    case PieTags: {
+        title = i18n("Brush Tag");
+        const QString saved = KConfigGroup(KSharedConfig::openConfig(), ConfigGroup).readEntry("presetTag", QString());
+        KisTagModel tags(ResourceType::PaintOpPresets);
+        for (int row = 0; row < tags.rowCount() && items.size() < 16; row++) {
+            KisTagSP tag = tags.tagForIndex(tags.index(row, 0));
+            if (!tag || tag->id() < 0) continue; // "All", "All Untagged"
+            NovaPieItem it;
+            it.label = tag->name();
+            it.text = tag->name();
+            it.current = tag->url() == saved;
+            const QString url = tag->url();
+            it.activate = [this, v, url]() {
+                KConfigGroup(KSharedConfig::openConfig(), ConfigGroup).writeEntry("presetTag", url);
+                if (v) tap(PiePresets, v, m_lastPieCenter.isNull() ? canvasCenter(v) : m_lastPieCenter);
+            };
+            items.append(it);
+        }
+        break;
+    }
+    case PiePresets: {
+        const QString saved = KConfigGroup(KSharedConfig::openConfig(), ConfigGroup).readEntry("presetTag", QString());
+        KisTagModel tags(ResourceType::PaintOpPresets);
+        KisTagSP chosen;
+        for (int row = 0; row < tags.rowCount(); row++) {
+            KisTagSP tag = tags.tagForIndex(tags.index(row, 0));
+            if (!tag || tag->id() < 0) continue;
+            if (!chosen) chosen = tag; // the first tag, if none was picked
+            if (!saved.isEmpty() && tag->url() == saved) { chosen = tag; break; }
+        }
+
+        QVector<KoResourceSP> presets;
+        if (chosen) {
+            title = chosen->name();
+            KisTagResourceModel model(ResourceType::PaintOpPresets);
+            model.setTagsFilter(QVector<KisTagSP>{chosen});
+            for (int row = 0; row < model.rowCount() && presets.size() < 15; row++) {
+                KoResourceSP r = model.resourceForIndex(model.index(row, 0));
+                if (r) presets.append(r);
+            }
+        } else {
+            title = i18n("Brushes");
+            KisResourceModel model(ResourceType::PaintOpPresets);
+            for (int row = 0; row < model.rowCount() && presets.size() < 15; row++) {
+                KoResourceSP r = model.resourceForIndex(model.index(row, 0));
+                if (r) presets.append(r);
+            }
+        }
+
+        KisPaintOpPresetSP current = resources->resource(KoCanvasResource::CurrentPaintOpPreset).value<KisPaintOpPresetSP>();
+        Q_FOREACH (KoResourceSP r, presets) {
+            NovaPieItem it;
+            it.label = r->name();
+            it.text = r->name();
+            if (!r->image().isNull()) it.icon = QIcon(QPixmap::fromImage(r->image()));
+            it.current = current && current->resourceId() == r->resourceId();
+            it.activate = [v, r]() {
+                if (v && v->paintOpBox()) v->paintOpBox()->resourceSelected(r);
+            };
+            items.append(it);
+        }
+        NovaPieItem pick;
+        pick.label = i18n("Choose another tag");
+        pick.text = i18n("Tag…");
+        pick.activate = openSub(PieTags);
+        items.append(pick);
+        break;
+    }
+    default:
+        break;
+    }
+
+    if (items.isEmpty()) { m_active = false; return; }
+    m_pie = new NovaPieWidget(overlayParent(view), title, items);
+    m_pie->openAt(globalPos);
+    m_lastPieCenter = m_pie->globalCenter();
+}
+
+// ---------------------------------------------------------------------------
+// cursor trackers
+
+void KisNovaComposer::beginTracker(const QPoint &globalPos)
+{
+    Q_UNUSED(globalPos);
+    m_steps = 0;
+    m_pendingValue = -1.0;
+    m_lastMessage.clear();
+    m_sinceApply.invalidate();
+    KisCanvas2 *canvas = m_view->canvasBase();
+    KoCanvasResourceProvider *resources = canvas ? canvas->resourceManager() : nullptr;
+    if (!resources) { m_active = false; return; }
+    switch (m_feature) {
+    case TrackSize: m_startValue = resources->resource(KoCanvasResource::Size).toDouble(); break;
+    case TrackOpacity: m_startValue = resources->resource(KoCanvasResource::Opacity).toDouble(); break;
+    case TrackFlow: m_startValue = resources->resource(KoCanvasResource::Flow).toDouble(); break;
+    default: m_startValue = 0.0; break;
+    }
+}
+
+void KisNovaComposer::moveTracker(const QPoint &globalPos)
+{
+    if (!m_view) return;
+    const QPoint d = globalPos - m_start;
+
+    switch (m_feature) {
+    case TrackSize:
+        // log scale: 150 px to the right doubles the size
+        m_pendingValue = qBound(1.0, m_startValue * qPow(2.0, d.x() / 150.0), 10000.0);
+        break;
+    case TrackOpacity:
+    case TrackFlow:
+        m_pendingValue = qBound(0.01, m_startValue + d.x() / 400.0, 1.0);
+        break;
+    case TrackLayer: {
+        KisNodeManager *nodes = m_view->nodeManager();
+        if (!nodes) return;
+        const int target = int(-d.y() / 40); // up: the layer above
+        bool changed = false;
+        while (m_steps < target) { nodes->activateNextNode(); m_steps++; changed = true; }
+        while (m_steps > target) { nodes->activatePreviousNode(); m_steps--; changed = true; }
+        if (changed && m_view->activeNode()) showMessage(i18n("Layer: %1", m_view->activeNode()->name()));
+        return;
+    }
+    case TrackUndo: {
+        KisActionManager *actions = m_view->actionManager();
+        if (!actions) return;
+        const int target = int(d.x() / 30); // left: undo, right: redo
+        KisAction *undo = actions->actionByName("edit_undo");
+        KisAction *redo = actions->actionByName("edit_redo");
+        while (m_steps > target && undo) { undo->trigger(); m_steps--; showMessage(i18n("Undo")); }
+        while (m_steps < target && redo) { redo->trigger(); m_steps++; showMessage(i18n("Redo")); }
+        return;
+    }
+    default:
+        return;
+    }
+
+    if (!m_sinceApply.isValid() || m_sinceApply.elapsed() >= UpdateInterval) {
+        applyTracker();
+    } else if (!m_applyTimer->isActive()) {
+        m_applyTimer->start(UpdateInterval - int(m_sinceApply.elapsed()));
+    }
+}
+
+void KisNovaComposer::applyTracker()
+{
+    m_applyTimer->stop();
+    if (m_pendingValue < 0.0 || !m_view) return;
+    KisCanvas2 *canvas = m_view->canvasBase();
+    KoCanvasResourceProvider *resources = canvas ? canvas->resourceManager() : nullptr;
+    if (!resources) return;
+
+    KoCanvasResource::CanvasResourceId id = KoCanvasResource::Size;
+    if (m_feature == TrackOpacity) id = KoCanvasResource::Opacity;
+    else if (m_feature == TrackFlow) id = KoCanvasResource::Flow;
+    else if (m_feature != TrackSize) return;
+
+    const qreal current = resources->resource(id).toDouble();
+    const qreal step = id == KoCanvasResource::Size ? (m_pendingValue < 10.0 ? 0.05 : 0.5) : 0.005;
+    if (qAbs(current - m_pendingValue) >= step) {
+        resources->setResource(id, m_pendingValue);
+        if (id == KoCanvasResource::Size) {
+            showMessage(i18n("Brush size: %1 px", QString::number(m_pendingValue, 'f', m_pendingValue < 10 ? 1 : 0)));
+        } else if (id == KoCanvasResource::Opacity) {
+            showMessage(i18n("Opacity: %1%", qRound(m_pendingValue * 100)));
+        } else {
+            showMessage(i18n("Flow: %1%", qRound(m_pendingValue * 100)));
+        }
+    }
+    m_pendingValue = -1.0;
+    m_sinceApply.restart();
+}
+
+void KisNovaComposer::showMessage(const QString &text)
+{
+    if (!m_view || text == m_lastMessage) return;
+    m_lastMessage = text;
+    m_view->showFloatingMessage(text, QIcon(), 1000, KisFloatingMessage::High);
+}
+
+// ---------------------------------------------------------------------------
+// temporary switches
+
+namespace {
+QString temporaryToolId(KisNovaComposer::Feature f)
+{
+    switch (f) {
+    case KisNovaComposer::TempMoveTool: return QStringLiteral("KritaTransform/KisToolMove");
+    case KisNovaComposer::TempTransformTool: return QStringLiteral("KisToolTransform");
+    case KisNovaComposer::TempColorSampler: return QStringLiteral("KritaSelected/KisToolColorSampler");
+    default: return QString();
+    }
+}
+}
+
+void KisNovaComposer::beginTemporary()
+{
+    KisViewManager *view = m_view;
+    if (m_feature == TempEraser || m_feature == TempAlphaLock) {
+        KisAction *a = view->actionManager()
+                ? view->actionManager()->actionByName(m_feature == TempEraser ? "erase_action" : "preserve_alpha")
+                : nullptr;
+        if (a) a->trigger();
+        return;
+    }
+
+    KoToolManager *tools = view->toolManager();
+    if (!tools) return;
+    const QString target = temporaryToolId(m_feature);
+    const QString active = tools->activeToolId();
+    if (active == target) {
+        // already there (tapped before): go back
+        m_previousTool.clear();
+        if (!m_toggleBack.isEmpty()) tools->switchToolRequested(m_toggleBack);
+        return;
+    }
+    m_previousTool = active;
+    tools->switchToolRequested(target);
+}
+
+void KisNovaComposer::endTemporary(bool held)
+{
+    KisViewManager *view = m_view;
+    if (!view) return;
+    if (m_feature == TempEraser || m_feature == TempAlphaLock) {
+        if (!held) return; // a tap toggles
+        KisAction *a = view->actionManager()
+                ? view->actionManager()->actionByName(m_feature == TempEraser ? "erase_action" : "preserve_alpha")
+                : nullptr;
+        if (a) a->trigger();
+        return;
+    }
+    if (m_previousTool.isEmpty()) return;
+    if (held) {
+        if (view->toolManager()) view->toolManager()->switchToolRequested(m_previousTool);
+    } else {
+        m_toggleBack = m_previousTool; // the next tap goes back there
+    }
+    m_previousTool.clear();
+}
+
+// ---------------------------------------------------------------------------
+// rotation selector
+
+void KisNovaComposer::beginDial(const QPoint &globalPos)
+{
+    KisCanvas2 *canvas = m_view->canvasBase();
+    KisCanvasController *controller = canvas ? dynamic_cast<KisCanvasController *>(canvas->canvasController()) : nullptr;
+    if (!controller) { m_active = false; return; }
+    QPointer<KisViewManager> v = m_view;
+
+    auto controllerOf = [v]() -> KisCanvasController * {
+        KisCanvas2 *c = v ? v->canvasBase() : nullptr;
+        return c ? dynamic_cast<KisCanvasController *>(c->canvasController()) : nullptr;
+    };
+    auto apply = [controllerOf](qreal target) {
+        KisCanvasController *c = controllerOf();
+        if (!c) return;
+        const qreal delta = normalized180(target - c->rotation());
+        if (qAbs(delta) > 0.01) c->rotateCanvas(delta);
+    };
+    auto reset = [controllerOf]() {
+        if (KisCanvasController *c = controllerOf()) c->resetCanvasRotation();
+    };
+
+    m_dial = new NovaDialWidget(overlayParent(m_view), controller->rotation(), apply, reset);
+    m_dial->openAt(globalPos);
+}
