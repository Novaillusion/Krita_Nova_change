+#ifndef KIS_NOVA_COMPOSER_H
+#define KIS_NOVA_COMPOSER_H
+
+#include <QObject>
+#include <QPointer>
+#include <QPoint>
+#include <QElapsedTimer>
+#include <QString>
+
+#include <kritaui_export.h>
+
+class KisViewManager;
+class QTimer;
+class NovaPieWidget;
+class NovaDialWidget;
+
+/**
+ * Krita Nova "Composer": native versions of Shortcut Composer's pie menus,
+ * cursor trackers, temporary keys and rotation selector, working on every
+ * platform (Android included).
+ *
+ * Everything goes through one session at a time:
+ *   begin(feature, view, globalPos) -> move(globalPos)... -> end(globalPos)
+ *
+ * Triggers:
+ *  - keyboard shortcuts (Settings > Configure Krita > Keyboard Shortcuts,
+ *    "Krita Nova Composer"): hold the key, move the pointer, release;
+ *  - canvas input actions (Canvas Input Settings, "Krita Nova Composer"):
+ *    a pen / mouse button, or a touch gesture;
+ *  - the Brush Panel's Composer button.
+ *
+ * A quick tap (released within TapTime ms without moving) opens a pie or
+ * dial that stays open to be clicked / tapped, toggles a temporary switch,
+ * and resets the canvas rotation for the rotation selector.
+ */
+class KRITAUI_EXPORT KisNovaComposer : public QObject
+{
+    Q_OBJECT
+public:
+    enum Feature {
+        PieLauncher = 0,
+        PieTools,
+        PieBlendModes,
+        PiePresets,
+        PieOpacity,
+        PieTags,
+        TrackSize = 10,
+        TrackOpacity,
+        TrackFlow,
+        TrackLayer,
+        TrackUndo,
+        TempEraser = 20,
+        TempAlphaLock,
+        TempMoveTool,
+        TempTransformTool,
+        TempColorSampler,
+        RotationDial = 30,
+    };
+
+    static KisNovaComposer *instance();
+    ~KisNovaComposer() override;
+
+    /// every feature, in menu order
+    static QList<Feature> features();
+    static QString featureName(Feature feature);
+    /// "nova_composer_pie_tools" ...
+    static QString actionName(Feature feature);
+    static bool isPie(Feature feature);
+
+    /// keyboard shortcuts: one KisAction per feature in \p view's action manager
