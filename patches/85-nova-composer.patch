+/// released within this time without moving: a tap
+const int TapTime = 250;
+/// ... and moved less than this (screen pixels)
+const qreal TapTravel = 12.0;
+/// trackers apply at most every UpdateInterval ms (see patch 55)
+const int UpdateInterval = 30;
