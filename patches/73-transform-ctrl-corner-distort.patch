+bool KisToolTransform::novaStartCornerDistort(KoPointerEvent *event, KisTool::AlternateAction action)
+{
+    // Ctrl (+ Alt) + click: one of the sampling actions, which the free
+    // transform otherwise uses for its 3D (camera) perspective; or a plain
+    // press with Ctrl held (input profiles that give Ctrl + click no action)
+    const bool samplingAction =
+        action == KisTool::SampleFgImage || action == KisTool::SampleBgImage ||
+        action == KisTool::SampleFgNode || action == KisTool::SampleBgNode ||
+        action == KisTool::SampleFgGroup || action == KisTool::SampleBgGroup;
+    const bool ctrlPress = action == KisTool::NONE && (event->modifiers() & Qt::ControlModifier);
+    if (!samplingAction && !ctrlPress) {
+        return false;
+    }
+    if (m_currentArgs.mode() != ToolTransformArgs::FREE_TRANSFORM ||
+        m_transaction.shouldAvoidPerspectiveTransform()) {
+        return false;
+    }
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(canvas());
+    if (!kisCanvas) return false;
+
+    // the corner handles as the free transform draws them, in image pixels
+    const QPointF imagePos = kisCanvas->coordinatesConverter()->documentToImage(event->point);
+    if (!m_freeStrategy || !m_freeStrategy->novaCornerHandleAt(imagePos)) return false;
+
+    // the same transform, now in the perspective (4 points) mode, whose
+    // corners move freely; the drag goes on there as a plain drag
+    m_currentArgs.setMode(ToolTransformArgs::PERSPECTIVE_4POINT);
+    initGuiAfterTransformMode();
+    Q_EMIT transformModeChanged();
+    currentStrategy()->hoverActionCommon(event);
+    m_novaDistorting = true;
+    return true;
+}
