+bool KisFreeTransformStrategy::novaCornerHandleAt(const QPointF &imagePos) const
+{
+    const qreal radius = KisTransformUtils::effectiveHandleGrabRadius(m_d->converter);
+    for (const QPointF &corner : {m_d->transformedHandles.topLeft, m_d->transformedHandles.topRight,
+                                  m_d->transformedHandles.bottomLeft, m_d->transformedHandles.bottomRight}) {
+        if (kisDistance(corner, imagePos) <= radius) return true;
+    }
+    return false;
+}
