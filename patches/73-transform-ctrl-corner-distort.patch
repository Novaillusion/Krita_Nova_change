+bool KisToolTransform::novaStartCornerDistort(KoPointerEvent *event, KisTool::AlternateAction action)
+{
+    // Ctrl + click: a sampling action, which the free transform otherwise
+    // uses for its 3D (camera) perspective
+    if (action != KisTool::SampleFgImage) {
+        return false;
+    }
+    if (m_currentArgs.mode() != ToolTransformArgs::FREE_TRANSFORM ||
+        m_transaction.shouldAvoidPerspectiveTransform()) {
+        return false;
+    }
+    KisCanvas2 *kisCanvas = dynamic_cast<KisCanvas2 *>(canvas());
+    if (!kisCanvas) return false;
+
+    const QRectF original = m_transaction.originalRect();
+    const QTransform t = KisTransformUtils::MatricesPack(m_currentArgs).finalTransform();
+    const QPointF pos = convertToPixelCoord(event);
+    const qreal radius = KisTransformUtils::effectiveHandleGrabRadius(kisCanvas->coordinatesConverter());
+    bool onCorner = false;
+    for (const QPointF &corner : {original.topLeft(), original.topRight(), original.bottomLeft(), original.bottomRight()}) {
+        if (kisDistance(t.map(corner), pos) <= radius) {
+            onCorner = true;
+            break;
+        }
+    }
+    if (!onCorner) return false;
+
+    // the same transform, now in the perspective (4 points) mode, whose
+    // corners move freely; the drag goes on there as a plain drag
+    m_currentArgs.setMode(ToolTransformArgs::PERSPECTIVE_4POINT);
+    initGuiAfterTransformMode();
+    Q_EMIT transformModeChanged();
+    currentStrategy()->hoverActionCommon(event);
+    m_novaDistorting = true;
+    return true;
+}
